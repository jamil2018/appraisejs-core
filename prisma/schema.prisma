generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TestSuite {
  id              String            @id @default(uuid())
  name            String
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  moduleId        String
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  testCases       TestCase[]        @relation("TestSuiteTestCases")
  tags            Tag[]
  metrics         TestSuiteMetrics?
  testRuns        TestRunTestCase[]
  targetProjectId String?
  targetProject   TargetProject?    @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model Review {
  id         String       @id @default(uuid())
  testCaseId String
  reviewerId String
  status     ReviewStatus
  comments   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  testCase   TestCase     @relation(fields: [testCaseId], references: [id])
}

model LinkedJiraTicket {
  id            String   @id @default(uuid())
  testCaseId    String
  jiraTicketId  String
  jiraTicketUrl String
  jiraStatus    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  testCase      TestCase @relation(fields: [testCaseId], references: [id])
}

model StepDefinition {
  id                  String
  version             String
  status              StepDefinitionStatus
  title               String
  description         String
  definitionJson      String
  definitionHash      String
  humanProjectionHash String?
  agentContractHash   String?
  executionHash       String?
  provenanceJson      String
  createdAt           DateTime                     @default(now())
  publishedAt         DateTime?
  deprecatedAt        DateTime?
  humanProjection     StepHumanProjection?
  executionBinding    StepExecutionBinding?
  publicationReceipt  StepPublicationReceipt?
  deprecation         StepDefinitionDeprecation?

  @@id([id, version])
  @@index([status, title])
}

model StepDefinitionDraft {
  id                   String                       @id @default(uuid())
  proposedStepId       String
  proposedVersion      String
  revision             Int                          @default(1)
  draftJson            String
  draftHash            String
  reuseJustification   String?
  reuseEvidenceJson    String?
  validationReportJson String?
  reviewedDraftHash    String?
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewReceiptJson    String?
  reviewReceiptHash    String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  artifact             StepDefinitionDraftArtifact?

  @@index([proposedStepId, proposedVersion])
}

model StepDefinitionSearchReceipt {
  id                      String   @id @default(uuid())
  indexHash               String
  candidateReferencesJson String
  qualityPlanId           String?
  correlationId           String
  searchedAt              DateTime @default(now())
  expiresAt               DateTime

  @@index([expiresAt])
  @@index([qualityPlanId, correlationId])
}

model StepDefinitionDraftArtifact {
  draftId              String              @id
  contractSource       String
  handlerSource        String
  examplesJson         String
  manifestJson         String
  sourceHash           String
  compiledSource       String?
  compiledHash         String?
  diagnosticsJson      String?
  conformanceJson      String?
  conformanceHash      String?
  reviewedArtifactHash String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  draft                StepDefinitionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model StepReviewedExtension {
  id               String
  version          String
  exportName       String
  runtime          String
  capabilitiesJson String
  contractSource   String
  source           String
  compiledSource   String
  sourceHash       String
  compiledHash     String
  conformanceJson  String
  conformanceHash  String
  artifactHash     String   @unique
  reviewedBy       String
  reviewedAt       DateTime @default(now())
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?

  @@id([id, version])
  @@index([sourceHash, compiledHash])
  @@index([revokedAt])
}

model StepHumanProjection {
  stepId         String
  stepVersion    String
  signature      String         @unique
  groupId        String
  projectionJson String
  projectionHash String
  definition     StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@index([groupId])
}

model StepExecutionBinding {
  stepId      String
  stepVersion String
  kind        StepExecutionKind
  bindingJson String
  bindingHash String
  definition  StepDefinition    @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@index([kind])
}

model StepPublicationReceipt {
  stepId               String
  stepVersion          String
  receiptJson          String
  receiptHash          String
  registryManifestHash String
  conformanceRunId     String
  reviewAuthority      String
  publishedAt          DateTime       @default(now())
  definition           StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@unique([receiptHash])
}

model StepDefinitionDeprecation {
  stepId             String
  stepVersion        String
  reason             String
  actor              String
  replacementStepId  String?
  replacementVersion String?
  deprecatedAt       DateTime       @default(now())
  definition         StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
}

/// Bounded, observational lifecycle telemetry. Payloads contain only the
/// closed-vocabulary outcome details validated by the application service.
model StepDefinitionTelemetryEvent {
  id          String   @id @default(cuid())
  surface     String
  outcome     String
  stepId      String?
  stepVersion String?
  correlationId String?
  qualityPlanId String?
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([surface, outcome, createdAt])
  @@index([stepId, stepVersion, createdAt])
}

enum StepDefinitionStatus {
  ready
  deprecated
}

enum StepExecutionKind {
  operation
  composition
  reviewed_extension
}

model TestCase {
  id                String              @id @default(uuid())
  title             String
  description       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  linkedJiraTickets LinkedJiraTicket[]
  reviews           Review[]
  steps             TestCaseStep[]
  TestSuite         TestSuite[]         @relation("TestSuiteTestCases")
  TestRunTestCase   TestRunTestCase[]
  tags              Tag[]
  metrics           TestCaseMetrics?
  flowBlocks        TestCaseFlowBlock[]
  targetProjectId   String?
  targetProject     TargetProject?      @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model TestCaseStep {
  id             String                  @id @default(uuid())
  flowNodeId     String?
  testCaseId     String
  order          Int
  gherkinStep    String
  icon           StepIcon
  label          String
  invocationJson String
  testCase       TestCase                @relation(fields: [testCaseId], references: [id])
  parameters     TestCaseStepParameter[]
}

model TestCaseFlowBlock {
  id         String                  @id @default(uuid())
  name       String
  testCaseId String
  order      Int
  testCase   TestCase                @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  nodes      TestCaseFlowBlockNode[]
}

model TestCaseFlowBlockNode {
  id          String            @id @default(uuid())
  flowNodeId  String
  flowBlockId String
  flowBlock   TestCaseFlowBlock @relation(fields: [flowBlockId], references: [id], onDelete: Cascade)
}

model TemplateTestCase {
  id              String                      @id @default(uuid())
  name            String
  description     String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  steps           TemplateTestCaseStep[]
  flowBlocks      TemplateTestCaseFlowBlock[]
  targetProjectId String?
  targetProject   TargetProject?              @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, name])
}

model TemplateTestCaseStep {
  id                 String                          @id @default(uuid())
  flowNodeId         String?
  order              Int
  gherkinStep        String
  icon               StepIcon
  label              String
  templateTestCaseId String
  invocationJson     String
  templateTestCase   TemplateTestCase                @relation(fields: [templateTestCaseId], references: [id])
  parameters         TemplateTestCaseStepParameter[]
}

model TemplateTestCaseFlowBlock {
  id                 String                          @id @default(uuid())
  name               String
  templateTestCaseId String
  order              Int
  templateTestCase   TemplateTestCase                @relation(fields: [templateTestCaseId], references: [id], onDelete: Cascade)
  nodes              TemplateTestCaseFlowBlockNode[]
}

model TemplateTestCaseFlowBlockNode {
  id          String                    @id @default(uuid())
  flowNodeId  String
  flowBlockId String
  flowBlock   TemplateTestCaseFlowBlock @relation(fields: [flowBlockId], references: [id], onDelete: Cascade)
}

model TemplateTestCaseStepParameter {
  id                   String               @id @default(uuid())
  name                 String
  defaultValue         String
  order                Int
  testCaseStepId       String
  locatorId            String?
  type                 StepParameterType
  defaultLocatorId     String?
  defaultLocator       Locator?             @relation(fields: [defaultLocatorId], references: [id])
  templateTestCaseStep TemplateTestCaseStep @relation(fields: [testCaseStepId], references: [id], onDelete: Cascade)
}

model TestCaseStepParameter {
  id             String            @id @default(uuid())
  name           String
  value          String
  order          Int
  testCaseStepId String
  locatorId      String?
  type           StepParameterType
  Locator        Locator?          @relation(fields: [locatorId], references: [id])
  testCaseStep   TestCaseStep      @relation(fields: [testCaseStepId], references: [id], onDelete: Cascade)
}

model Locator {
  id                            String                          @id @default(uuid())
  name                          String
  value                         String
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  locatorGroupId                String?
  locatorGroup                  LocatorGroup?                   @relation(fields: [locatorGroupId], references: [id], onDelete: Cascade)
  TemplateTestCaseStepParameter TemplateTestCaseStepParameter[]
  stepParameters                TestCaseStepParameter[]
  conflicts                     ConflictResolution[]
  targetProjectId               String?
  targetProject                 TargetProject?                  @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model LocatorGroup {
  id              String         @id @default(uuid())
  name            String
  route           String         @default("/")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  moduleId        String
  locators        Locator[]
  module          Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  targetProjectId String?
  targetProject   TargetProject? @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, name])
}

model Module {
  id              String         @id @default(uuid())
  name            String
  parentId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  locatorGroups   LocatorGroup[]
  parent          Module?        @relation("ModuleHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Module[]       @relation("ModuleHierarchy")
  testSuites      TestSuite[]
  targetProjectId String?
  targetProject   TargetProject? @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model TestRunTestCase {
  id              String                @id @default(uuid())
  testRunId       String
  testCaseId      String
  testSuiteId     String?
  status          TestRunTestCaseStatus @default(PENDING)
  result          TestRunTestCaseResult @default(UNTESTED)
  tracePath       String?
  testRun         TestRun               @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase        TestCase              @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testSuite       TestSuite?            @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)
  reportTestCases ReportTestCase[]
}

model TestRun {
  id                             String                          @id @default(uuid())
  name                           String
  preparationKey                 String?
  runId                          String                          @unique @default(uuid())
  startedAt                      DateTime                        @default(now())
  completedAt                    DateTime?
  status                         TestRunStatus                   @default(QUEUED)
  result                         TestRunResult                   @default(PENDING)
  evidenceHealth                 TestRunEvidenceHealth           @default(invalid_missing_report)
  testCases                      TestRunTestCase[]
  updatedAt                      DateTime                        @updatedAt
  environment                    Environment                     @relation(fields: [environmentId], references: [id])
  environmentId                  String
  tags                           Tag[]
  testWorkersCount               Int?                            @default(1)
  browserEngine                  BrowserEngine                   @default(CHROMIUM)
  logs                           TestRunLog?
  logPath                        String?
  reportPath                     String?
  reports                        Report[]
  targetProjectId                String?
  targetProject                  TargetProject?                  @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  runtimeCapsule                 RuntimeCapsule?
  runtimeCapsuleExecutionAttempt RuntimeCapsuleExecutionAttempt?
  assessmentRunBinding           AssessmentRunBinding?

  @@unique([targetProjectId, preparationKey])
  @@index([completedAt])
  @@index([result])
  @@index([evidenceHealth])
  @@index([targetProjectId])
  @@index([targetProjectId, startedAt, id])
}

model TargetProject {
  id                             String                          @id @default(uuid())
  canonicalPath                  String                          @unique
  displayName                    String
  description                    String?
  packageName                    String?
  packageManager                 String?
  packageJson                    String?
  fingerprint                    String                          @unique
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  lastDetectedAt                 DateTime                        @default(now())
  testRuns                       TestRun[]
  runtimeCapsules                RuntimeCapsule[]
  runtimeCapsuleBlobs            RuntimeCapsuleBlob[]
  runtimeCapsuleLeases           RuntimeCapsuleLease[]
  resourceOwnerships             ProjectResourceOwnership[]
  resourceImports                ProjectResourceImport[]         @relation("ResourceImportDestination")
  testSuites                     TestSuite[]
  testCases                      TestCase[]
  templateTestCases              TemplateTestCase[]
  locators                       Locator[]
  locatorGroups                  LocatorGroup[]
  modules                        Module[]
  environments                   Environment[]
  tags                           Tag[]
  reports                        Report[]
  testCaseMetrics                TestCaseMetrics[]
  testSuiteMetrics               TestSuiteMetrics[]
  dashboardMetrics               DashboardMetrics?
  agentPreflightReceipts         AgentPreflightReceipt[]
  qualityPlans                   QualityPlan[]
  qualityValidationPublications  QualityValidationPublication[]
  assessments                    Assessment[]
  assessmentRuns                 AssessmentRun[]
  evidenceReceipts               EvidenceReceipt[]
  assessmentPreparations         AssessmentPreparation[]
  credentialExecutionRequests   AssessmentExecutionRequest[]

  @@index([displayName])
  @@index([fingerprint])
}

/// Durable, target-scoped receipt for the resumable prepare-and-run operation.
/// Phase receipts are append-safe JSON snapshots; immutable identities live in
/// the input hash and are re-read before each domain phase.
model AssessmentPreparation {
  id                    String   @id @default(uuid())
  targetProjectId       String
  idempotencyKey        String
  inputHash             String
  qualityPlanId         String
  qualityPlanRevisionId String
  expectedDesignHash    String
  phase                 String   @default("VALIDATING")
  receiptJson           String   @default("{}")
  failureJson           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  targetProject         TargetProject @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, idempotencyKey])
  @@index([targetProjectId, phase])
}

model AgentPreflightReceipt {
  id                    String         @id @default(cuid())
  coordinatorId         String
  schemaVersion         String
  status                String
  ready                 Boolean
  snapshotHash          String
  snapshotJson          String
  expectedCanonicalPath String?
  targetProjectId       String?
  mcpSurfaceVersion     String
  mcpServerStartedAt    DateTime
  observedAt            DateTime       @default(now())
  createdAt             DateTime       @default(now())
  targetProject         TargetProject? @relation(fields: [targetProjectId], references: [id], onDelete: Cascade)

  @@unique([coordinatorId, snapshotHash])
  @@index([targetProjectId, observedAt])
  @@index([observedAt])
}

model LifecycleCertificationReceipt {
  id            String   @id @default(cuid())
  schemaVersion String
  status        String
  matrixHash    String
  matrixJson    String
  durationMs    Int
  gitCommit     String?
  recordedAt    DateTime @default(now())

  @@index([recordedAt])
  @@index([status, recordedAt])
}

model ProjectResourceOwnership {
  id              String                  @id @default(uuid())
  entityType      String
  entityId        String
  scope           ResourceScope
  targetProjectId String?
  origin          String
  provenanceJson  String                  @default("{}")
  contentHash     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  targetProject   TargetProject?          @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  imports         ProjectResourceImport[]

  @@unique([entityType, entityId])
  @@index([targetProjectId, entityType])
  @@index([scope, entityType])
}

model ProjectResourceImport {
  id                   String                   @id @default(uuid())
  sourceOwnershipId    String
  destinationProjectId String
  sharingMode          ResourceSharingMode
  sourceContentHash    String
  actor                String
  propagationPolicy    String
  createdAt            DateTime                 @default(now())
  sourceOwnership      ProjectResourceOwnership @relation(fields: [sourceOwnershipId], references: [id], onDelete: Restrict)
  destinationProject   TargetProject            @relation("ResourceImportDestination", fields: [destinationProjectId], references: [id], onDelete: Restrict)

  @@unique([sourceOwnershipId, destinationProjectId, sharingMode])
  @@index([destinationProjectId, createdAt])
}

enum ResourceScope {
  system
  global_library
  project
  publication
  runtime
  quarantined
}

enum ResourceSharingMode {
  immutable_reference
  copy
}

model RuntimeCapsule {
  id               String                          @id @default(uuid())
  targetProjectId  String
  testRunId        String                          @unique
  validationHash   String
  qualityPublicationId String?
  capsuleHash      String
  manifestHash     String
  manifestJson     String
  storagePath      String
  integrityState   RuntimeCapsuleIntegrityState    @default(staging)
  version          Int                             @default(1)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  targetProject    TargetProject                   @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  testRun          TestRun                         @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  blobReferences   RuntimeCapsuleBlobReference[]
  executionAttempt RuntimeCapsuleExecutionAttempt?
  qualityPublication QualityValidationPublication? @relation(fields: [qualityPublicationId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, validationHash, testRunId])
  @@unique([targetProjectId, storagePath])
  @@index([targetProjectId, validationHash])
  @@index([integrityState])
  @@index([qualityPublicationId])
}

model RuntimeCapsuleExecutionAttempt {
  id                  String                              @id @default(uuid())
  testRunId           String                              @unique
  capsuleId           String                              @unique
  receiptHash         String
  preflightResultJson String
  preflightResultHash String
  preflightCheckedAt  DateTime
  state               RuntimeCapsuleExecutionAttemptState @default(PREPARED)
  ownerToken          String
  version             Int                                 @default(1)
  startedAt           DateTime?
  completedAt         DateTime?
  failure             String?
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  testRun             TestRun                             @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  capsule             RuntimeCapsule                      @relation(fields: [capsuleId], references: [id], onDelete: Restrict)

  @@index([state, updatedAt])
}

enum RuntimeCapsuleExecutionAttemptState {
  PREPARED
  STARTING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

model RuntimeCapsuleBlob {
  id              String                        @id @default(uuid())
  targetProjectId String
  contentHash     String
  size            Int
  storagePath     String
  integrityState  RuntimeCapsuleIntegrityState  @default(staging)
  version         Int                           @default(1)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  references      RuntimeCapsuleBlobReference[]
  targetProject   TargetProject                 @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, contentHash])
  @@unique([targetProjectId, storagePath])
  @@index([targetProjectId])
  @@index([integrityState])
}

model RuntimeCapsuleBlobReference {
  id        String             @id @default(uuid())
  capsuleId String
  blobId    String
  filePath  String
  capsule   RuntimeCapsule     @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  blob      RuntimeCapsuleBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@unique([capsuleId, filePath])
  @@unique([capsuleId, blobId, filePath])
  @@index([blobId])
}

enum RuntimeCapsuleIntegrityState {
  staging
  ready
  missing
  corrupt
}

model RuntimeCapsuleLease {
  id              String        @id @default(uuid())
  targetProjectId String
  validationHash  String
  runId           String
  ownerToken      String
  leaseExpiresAt  DateTime
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  targetProject   TargetProject @relation(fields: [targetProjectId], references: [id], onDelete: Cascade)

  @@unique([targetProjectId, validationHash, runId])
  @@index([leaseExpiresAt])
}

model TestRunLog {
  id        String   @id @default(uuid())
  testRunId String   @unique
  logs      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  testRun   TestRun  @relation(fields: [testRunId], references: [runId], onDelete: Cascade)
}

enum EnvironmentCredentialState {
  NONE
  REFERENCE_CONFIGURED
  LEGACY_DISABLED
}

enum CredentialExecutionAuthorizationIssuer {
  LOCAL_UI_SESSION
  HOST_ASSERTION
}

model Environment {
  id                          String                     @id @default(uuid())
  name                        String
  baseUrl                     String
  expectedPageTitle           String?
  apiBaseUrl                  String?
  username                    String?
  passwordEnvironmentVariable String?
  credentialState             EnvironmentCredentialState @default(NONE)
  legacyCredentialDetectedAt  DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  testRuns                    TestRun[]
  targetProjectId             String?
  targetProject               TargetProject?             @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  credentialExecutionRequests AssessmentExecutionRequest[]

  @@unique([targetProjectId, name])
}

model Tag {
  id              String         @id @default(uuid())
  name            String
  tagExpression   String
  type            TagType        @default(FILTER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  testRuns        TestRun[]
  testSuites      TestSuite[]
  testCases       TestCase[]
  targetProjectId String?
  targetProject   TargetProject? @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, name, type])
}

model ConflictResolution {
  id                  String       @id @default(uuid())
  entityType          EntityType
  entityId            String
  conflictType        ConflictType
  conflictingEntityId String?
  resolved            Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  locator             Locator?     @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

model ReportTestCase {
  id                String          @id @default(uuid())
  reportId          String
  testCaseId        String
  testRunTestCaseId String
  reportScenarioId  String?
  testRunTestCase   TestRunTestCase @relation(fields: [testRunTestCaseId], references: [id], onDelete: Cascade)
  report            Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportScenario    ReportScenario? @relation(fields: [reportScenarioId], references: [id], onDelete: SetNull)
  duration          String
}

model Report {
  id              String           @id @default(uuid())
  name            String
  description     String?
  reportPath      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  testRunId       String
  testRun         TestRun          @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCases       ReportTestCase[]
  features        ReportFeature[]
  targetProjectId String?
  targetProject   TargetProject?   @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model ReportFeature {
  id          String             @id @default(uuid())
  reportId    String
  name        String
  description String?
  uri         String
  line        Int
  keyword     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  report      Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tags        ReportFeatureTag[]
  scenarios   ReportScenario[]
}

model ReportFeatureTag {
  id              String        @id @default(uuid())
  reportFeatureId String
  tagName         String
  line            Int
  createdAt       DateTime      @default(now())
  reportFeature   ReportFeature @relation(fields: [reportFeatureId], references: [id], onDelete: Cascade)
}

model ReportScenario {
  id              String              @id @default(uuid())
  reportFeatureId String
  name            String
  description     String?
  line            Int
  keyword         String
  type            String
  cucumberId      String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reportFeature   ReportFeature       @relation(fields: [reportFeatureId], references: [id], onDelete: Cascade)
  tags            ReportScenarioTag[]
  steps           ReportStep[]
  hooks           ReportHook[]
  reportTestCases ReportTestCase[]
}

model ReportScenarioTag {
  id               String         @id @default(uuid())
  reportScenarioId String
  tagName          String
  line             Int
  createdAt        DateTime       @default(now())
  reportScenario   ReportScenario @relation(fields: [reportScenarioId], references: [id], onDelete: Cascade)
}

model ReportStep {
  id               String         @id @default(uuid())
  reportScenarioId String
  keyword          StepKeyword
  line             Int?
  name             String
  matchLocation    String?
  status           StepStatus
  duration         String
  errorMessage     String?
  errorTrace       String?
  screenshotPath   String?
  hidden           Boolean        @default(false)
  order            Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reportScenario   ReportScenario @relation(fields: [reportScenarioId], references: [id], onDelete: Cascade)
}

model ReportHook {
  id               String         @id @default(uuid())
  reportScenarioId String
  keyword          StepKeyword
  status           StepStatus
  duration         String
  errorMessage     String?
  errorTrace       String?
  hidden           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reportScenario   ReportScenario @relation(fields: [reportScenarioId], references: [id], onDelete: Cascade)
}

model TestCaseMetrics {
  id                  String         @id @default(uuid())
  testCaseId          String         @unique
  isRepeatedlyFailing Boolean        @default(false)
  isFlaky             Boolean        @default(false)
  consecutiveFailures Int            @default(0)
  failureRate         Float          @default(0)
  totalRecentRuns     Int            @default(0)
  failedRecentRuns    Int            @default(0)
  lastExecutedAt      DateTime?
  lastFailedAt        DateTime?
  lastPassedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  testCase            TestCase       @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  targetProjectId     String?
  targetProject       TargetProject? @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([isRepeatedlyFailing])
  @@index([isFlaky])
}

model TestSuiteMetrics {
  id              String         @id @default(uuid())
  testSuiteId     String         @unique
  lastExecutedAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  testSuite       TestSuite      @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  targetProjectId String?
  targetProject   TargetProject? @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([lastExecutedAt])
}

model DashboardMetrics {
  id                             String         @id @default(uuid())
  failedRecentRunsCount          Int            @default(0)
  repeatedlyFailingTestsCount    Int            @default(0)
  flakyTestsCount                Int            @default(0)
  suitesNotExecutedRecentlyCount Int            @default(0)
  lastUpdatedAt                  DateTime       @default(now())
  createdAt                      DateTime       @default(now())
  targetProjectId                String?        @unique
  targetProject                  TargetProject? @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
}

model QualityPlan {
  id              String                @id @default(uuid())
  targetProjectId String
  title           String
  description     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  targetProject   TargetProject         @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  revisions       QualityPlanRevision[]
  assessments     Assessment[]

  @@unique([id, targetProjectId])
  @@index([targetProjectId])
}

model QualityPlanRevision {
  id                    String                      @id @default(uuid())
  targetProjectId       String
  qualityPlanId         String
  revision              Int
  status                QualityPlanRevisionStatus   @default(DRAFT)
  approvedAt            DateTime?
  contentHash           String
  sourceSpecification   String
  requirementGraphJson  String
  queries               RequirementQuery[]
  requirementSnapshots  RequirementSnapshot[]
  obligations           QualityObligationRevision[]
  validationVersions    ValidationVersion[]
  validationPublications QualityValidationPublication[]
  assessments           Assessment[]
  assessmentRuns        AssessmentRun[]
  driftReports          RequirementDriftReport[]    @relation("RevisionDriftReports")
  successorDriftReports RequirementDriftReport[]    @relation("SuccessorRevisionDriftReports")
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  qualityPlan           QualityPlan                 @relation(fields: [qualityPlanId, targetProjectId], references: [id, targetProjectId], onDelete: Cascade)

  @@unique([id, targetProjectId])
  @@unique([id, qualityPlanId])
  @@unique([id, qualityPlanId, targetProjectId])
  @@unique([qualityPlanId, revision])
  @@unique([qualityPlanId, contentHash])
  @@index([targetProjectId])
  @@index([status])
}

model RequirementSnapshot {
  id                    String                      @id @default(uuid())
  qualityPlanRevisionId String
  externalRef           String?
  text                  String
  kind                  RequirementSnapshotKind
  contentHash           String
  createdAt             DateTime                    @default(now())
  qualityPlanRevision   QualityPlanRevision         @relation(fields: [qualityPlanRevisionId], references: [id], onDelete: Cascade)
  obligations           QualityObligationRevision[]

  @@unique([id, qualityPlanRevisionId])
  @@unique([qualityPlanRevisionId, contentHash])
}

model RequirementQuery {
  id                    String                 @id @default(uuid())
  qualityPlanRevisionId String
  prompt                String
  status                RequirementQueryStatus
  answer                String?
  rationale             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  qualityPlanRevision   QualityPlanRevision    @relation(fields: [qualityPlanRevisionId], references: [id], onDelete: Cascade)

  @@index([qualityPlanRevisionId, status])
}

model QualityObligationRevision {
  id                    String                        @id @default(uuid())
  qualityPlanRevisionId String
  requirementSnapshotId String
  title                 String
  intent                String
  assertionScopeJson    String
  minimumAssurance      AssuranceLevel
  limitations           String?
  contentHash           String
  createdAt             DateTime                      @default(now())
  qualityPlanRevision   QualityPlanRevision           @relation(fields: [qualityPlanRevisionId], references: [id], onDelete: Cascade)
  requirementSnapshot   RequirementSnapshot           @relation(fields: [requirementSnapshotId, qualityPlanRevisionId], references: [id, qualityPlanRevisionId], onDelete: Cascade)
  validationLinks       ObligationValidationVersion[]

  @@unique([id, qualityPlanRevisionId])
  @@unique([qualityPlanRevisionId, contentHash])
  @@index([requirementSnapshotId])
}

model ValidationVersion {
  id                    String                        @id @default(uuid())
  targetProjectId       String
  qualityPlanRevisionId String
  validationIdentity    String
  version               Int
  status                ValidationVersionStatus       @default(DESIGNED)
  reuseOutcome          ValidationReuseOutcome?
  canonicalAstJson      String
  canonicalHash         String
  realizationJson       String?
  realizationHash       String?
  compilationHash       String?
  scenarioApprovedAt    DateTime?
  scenarioApprovedBy    String?
  scenarioApprovalHash  String?
  publishedAt           DateTime?
  createdAt             DateTime                      @default(now())
  qualityPlanRevision   QualityPlanRevision           @relation(fields: [qualityPlanRevisionId, targetProjectId], references: [id, targetProjectId], onDelete: Cascade)
  obligationLinks       ObligationValidationVersion[]
  evidenceReceipts      EvidenceReceipt[]
  publication           QualityValidationPublication?
  assessmentRunBindings AssessmentRunBinding[]

  @@unique([id, targetProjectId])
  @@unique([id, qualityPlanRevisionId])
  @@unique([validationIdentity, version])
  @@unique([qualityPlanRevisionId, canonicalHash])
  @@index([targetProjectId])
  @@index([qualityPlanRevisionId, status])
}

/// Immutable executable publication for one published Quality ValidationVersion.
/// It retains the proven capsule inputs without retaining a development-plan
/// identity or projection relation.
model QualityValidationPublication {
  id                    String                    @id @default(uuid())
  targetProjectId       String
  targetFingerprint     String
  qualityPlanRevisionId String
  validationVersionId   String                    @unique
  idempotencyKey        String
  operationHash         String                    @unique
  phase                 String                    @default("review_ready")
  expectedRevisionHash  String
  validationHash        String
  validationContent     String
  reviewHash            String
  reviewContent         String
  astId                 String
  astHash               String
  contextHash           String
  previewHash           String
  receiptHash           String
  projectionHash        String
  projectionJson        String
  validationProjectionJson String
  runtimeInputHash      String
  runtimeInputJson      String
  failure               String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  targetProject         TargetProject             @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  qualityPlanRevision   QualityPlanRevision       @relation(fields: [qualityPlanRevisionId, targetProjectId], references: [id, targetProjectId], onDelete: Cascade)
  validationVersion     ValidationVersion         @relation(fields: [validationVersionId, qualityPlanRevisionId], references: [id, qualityPlanRevisionId], onDelete: Cascade)
  extensionReviews      QualityValidationExtensionReview[]
  runtimeCapsules       RuntimeCapsule[]

  @@unique([qualityPlanRevisionId, idempotencyKey])
  @@unique([validationVersionId, qualityPlanRevisionId])
  @@index([targetProjectId, phase])
  @@index([qualityPlanRevisionId, validationVersionId])
}

model QualityValidationExtensionReview {
  id            String                       @id @default(uuid())
  publicationId String
  extensionId   String
  version       String
  sourceHash    String
  compiledHash  String
  artifactHash  String
  artifactJson  String
  createdAt     DateTime                     @default(now())
  publication   QualityValidationPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, extensionId, version])
}

model ObligationValidationVersion {
  id                          String                    @id @default(uuid())
  qualityPlanRevisionId       String
  qualityObligationRevisionId String
  validationVersionId         String
  coverageIntentJson          String
  createdAt                   DateTime                  @default(now())
  obligation                  QualityObligationRevision @relation(fields: [qualityObligationRevisionId, qualityPlanRevisionId], references: [id, qualityPlanRevisionId], onDelete: Cascade)
  validationVersion           ValidationVersion         @relation(fields: [validationVersionId, qualityPlanRevisionId], references: [id, qualityPlanRevisionId], onDelete: Cascade)

  @@unique([qualityObligationRevisionId, validationVersionId])
  @@index([qualityPlanRevisionId])
}

model EvaluationSubjectRevision {
  id               String                @id @default(uuid())
  subjectDigest    String                @unique
  subjectKind      EvaluationSubjectKind
  authority        String
  metadataJson     String?
  createdAt        DateTime              @default(now())
  assessments      Assessment[]
  evidenceReceipts EvidenceReceipt[]
  assessmentRuns   AssessmentRun[]
}

model Assessment {
  id                          String                     @id @default(uuid())
  targetProjectId             String
  qualityPlanId               String
  qualityPlanRevisionId       String
  evaluationSubjectRevisionId String
  status                      AssessmentStatus           @default(CREATED)
  alignment                   RequirementAlignmentStatus @default(CURRENT)
  observedAssurance           AssuranceLevel?
  baselineAssessmentId        String?
  /// Immutable retry/supersession lineage. Existing assessments are roots
  /// (lineageId = id, generation = 0); successors never modify their predecessor.
  lineageId                   String
  generation                  Int                        @default(0)
  supersedesAssessmentId      String?                    @unique
  supersessionDispositionJson String?
  successorIdempotencyKey     String?
  successorRequestHash        String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  targetProject               TargetProject              @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  qualityPlan                 QualityPlan                @relation(fields: [qualityPlanId, targetProjectId], references: [id, targetProjectId], onDelete: Cascade)
  qualityPlanRevision         QualityPlanRevision        @relation(fields: [qualityPlanRevisionId, qualityPlanId, targetProjectId], references: [id, qualityPlanId, targetProjectId], onDelete: Restrict)
  evaluationSubjectRevision   EvaluationSubjectRevision  @relation(fields: [evaluationSubjectRevisionId], references: [id], onDelete: Restrict)
  baselineAssessment          Assessment?                @relation("AssessmentBaseline", fields: [baselineAssessmentId, targetProjectId, qualityPlanId, qualityPlanRevisionId], references: [id, targetProjectId, qualityPlanId, qualityPlanRevisionId], onDelete: Restrict)
  baselineReferences          Assessment[]               @relation("AssessmentBaseline")
  supersedesAssessment        Assessment?                @relation("AssessmentSuccessor", fields: [supersedesAssessmentId], references: [id], onDelete: Restrict)
  successorAssessment         Assessment?                @relation("AssessmentSuccessor")
  evidenceReceipts            EvidenceReceipt[]
  runs                        AssessmentRun[]
  decisions                   AssessmentDecision[]
  credentialExecutionRequests AssessmentExecutionRequest[]

  @@unique([id, targetProjectId])
  @@unique([id, targetProjectId, qualityPlanRevisionId])
  @@unique([id, targetProjectId, qualityPlanId, qualityPlanRevisionId])
  @@index([targetProjectId, status])
  @@index([qualityPlanId, status])
  @@index([qualityPlanRevisionId, alignment])
  @@unique([lineageId, generation])
  @@unique([targetProjectId, successorIdempotencyKey])
}

/// Idempotent execution intent for either a reviewable Assessment or a
/// standalone evidence-only subject. The request hash freezes the selected
/// validation versions, subject digest, and runtime inputs before any TestRun
/// is created.
model AssessmentRun {
  id                          String                     @id @default(uuid())
  targetProjectId             String
  assessmentId                String?
  qualityPlanRevisionId       String
  evaluationSubjectRevisionId String
  idempotencyScope            String
  idempotencyKey              String
  requestHash                 String
  status                      AssessmentRunStatus        @default(PREPARED)
  stopReason                  String?
  version                     Int                        @default(1)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  executionRequestId          String?                    @unique
  executionRequestHash        String?
  executionAuthorizationGrantId String?                  @unique
  targetProject               TargetProject              @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  assessment                  Assessment?                @relation(fields: [assessmentId, targetProjectId, qualityPlanRevisionId], references: [id, targetProjectId, qualityPlanRevisionId], onDelete: Restrict)
  qualityPlanRevision         QualityPlanRevision        @relation(fields: [qualityPlanRevisionId, targetProjectId], references: [id, targetProjectId], onDelete: Restrict)
  evaluationSubjectRevision   EvaluationSubjectRevision  @relation(fields: [evaluationSubjectRevisionId], references: [id], onDelete: Restrict)
  bindings                    AssessmentRunBinding[]
  executionRequest            AssessmentExecutionRequest? @relation(fields: [executionRequestId], references: [id], onDelete: Restrict)
  executionAuthorizationGrant AssessmentExecutionAuthorizationGrant? @relation(fields: [executionAuthorizationGrantId], references: [id], onDelete: Restrict)

  @@unique([id, targetProjectId])
  @@unique([id, targetProjectId, qualityPlanRevisionId])
  @@unique([idempotencyScope, idempotencyKey])
  @@index([assessmentId, status])
  @@index([targetProjectId, status])
}

/// Immutable credential-bearing execution scope. It stores references and
/// hashes only; resolved values and value hashes are never persisted here.
model AssessmentExecutionRequest {
  id                          String   @id @default(uuid())
  targetProjectId             String
  assessmentId                String
  qualityPlanId               String
  qualityPlanRevisionId       String
  evaluationSubjectRevisionId String
  subjectDigest               String
  environmentId               String
  publicationFingerprint      String
  runtimeInputHash            String
  bindingsHash                String
  /// Unique while this request is live. Retired requests clear it so a fresh
  /// authorization request can be issued for the same immutable scope.
  activeScopeKey              String?  @unique
  requestHash                 String   @unique
  canonicalRequestJson        String
  expiresAt                   DateTime
  revokedAt                   DateTime?
  createdAt                   DateTime @default(now())
  targetProject               TargetProject @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  assessment                  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  environment                 Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  bindings                    AssessmentExecutionCredentialBinding[]
  grants                      AssessmentExecutionAuthorizationGrant[]
  run                         AssessmentRun?

  @@index([targetProjectId, assessmentId, expiresAt])
  @@index([qualityPlanId, qualityPlanRevisionId])
}

model AssessmentExecutionCredentialBinding {
  requestId String
  slot      String
  reference String
  request   AssessmentExecutionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, slot])
}

model CredentialAuthorizationUiSession {
  id               String   @id @default(uuid())
  sessionTokenHash String   @unique
  csrfTokenHash    String
  targetProjectId  String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  grants           AssessmentExecutionAuthorizationGrant[]

  @@index([targetProjectId, expiresAt, revokedAt])
}

model AssessmentExecutionAuthorizationGrant {
  id                   String                              @id @default(uuid())
  requestId            String                              @unique
  issuerKind           CredentialExecutionAuthorizationIssuer
  localUiSessionId     String?
  hostIssuer           String?
  hostKeyId            String?
  hostAssertionJti     String?
  hostAssertionHash    String?
  notBefore            DateTime
  expiresAt            DateTime
  consumedAt           DateTime?
  revokedAt            DateTime?
  revokedReason        String?
  createdAt            DateTime                            @default(now())
  request              AssessmentExecutionRequest         @relation(fields: [requestId], references: [id], onDelete: Restrict)
  localUiSession       CredentialAuthorizationUiSession?   @relation(fields: [localUiSessionId], references: [id], onDelete: Restrict)
  run                  AssessmentRun?

  @@unique([hostIssuer, hostAssertionJti])
  @@index([requestId, expiresAt, consumedAt, revokedAt])
}

/// One immutable validation/matrix-cell execution binding per AssessmentRun.
/// A terminal EvidenceReceipt can only be attached once, preserving the first
/// observed terminal TestRun outcome during stop/reconcile races.
model AssessmentRunBinding {
  id                    String           @id @default(uuid())
  assessmentRunId       String
  validationVersionId   String
  resultMatrixCell      String
  testRunId             String           @unique
  runtimeInputHash      String
  terminalOutcome       EvidenceOutcome?
  terminalizedAt        DateTime?
  evidenceReceiptId     String?
  version               Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  assessmentRun         AssessmentRun    @relation(fields: [assessmentRunId], references: [id], onDelete: Cascade)
  validationVersion     ValidationVersion @relation(fields: [validationVersionId], references: [id], onDelete: Restrict)
  testRun               TestRun          @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  evidenceReceipt       EvidenceReceipt? @relation(fields: [evidenceReceiptId], references: [id], onDelete: Restrict)

  @@unique([assessmentRunId, validationVersionId, resultMatrixCell])
  @@index([assessmentRunId, terminalizedAt])
  @@index([validationVersionId])
}

model EvidenceReceipt {
  id                          String                    @id @default(uuid())
  targetProjectId             String
  qualityPlanRevisionId       String
  assessmentId                String?
  validationVersionId         String
  evaluationSubjectRevisionId String
  resultMatrixCell            String
  assuranceLevel              AssuranceLevel
  outcome                     EvidenceOutcome
  runtimeInputHash            String
  environmentSnapshotHash     String
  browserSnapshotHash         String?
  dataProvenanceHash          String
  outputHash                  String
  reportHash                  String?
  logHash                     String?
  traceHash                   String?
  assessmentRunBindings       AssessmentRunBinding[]
  receiptHash                 String                    @unique
  sealedAt                    DateTime                  @default(now())
  targetProject               TargetProject             @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  assessment                  Assessment?               @relation(fields: [assessmentId, targetProjectId, qualityPlanRevisionId], references: [id, targetProjectId, qualityPlanRevisionId], onDelete: Restrict)
  validationVersion           ValidationVersion         @relation(fields: [validationVersionId, qualityPlanRevisionId], references: [id, qualityPlanRevisionId], onDelete: Restrict)
  evaluationSubjectRevision   EvaluationSubjectRevision @relation(fields: [evaluationSubjectRevisionId], references: [id], onDelete: Restrict)

  @@index([targetProjectId, validationVersionId, evaluationSubjectRevisionId, resultMatrixCell, runtimeInputHash])
  @@index([targetProjectId, sealedAt])
  @@index([assessmentId])
}

model AssessmentDecision {
  id           String                    @id @default(uuid())
  assessmentId String                    @unique
  decision     AssessmentDecisionOutcome
  rationale    String
  decidedBy    String
  decidedAt    DateTime                  @default(now())
  decisionHash String                    @unique
  assessment   Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model RequirementDriftReport {
  id                    String                 @id @default(uuid())
  qualityPlanId         String
  qualityPlanRevisionId String
  successorRevisionId   String?
  status                RequirementDriftStatus @default(PROPOSED)
  impactTraversalJson     String
  proposedDispositionJson String
  approvedAt            DateTime?
  createdAt             DateTime               @default(now())
  qualityPlanRevision   QualityPlanRevision    @relation("RevisionDriftReports", fields: [qualityPlanRevisionId, qualityPlanId], references: [id, qualityPlanId], onDelete: Cascade)
  successorRevision     QualityPlanRevision?   @relation("SuccessorRevisionDriftReports", fields: [successorRevisionId, qualityPlanId], references: [id, qualityPlanId], onDelete: Restrict)
}

