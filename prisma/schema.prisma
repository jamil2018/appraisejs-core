/// Phase 8 freezes only accepted artifacts and sealed evidence for an isolated Triager.
model QualityJourneyTriageAssignment {
  id                          String                       @id
  journeyId                   String
  executionCycleId            String
  workItemId                  String                       @unique
  predecessorReportRevisionId String?                      @unique
  inputHash                   String
  inputJson                   String
  createdAt                   DateTime                     @default(now())
  journey                     QualityJourney               @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  executionCycle              QualityJourneyExecutionCycle @relation(fields: [executionCycleId], references: [id], onDelete: Restrict)
  workItem                    QualityJourneyWorkItem       @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  report                      QualityJourneyTriageReport?  @relation("TriageReportAssignment")
  predecessorReport           QualityJourneyTriageReport?  @relation("TriageReportSuccessor", fields: [predecessorReportRevisionId], references: [id], onDelete: Restrict)

  @@index([journeyId, executionCycleId])
}

/// Published reports and review receipts are immutable, including unresolved outcomes.
model QualityJourneyTriageReport {
  closure             QualityJourneyClosure?
  activeForJourney    QualityJourney?                 @relation("ActiveTriageReport")
  id                  String                          @id
  journeyId           String
  assignmentId        String                          @unique
  contentHash         String
  reportJson          String
  idempotencyKey      String
  requestHash         String
  createdAt           DateTime                        @default(now())
  journey             QualityJourney                  @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  assignment          QualityJourneyTriageAssignment  @relation("TriageReportAssignment", fields: [assignmentId], references: [id], onDelete: Restrict)
  successorAssignment QualityJourneyTriageAssignment? @relation("TriageReportSuccessor")
  review              QualityJourneyReportReview?

  @@unique([journeyId, idempotencyKey])
}

model QualityJourneyReportReview {
  id               String                     @id
  journeyId        String
  reportRevisionId String                     @unique
  kind             String
  feedback         String
  idempotencyKey   String
  requestHash      String
  successorCycleId String?                    @unique
  successorCycle   QualityJourneyCycle?       @relation(fields: [successorCycleId], references: [id], onDelete: Restrict)
  createdAt        DateTime                   @default(now())
  journey          QualityJourney             @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  report           QualityJourneyTriageReport @relation(fields: [reportRevisionId], references: [id], onDelete: Restrict)

  @@unique([journeyId, idempotencyKey])
}

/// Immutable terminal approval of one exact report and its remaining risks.
model QualityJourneyClosure {
  id               String                     @id
  journeyId        String                     @unique
  reportRevisionId String                     @unique
  cycleId          String
  reportHash       String
  contentHash      String
  closureJson      String
  idempotencyKey   String
  requestHash      String
  closedAt         DateTime
  journey          QualityJourney             @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  report           QualityJourneyTriageReport @relation(fields: [reportRevisionId], references: [id], onDelete: Restrict)
}
