generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TestSuite {
  id              String            @id @default(uuid())
  name            String
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  moduleId        String
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  testCases       TestCase[]        @relation("TestSuiteTestCases")
  tags            Tag[]
  metrics         TestSuiteMetrics?
  testRuns        TestRunTestCase[]
  targetProjectId String
  targetProject   TargetProject     @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model Review {
  id         String       @id @default(uuid())
  testCaseId String
  reviewerId String
  status     ReviewStatus
  comments   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  testCase   TestCase     @relation(fields: [testCaseId], references: [id])
}

model LinkedJiraTicket {
  id            String   @id @default(uuid())
  testCaseId    String
  jiraTicketId  String
  jiraTicketUrl String
  jiraStatus    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  testCase      TestCase @relation(fields: [testCaseId], references: [id])
}

model StepDefinition {
  id                  String
  version             String
  status              StepDefinitionStatus
  title               String
  description         String
  definitionJson      String
  definitionHash      String
  humanProjectionHash String?
  agentContractHash   String?
  executionHash       String?
  provenanceJson      String
  createdAt           DateTime                   @default(now())
  publishedAt         DateTime?
  deprecatedAt        DateTime?
  humanProjection     StepHumanProjection?
  executionBinding    StepExecutionBinding?
  publicationReceipt  StepPublicationReceipt?
  deprecation         StepDefinitionDeprecation?

  @@id([id, version])
  @@index([status, title])
}

model StepDefinitionDraft {
  id                   String                       @id @default(uuid())
  proposedStepId       String
  proposedVersion      String
  revision             Int                          @default(1)
  draftJson            String
  draftHash            String
  reuseJustification   String?
  reuseEvidenceJson    String?
  validationReportJson String?
  reviewedDraftHash    String?
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewReceiptJson    String?
  reviewReceiptHash    String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  artifact             StepDefinitionDraftArtifact?

  @@index([proposedStepId, proposedVersion])
}

model StepDefinitionSearchReceipt {
  id                      String   @id @default(uuid())
  indexHash               String
  candidateReferencesJson String
  qualityPlanId           String?
  correlationId           String
  searchedAt              DateTime @default(now())
  expiresAt               DateTime

  @@index([expiresAt])
  @@index([qualityPlanId, correlationId])
}

model StepDefinitionDraftArtifact {
  draftId              String              @id
  contractSource       String
  handlerSource        String
  examplesJson         String
  manifestJson         String
  sourceHash           String
  compiledSource       String?
  compiledHash         String?
  diagnosticsJson      String?
  conformanceJson      String?
  conformanceHash      String?
  reviewedArtifactHash String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  draft                StepDefinitionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model StepReviewedExtension {
  id               String
  version          String
  exportName       String
  runtime          String
  capabilitiesJson String
  contractSource   String
  source           String
  compiledSource   String
  sourceHash       String
  compiledHash     String
  conformanceJson  String
  conformanceHash  String
  artifactHash     String    @unique
  reviewedBy       String
  reviewedAt       DateTime  @default(now())
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?

  @@id([id, version])
  @@index([sourceHash, compiledHash])
  @@index([revokedAt])
}

model StepHumanProjection {
  stepId         String
  stepVersion    String
  signature      String         @unique
  groupId        String
  projectionJson String
  projectionHash String
  definition     StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@index([groupId])
}

model StepExecutionBinding {
  stepId      String
  stepVersion String
  kind        StepExecutionKind
  bindingJson String
  bindingHash String
  definition  StepDefinition    @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@index([kind])
}

model StepPublicationReceipt {
  stepId               String
  stepVersion          String
  receiptJson          String
  receiptHash          String
  registryManifestHash String
  conformanceRunId     String
  reviewAuthority      String
  publishedAt          DateTime       @default(now())
  definition           StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@unique([receiptHash])
}

model StepDefinitionDeprecation {
  stepId             String
  stepVersion        String
  reason             String
  actor              String
  replacementStepId  String?
  replacementVersion String?
  deprecatedAt       DateTime       @default(now())
  definition         StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
}

/// Bounded, observational lifecycle telemetry. Payloads contain only the
/// closed-vocabulary outcome details validated by the application service.
model StepDefinitionTelemetryEvent {
  id            String   @id @default(cuid())
  surface       String
  outcome       String
  stepId        String?
  stepVersion   String?
  correlationId String?
  qualityPlanId String?
  payloadJson   String
  createdAt     DateTime @default(now())

  @@index([surface, outcome, createdAt])
  @@index([stepId, stepVersion, createdAt])
}

enum StepDefinitionStatus {
  ready
  deprecated
}

enum StepExecutionKind {
  operation
  composition
  reviewed_extension
}

model TestCase {
  id                String              @id @default(uuid())
  title             String
  description       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  linkedJiraTickets LinkedJiraTicket[]
  reviews           Review[]
  steps             TestCaseStep[]
  TestSuite         TestSuite[]         @relation("TestSuiteTestCases")
  TestRunTestCase   TestRunTestCase[]
  tags              Tag[]
  metrics           TestCaseMetrics?
  flowBlocks        TestCaseFlowBlock[]
  targetProjectId   String
  targetProject     TargetProject       @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model TestCaseStep {
  id             String                  @id @default(uuid())
  flowNodeId     String?
  testCaseId     String
  order          Int
  gherkinStep    String
  icon           StepIcon
  label          String
  invocationJson String
  testCase       TestCase                @relation(fields: [testCaseId], references: [id])
  parameters     TestCaseStepParameter[]
}

model TestCaseFlowBlock {
  id         String                  @id @default(uuid())
  name       String
  testCaseId String
  order      Int
  testCase   TestCase                @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  nodes      TestCaseFlowBlockNode[]
}

model TestCaseFlowBlockNode {
  id          String            @id @default(uuid())
  flowNodeId  String
  flowBlockId String
  flowBlock   TestCaseFlowBlock @relation(fields: [flowBlockId], references: [id], onDelete: Cascade)
}

model TemplateTestCase {
  id              String                      @id @default(uuid())
  name            String
  description     String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  steps           TemplateTestCaseStep[]
  flowBlocks      TemplateTestCaseFlowBlock[]
  targetProjectId String
  targetProject   TargetProject               @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, name])
}

model TemplateTestCaseStep {
  id                 String                          @id @default(uuid())
  flowNodeId         String?
  order              Int
  gherkinStep        String
  icon               StepIcon
  label              String
  templateTestCaseId String
  invocationJson     String
  templateTestCase   TemplateTestCase                @relation(fields: [templateTestCaseId], references: [id])
  parameters         TemplateTestCaseStepParameter[]
}

model TemplateTestCaseFlowBlock {
  id                 String                          @id @default(uuid())
  name               String
  templateTestCaseId String
  order              Int
  templateTestCase   TemplateTestCase                @relation(fields: [templateTestCaseId], references: [id], onDelete: Cascade)
  nodes              TemplateTestCaseFlowBlockNode[]
}

model TemplateTestCaseFlowBlockNode {
  id          String                    @id @default(uuid())
  flowNodeId  String
  flowBlockId String
  flowBlock   TemplateTestCaseFlowBlock @relation(fields: [flowBlockId], references: [id], onDelete: Cascade)
}

model TemplateTestCaseStepParameter {
  id                   String               @id @default(uuid())
  name                 String
  defaultValue         String
  order                Int
  testCaseStepId       String
  locatorId            String?
  type                 StepParameterType
  defaultLocatorId     String?
  defaultLocator       Locator?             @relation(fields: [defaultLocatorId], references: [id])
  templateTestCaseStep TemplateTestCaseStep @relation(fields: [testCaseStepId], references: [id], onDelete: Cascade)
}

model TestCaseStepParameter {
  id             String            @id @default(uuid())
  name           String
  value          String
  order          Int
  testCaseStepId String
  locatorId      String?
  type           StepParameterType
  Locator        Locator?          @relation(fields: [locatorId], references: [id])
  testCaseStep   TestCaseStep      @relation(fields: [testCaseStepId], references: [id], onDelete: Cascade)
}

model Locator {
  id                            String                          @id @default(uuid())
  name                          String
  value                         String
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  locatorGroupId                String?
  locatorGroup                  LocatorGroup?                   @relation(fields: [locatorGroupId], references: [id], onDelete: Cascade)
  TemplateTestCaseStepParameter TemplateTestCaseStepParameter[]
  stepParameters                TestCaseStepParameter[]
  conflicts                     ConflictResolution[]
  targetProjectId               String
  targetProject                 TargetProject                   @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model LocatorGroup {
  id              String        @id @default(uuid())
  name            String
  route           String        @default("/")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  moduleId        String
  locators        Locator[]
  module          Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  targetProjectId String
  targetProject   TargetProject @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, name])
}

model Module {
  id              String         @id @default(uuid())
  name            String
  parentId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  locatorGroups   LocatorGroup[]
  parent          Module?        @relation("ModuleHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Module[]       @relation("ModuleHierarchy")
  testSuites      TestSuite[]
  targetProjectId String
  targetProject   TargetProject  @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model TestRunTestCase {
  id              String                @id @default(uuid())
  testRunId       String
  testCaseId      String
  testSuiteId     String?
  status          TestRunTestCaseStatus @default(PENDING)
  result          TestRunTestCaseResult @default(UNTESTED)
  tracePath       String?
  testRun         TestRun               @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase        TestCase              @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testSuite       TestSuite?            @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)
  reportTestCases ReportTestCase[]
}

model TestRun {
  id                             String                          @id @default(uuid())
  name                           String
  preparationKey                 String?
  runId                          String                          @unique @default(uuid())
  startedAt                      DateTime                        @default(now())
  completedAt                    DateTime?
  status                         TestRunStatus                   @default(QUEUED)
  result                         TestRunResult                   @default(PENDING)
  intent                         TestRunIntent                   @default(INDEPENDENT)
  evidenceHealth                 TestRunEvidenceHealth           @default(invalid_missing_report)
  testCases                      TestRunTestCase[]
  updatedAt                      DateTime                        @updatedAt
  environment                    Environment                     @relation(fields: [environmentId], references: [id])
  environmentId                  String
  tags                           Tag[]
  testWorkersCount               Int?                            @default(1)
  browserEngine                  BrowserEngine                   @default(CHROMIUM)
  logs                           TestRunLog?
  logPath                        String?
  reportPath                     String?
  environmentSnapshotHash        String?
  environmentSnapshotJson        String?
  /// The explicit Environment scope token captured with a remote snapshot.
  /// Timestamps are not a safe optimistic-concurrency token on every SQLite
  /// platform, so remote lifecycle boundaries compare this integer as well.
  environmentSnapshotVersion     Int?
  reports                        Report[]
  targetProjectId                String
  targetProject                  TargetProject                   @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  runtimeCapsule                 RuntimeCapsule?
  runtimeCapsuleExecutionAttempt RuntimeCapsuleExecutionAttempt?
  assessmentRunBinding           AssessmentRunBinding?

  @@unique([targetProjectId, preparationKey])
  @@index([completedAt])
  @@index([result])
  @@index([evidenceHealth])
  @@index([targetProjectId])
  @@index([targetProjectId, startedAt, id])
}

model TargetProject {
  id                                          String                                       @id @default(uuid())
  kind                                        TargetProjectKind
  canonicalIdentity                           String                                       @unique
  canonicalPath                               String?
  normalizedRemoteOrigin                      String?
  displayName                                 String
  description                                 String?
  packageName                                 String?
  packageManager                              String?
  packageJson                                 String?
  fingerprint                                 String                                       @unique
  executionConsentMode                        ExecutionConsentMode                         @default(ALWAYS_ASK)
  createdAt                                   DateTime                                     @default(now())
  updatedAt                                   DateTime                                     @updatedAt
  lastDetectedAt                              DateTime                                     @default(now())
  testRuns                                    TestRun[]
  runtimeCapsules                             RuntimeCapsule[]
  runtimeCapsuleBlobs                         RuntimeCapsuleBlob[]
  runtimeCapsuleLeases                        RuntimeCapsuleLease[]
  resourceOwnerships                          ProjectResourceOwnership[]
  resourceImports                             ProjectResourceImport[]                      @relation("ResourceImportDestination")
  testSuites                                  TestSuite[]
  testCases                                   TestCase[]
  templateTestCases                           TemplateTestCase[]
  locators                                    Locator[]
  locatorGroups                               LocatorGroup[]
  modules                                     Module[]
  environments                                Environment[]
  tags                                        Tag[]
  reports                                     Report[]
  testCaseMetrics                             TestCaseMetrics[]
  testSuiteMetrics                            TestSuiteMetrics[]
  dashboardMetrics                            DashboardMetrics?
  agentPreflightReceipts                      AgentPreflightReceipt[]
  qualityPlans                                QualityPlan[]
  qualityValidationPublications               QualityValidationPublication[]
  qualityValidationGenerations                QualityValidationGeneration[]
  qualityValidationPublicationCommandReceipts QualityValidationPublicationCommandReceipt[]
  assessments                                 Assessment[]
  assessmentRuns                              AssessmentRun[]
  evidenceReceipts                            EvidenceReceipt[]
  assessmentPreparations                      AssessmentPreparation[]
  remoteEvaluationScopeBindings               RemoteEvaluationScopeBinding[]
  remoteEvaluationScopeIssuances              RemoteEvaluationScopeIssuance[]
  remoteEvaluationScopePartitionManifests     RemoteEvaluationScopePartitionManifest[]
  credentialExecutionRequests                 AssessmentExecutionRequest[]
  executionConsents                           ExecutionConsent[]
  qualityJourneys                             QualityJourney[]

  @@index([displayName])
  @@index([canonicalPath])
  @@index([normalizedRemoteOrigin])
  @@index([fingerprint])
}

model QualityJourney {
  id                                String                                    @id
  targetProjectId                   String
  rootIdempotencyKey                String
  rootRequestHash                   String
  stage                             QualityJourneyStage                       @default(INTAKE)
  status                            String                                    @default("ACTIVE")
  activeCycleId                     String
  activeRevisionIdsJson             String                                    @default("{}")
  analysisReviewHash                String?
  unresolvedQuestionIdsJson         String                                    @default("[]")
  blockerIdsJson                    String                                    @default("[]")
  activeWorkItemIdsJson             String                                    @default("[]")
  stateHash                         String
  version                           Int                                       @default(0)
  createdAt                         DateTime                                  @default(now())
  updatedAt                         DateTime                                  @updatedAt
  targetProject                     TargetProject                             @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  revisions                         QualityJourneyRevision[]
  cycles                            QualityJourneyCycle[]
  commands                          QualityJourneyCommand[]
  events                            QualityJourneyEvent[]
  workItems                         QualityJourneyWorkItem[]
  blockers                          QualityJourneyBlocker[]
  artifactLinks                     QualityJourneyArtifactLink[]
  artifacts                         QualityJourneyArtifact[]
  analysisRevisions                 QualityJourneyAnalysisRevision[]
  analysisQuestions                 QualityJourneyAnalysisQuestion[]
  analysisAnswers                   QualityJourneyAnalysisAnswer[]
  analysisPublications              QualityJourneyAnalysisPublication[]
  analysisDecisions                 QualityJourneyAnalysisDecision[]
  workAuthorizations                QualityJourneyWorkAuthorization[]
  discoveryRevisions                QualityJourneyDiscoveryRevision[]         @relation("JourneyDiscoveryRevisions")
  activeDiscoveryRevisionId         String?                                   @unique
  activeDiscoveryRevision           QualityJourneyDiscoveryRevision?          @relation("ActiveQualityJourneyDiscoveryRevision", fields: [activeDiscoveryRevisionId], references: [id], onDelete: Restrict)
  scenarioPortfolioRevisions        QualityJourneyScenarioPortfolioRevision[] @relation("JourneyScenarioPortfolioRevisions")
  scenarioDecisionReceipts          QualityJourneyScenarioDecisionReceipt[]
  activeScenarioPortfolioRevisionId String?                                   @unique
  activeScenarioPortfolioRevision   QualityJourneyScenarioPortfolioRevision?  @relation("ActiveQualityJourneyScenarioPortfolioRevision", fields: [activeScenarioPortfolioRevisionId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, rootIdempotencyKey])
  @@index([targetProjectId, status])
  @@index([targetProjectId, stage])
}

model QualityJourneyArtifact {
  id                        String                                   @id
  identityKey               String
  journeyId                 String
  targetProjectId           String
  cycleId                   String
  kind                      String
  artifactId                String
  revisionId                String?
  contentHash               String
  artifactJson              String
  createdAt                 DateTime                                 @default(now())
  journey                   QualityJourney                           @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  analysisRevision          QualityJourneyAnalysisRevision?
  analysisQuestion          QualityJourneyAnalysisQuestion?
  analysisAnswer            QualityJourneyAnalysisAnswer?
  analysisDecision          QualityJourneyAnalysisDecision?
  scenarioPortfolioRevision QualityJourneyScenarioPortfolioRevision?

  @@unique([journeyId, identityKey])
  @@index([targetProjectId, kind])
  @@index([journeyId, artifactId])
}

/// Phase 3 control records point at immutable QualityJourneyArtifact payloads.
/// Publication and approval are separate immutable facts, so reviewed charter
/// content is never updated in place.
model QualityJourneyAnalysisRevision {
  id                       String                             @id
  journeyId                String
  targetProjectId          String
  cycleId                  String
  artifactRecordId         String                             @unique
  artifactId               String
  artifactRevisionId       String
  revision                 Int
  contentHash              String
  predecessorRevisionId    String?                            @unique
  submissionIdempotencyKey String
  submissionHash           String
  submittedWorkItemId      String
  submittedAttemptId       String
  inputHash                String
  createdAt                DateTime                           @default(now())
  journey                  QualityJourney                     @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  artifact                 QualityJourneyArtifact             @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  submittedWorkItem        QualityJourneyWorkItem             @relation("QualityJourneyAnalysisSubmittedWorkItem", fields: [submittedWorkItemId], references: [id], onDelete: Restrict)
  submittedAttempt         QualityJourneyWorkAttempt          @relation("QualityJourneyAnalysisSubmittedAttempt", fields: [submittedAttemptId], references: [id], onDelete: Restrict)
  predecessor              QualityJourneyAnalysisRevision?    @relation("QualityJourneyAnalysisPredecessor", fields: [predecessorRevisionId], references: [id], onDelete: Restrict)
  successors               QualityJourneyAnalysisRevision[]   @relation("QualityJourneyAnalysisPredecessor")
  questions                QualityJourneyAnalysisQuestion[]
  publication              QualityJourneyAnalysisPublication?
  decision                 QualityJourneyAnalysisDecision?
  discoveryRevisions       QualityJourneyDiscoveryRevision[]

  @@unique([journeyId, artifactRevisionId])
  @@unique([journeyId, revision])
  @@unique([journeyId, submissionIdempotencyKey])
  @@index([journeyId, createdAt])
  @@index([targetProjectId, cycleId])
}

model QualityJourneyAnalysisQuestion {
  id                 String                         @id
  journeyId          String
  analysisRevisionId String
  artifactRecordId   String                         @unique
  questionId         String
  contentHash        String
  required           Boolean
  createdAt          DateTime                       @default(now())
  journey            QualityJourney                 @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  analysisRevision   QualityJourneyAnalysisRevision @relation(fields: [analysisRevisionId], references: [id], onDelete: Restrict)
  artifact           QualityJourneyArtifact         @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  answers            QualityJourneyAnalysisAnswer[]

  @@unique([analysisRevisionId, questionId])
  @@index([journeyId, required])
}

model QualityJourneyAnalysisAnswer {
  id                   String                         @id
  journeyId            String
  questionRecordId     String
  artifactRecordId     String                         @unique
  answerId             String
  contentHash          String
  actor                String
  correctionOfAnswerId String?
  idempotencyKey       String
  requestHash          String
  createdAt            DateTime                       @default(now())
  journey              QualityJourney                 @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  question             QualityJourneyAnalysisQuestion @relation(fields: [questionRecordId], references: [id], onDelete: Restrict)
  artifact             QualityJourneyArtifact         @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  correctionOf         QualityJourneyAnalysisAnswer?  @relation("QualityJourneyAnalysisAnswerCorrection", fields: [correctionOfAnswerId], references: [id], onDelete: Restrict)
  correction           QualityJourneyAnalysisAnswer?  @relation("QualityJourneyAnalysisAnswerCorrection")

  @@unique([journeyId, answerId])
  @@unique([journeyId, idempotencyKey])
  @@unique([correctionOfAnswerId])
  @@index([questionRecordId, createdAt])
}

model QualityJourneyAnalysisPublication {
  id                 String                         @id
  journeyId          String
  analysisRevisionId String                         @unique
  commandId          String                         @unique
  artifactHash       String
  reviewHash         String
  publishedAt        DateTime                       @default(now())
  journey            QualityJourney                 @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  analysisRevision   QualityJourneyAnalysisRevision @relation(fields: [analysisRevisionId], references: [id], onDelete: Restrict)

  @@index([journeyId, publishedAt])
}

model QualityJourneyAnalysisDecision {
  id                 String                            @id
  journeyId          String
  analysisRevisionId String                            @unique
  artifactRecordId   String                            @unique
  commandId          String                            @unique
  contentHash        String
  reviewHash         String
  decision           String
  actor              String
  createdAt          DateTime                          @default(now())
  journey            QualityJourney                    @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  analysisRevision   QualityJourneyAnalysisRevision    @relation(fields: [analysisRevisionId], references: [id], onDelete: Restrict)
  artifact           QualityJourneyArtifact            @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  discoveryRevisions QualityJourneyDiscoveryRevision[] @relation("QualityJourneyAnalysisDecisionDiscoveryRevisions")

  @@index([journeyId, createdAt])
}

/// Phase 4 freezes the exact discovery authority derived from one approved
/// Analysis revision.  Payloads remain immutable JSON so workers can be
/// replayed without consulting a later catalog; relational fields are the
/// authority for lineage, work-item ownership, and active-revision selection.
model QualityJourneyDiscoveryRevision {
  id                               String                                    @id
  journeyId                        String
  targetProjectId                  String
  cycleId                          String
  analysisRevisionId               String
  analysisDecisionId               String
  analysisArtifactId               String
  analysisRevisionArtifactId       String
  analysisRevisionContentHash      String
  analysisApprovalArtifactId       String
  analysisApprovalContentHash      String
  approvedRequirementSetHash       String
  environmentRegistryHash          String
  locatorRegistryHash              String
  resourceRegistryHash             String
  stepDefinitionRegistryHash       String
  operationRegistryHash            String
  scoutScopeJson                   String
  scoutInputHash                   String
  resourceScopeJson                String
  resourceInputHash                String
  scopeHash                        String
  scoutWorkItemId                  String                                    @unique
  resourceWorkItemId               String                                    @unique
  targetObservationJson            String?
  targetObservationHash            String?
  targetObservationIdempotencyKey  String?
  targetObservationSubmittedAt     DateTime?
  resourceResolutionJson           String?
  resourceResolutionHash           String?
  resourceResolutionIdempotencyKey String?
  resourceResolutionSubmittedAt    DateTime?
  status                           String                                    @default("COLLECTING")
  predecessorRevisionId            String?                                   @unique
  retryIdempotencyKey              String?
  retryRequestHash                 String?
  rowVersion                       Int                                       @default(0)
  completionHash                   String?
  createdAt                        DateTime                                  @default(now())
  completedAt                      DateTime?
  invalidatedAt                    DateTime?
  supersededAt                     DateTime?
  journey                          QualityJourney                            @relation("JourneyDiscoveryRevisions", fields: [journeyId], references: [id], onDelete: Restrict)
  activeForJourney                 QualityJourney?                           @relation("ActiveQualityJourneyDiscoveryRevision")
  analysisRevision                 QualityJourneyAnalysisRevision            @relation(fields: [analysisRevisionId], references: [id], onDelete: Restrict)
  analysisDecision                 QualityJourneyAnalysisDecision            @relation("QualityJourneyAnalysisDecisionDiscoveryRevisions", fields: [analysisDecisionId], references: [id], onDelete: Restrict)
  scoutWorkItem                    QualityJourneyWorkItem                    @relation("DiscoveryScoutWorkItem", fields: [scoutWorkItemId], references: [id], onDelete: Restrict)
  resourceWorkItem                 QualityJourneyWorkItem                    @relation("DiscoveryResourceWorkItem", fields: [resourceWorkItemId], references: [id], onDelete: Restrict)
  predecessor                      QualityJourneyDiscoveryRevision?          @relation("DiscoveryRevisionPredecessor", fields: [predecessorRevisionId], references: [id], onDelete: Restrict)
  successor                        QualityJourneyDiscoveryRevision?          @relation("DiscoveryRevisionPredecessor")
  scenarioPortfolioRevisions       QualityJourneyScenarioPortfolioRevision[] @relation("ScenarioPortfolioDiscoveryRevision")

