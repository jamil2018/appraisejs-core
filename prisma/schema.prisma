generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TestSuite {
  id          String            @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  moduleId    String
  module      Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  testCases   TestCase[]        @relation("TestSuiteTestCases")
  tags        Tag[]
  metrics     TestSuiteMetrics?
  testRuns    TestRunTestCase[]
}

model Review {
  id         String       @id @default(uuid())
  testCaseId String
  reviewerId String
  status     ReviewStatus
  comments   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  testCase   TestCase     @relation(fields: [testCaseId], references: [id])
}

model LinkedJiraTicket {
  id            String   @id @default(uuid())
  testCaseId    String
  jiraTicketId  String
  jiraTicketUrl String
  jiraStatus    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  testCase      TestCase @relation(fields: [testCaseId], references: [id])
}

model TemplateStep {
  id                   String                  @id @default(uuid())
  name                 String
  description          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  signature            String
  functionDefinition   String?
  type                 TemplateStepType
  icon                 TemplateStepIcon
  templateStepGroupId  String
  templateStepGroup    TemplateStepGroup       @relation("TemplateStepGroupSteps", fields: [templateStepGroupId], references: [id], onDelete: Cascade)
  parameters           TemplateStepParameter[]
  TemplateTestCaseStep TemplateTestCaseStep[]
  TestCaseStep         TestCaseStep[]
  StepBlockStep        StepBlockStep[]
}

model TemplateStepParameter {
  id             String            @id @default(uuid())
  name           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  templateStepId String
  order          Int
  type           StepParameterType
  templateStep   TemplateStep      @relation(fields: [templateStepId], references: [id], onDelete: Cascade)
}

model TemplateStepGroup {
  id            String                @id @default(uuid())
  name          String
  description   String?
  type          TemplateStepGroupType @default(ACTION)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  templateSteps TemplateStep[]        @relation("TemplateStepGroupSteps")
}

model StepBlock {
  id          String          @id @default(uuid())
  name        String
  description String?
  intent      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  steps       StepBlockStep[]
}

model StepBlockStep {
  id             String       @id @default(uuid())
  stepBlockId    String
  templateStepId String
  order          Int
  parameterMap   String       @default("{}")
  stepBlock      StepBlock    @relation(fields: [stepBlockId], references: [id], onDelete: Cascade)
  templateStep   TemplateStep @relation(fields: [templateStepId], references: [id], onDelete: Cascade)

  @@unique([stepBlockId, order])
}

model TestCase {
  id                String              @id @default(uuid())
  title             String
  description       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  linkedJiraTickets LinkedJiraTicket[]
  reviews           Review[]
  steps             TestCaseStep[]
  TestSuite         TestSuite[]         @relation("TestSuiteTestCases")
  TestRunTestCase   TestRunTestCase[]
  tags              Tag[]
  metrics           TestCaseMetrics?
  flowBlocks        TestCaseFlowBlock[]
}

model TestCaseStep {
  id             String                  @id @default(uuid())
  flowNodeId     String?
  testCaseId     String
  order          Int
  gherkinStep    String
  icon           TemplateStepIcon
  label          String
  templateStepId String
  TemplateStep   TemplateStep            @relation(fields: [templateStepId], references: [id], onDelete: Cascade)
  testCase       TestCase                @relation(fields: [testCaseId], references: [id])
  parameters     TestCaseStepParameter[]
}

model TestCaseFlowBlock {
  id         String                  @id @default(uuid())
  name       String
  testCaseId String
  order      Int
  testCase   TestCase                @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  nodes      TestCaseFlowBlockNode[]
}

model TestCaseFlowBlockNode {
  id          String            @id @default(uuid())
  flowNodeId  String
  flowBlockId String
  flowBlock   TestCaseFlowBlock @relation(fields: [flowBlockId], references: [id], onDelete: Cascade)
}

model TemplateTestCase {
  id          String                      @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  steps       TemplateTestCaseStep[]
  flowBlocks  TemplateTestCaseFlowBlock[]
}

model TemplateTestCaseStep {
  id                 String                          @id @default(uuid())
  flowNodeId         String?
  order              Int
  gherkinStep        String
  icon               TemplateStepIcon
  label              String
  templateTestCaseId String
  templateStepId     String
  TemplateStep       TemplateStep                    @relation(fields: [templateStepId], references: [id], onDelete: Cascade)
  templateTestCase   TemplateTestCase                @relation(fields: [templateTestCaseId], references: [id])
  parameters         TemplateTestCaseStepParameter[]
}

model TemplateTestCaseFlowBlock {
  id                 String                          @id @default(uuid())
  name               String
  templateTestCaseId String
  order              Int
  templateTestCase   TemplateTestCase                @relation(fields: [templateTestCaseId], references: [id], onDelete: Cascade)
  nodes              TemplateTestCaseFlowBlockNode[]
}

model TemplateTestCaseFlowBlockNode {
  id          String                    @id @default(uuid())
  flowNodeId  String
  flowBlockId String
  flowBlock   TemplateTestCaseFlowBlock @relation(fields: [flowBlockId], references: [id], onDelete: Cascade)
}

model TemplateTestCaseStepParameter {
  id                   String               @id @default(uuid())
  name                 String
  defaultValue         String
  order                Int
  testCaseStepId       String
  locatorId            String?
  type                 StepParameterType
  defaultLocatorId     String?
  defaultLocator       Locator?             @relation(fields: [defaultLocatorId], references: [id])
  templateTestCaseStep TemplateTestCaseStep @relation(fields: [testCaseStepId], references: [id], onDelete: Cascade)
}

model TestCaseStepParameter {
  id             String            @id @default(uuid())
  name           String
  value          String
  order          Int
  testCaseStepId String
  locatorId      String?
  type           StepParameterType
  Locator        Locator?          @relation(fields: [locatorId], references: [id])
  testCaseStep   TestCaseStep      @relation(fields: [testCaseStepId], references: [id], onDelete: Cascade)
}

model Locator {
  id                            String                          @id @default(uuid())
  name                          String
  value                         String
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  locatorGroupId                String?
  locatorGroup                  LocatorGroup?                   @relation(fields: [locatorGroupId], references: [id], onDelete: Cascade)
  TemplateTestCaseStepParameter TemplateTestCaseStepParameter[]
  stepParameters                TestCaseStepParameter[]
  conflicts                     ConflictResolution[]
}

model LocatorGroup {
  id        String    @id @default(uuid())
  name      String    @unique
  route     String    @default("/")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  moduleId  String
  locators  Locator[]
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Module {
  id            String         @id @default(uuid())
  name          String
  parentId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  locatorGroups LocatorGroup[]
  parent        Module?        @relation("ModuleHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Module[]       @relation("ModuleHierarchy")
  testSuites    TestSuite[]
}

model TestRunTestCase {
  id              String                @id @default(uuid())
  testRunId       String
  testCaseId      String
  testSuiteId     String?
  status          TestRunTestCaseStatus @default(PENDING)
  result          TestRunTestCaseResult @default(UNTESTED)
  tracePath       String?
  testRun         TestRun               @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase        TestCase              @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testSuite       TestSuite?            @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)
  reportTestCases ReportTestCase[]
}

model TestRun {
  id                             String                          @id @default(uuid())
  name                           String
  preparationKey                 String?                         @unique
  runId                          String                          @unique @default(uuid())
  startedAt                      DateTime                        @default(now())
  completedAt                    DateTime?
  status                         TestRunStatus                   @default(QUEUED)
  result                         TestRunResult                   @default(PENDING)
  evidenceHealth                 TestRunEvidenceHealth           @default(invalid_missing_report)
  testCases                      TestRunTestCase[]
  updatedAt                      DateTime                        @updatedAt
  environment                    Environment                     @relation(fields: [environmentId], references: [id])
  environmentId                  String
  tags                           Tag[]
  testWorkersCount               Int?                            @default(1)
  browserEngine                  BrowserEngine                   @default(CHROMIUM)
  logs                           TestRunLog?
  logPath                        String?
  reportPath                     String?
  reports                        Report[]
  planId                         String?
  plan                           PlanProjection?                 @relation(fields: [planId], references: [planId], onDelete: SetNull)
  targetProjectId                String?
  targetProject                  TargetProject?                  @relation(fields: [targetProjectId], references: [id], onDelete: SetNull)
  runtimeCapsule                 RuntimeCapsule?
  runtimeCapsuleExecutionAttempt RuntimeCapsuleExecutionAttempt?

  @@index([completedAt])
  @@index([result])
  @@index([evidenceHealth])
  @@index([targetProjectId])
}

model PlanProjection {
  id                             String                          @id @default(uuid())
  planId                         String                          @unique
  slug                           String                          @default("")
  legacyPlanId                   String?
  revision                       Int
  lifecycle                      String
  goal                           String
  description                    String
  sourceHash                     String
  planContentHash                String                          @default("")
  planStateHash                  String                          @default("")
  reviewBindingHash              String                          @default("")
  planPath                       String
  reviewJson                     String?
  validationJson                 String?
  layoutJson                     String?
  stale                          Boolean                         @default(false)
  conflicted                     Boolean                         @default(false)
  deletedAt                      DateTime?
  lastValidProjectedAt           DateTime
  lastSyncAt                     DateTime                        @default(now())
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  tasks                          PlanTaskProjection[]
  issues                         PlanSyncIssue[]
  revisions                      PlanRevision[]
  events                         PlanEvent[]
  coordinatorLease               PlanCoordinatorLease?
  personalLayouts                PlanPersonalLayout[]
  testRuns                       TestRun[]
  providerRuns                   ProviderWorkflowRun[]
  baselineAttempts               BaselineAttempt[]
  validationAstPublishOperations ValidationAstPublishOperation[]
  targetProjectId                String?
  targetProject                  TargetProject?                  @relation(fields: [targetProjectId], references: [id], onDelete: SetNull)

  @@index([stale])
  @@index([conflicted])
  @@index([slug])
  @@index([legacyPlanId])
  @@index([targetProjectId])
}

model BaselineAttempt {
  id                 String                 @id
  planProjectionId   String
  validationId       String
  validationRevision Int
  validationHash     String
  browser            String
  environment        String
  testRunId          String
  evidenceJson       String
  createdAt          DateTime
  recordedAt         DateTime               @default(now())
  plan               PlanProjection         @relation(fields: [planProjectionId], references: [id], onDelete: Cascade)
  events             BaselineAttemptEvent[]

  @@index([planProjectionId, createdAt])
  @@index([testRunId])
}

model BaselineAttemptEvent {
  id             String          @id @default(uuid())
  attemptId      String
  kind           String
  payloadJson    String
  idempotencyKey String
  sequence       Int
  createdAt      DateTime        @default(now())
  attempt        BaselineAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, idempotencyKey])
  @@unique([attemptId, sequence])
  @@index([attemptId, createdAt])
}

model TargetProject {
  id                             String                          @id @default(uuid())
  canonicalPath                  String                          @unique
  displayName                    String
  packageName                    String?
  packageManager                 String?
  packageJson                    String?
  fingerprint                    String                          @unique
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  lastDetectedAt                 DateTime                        @default(now())
  planProjections                PlanProjection[]
  providerRuns                   ProviderWorkflowRun[]
  testRuns                       TestRun[]
  validationAstPublishOperations ValidationAstPublishOperation[]
  runtimeCapsules                RuntimeCapsule[]
  runtimeCapsuleBlobs            RuntimeCapsuleBlob[]
  runtimeCapsuleLeases           RuntimeCapsuleLease[]
  repositoryExportJobs           RepositoryExportJob[]
  repositoryExportReceipts       RepositoryExportReceipt[]
  resourceOwnerships             ProjectResourceOwnership[]
  resourceImports                ProjectResourceImport[]         @relation("ResourceImportDestination")
  validationResourceProposals    ValidationResourceProposal[]

  @@index([displayName])
  @@index([fingerprint])
}

model ValidationResourceProposal {
  id              String        @id @default(uuid())
  planId          String
  targetProjectId String
  idempotencyKey  String
  proposalHash    String
  proposalJson    String
  resultJson      String
  createdAt       DateTime      @default(now())
  targetProject   TargetProject @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([planId, idempotencyKey])
  @@unique([targetProjectId, proposalHash])
  @@index([targetProjectId, createdAt])
}

model ProjectResourceOwnership {
  id              String                  @id @default(uuid())
  entityType      String
  entityId        String
  scope           ResourceScope
  targetProjectId String?
  origin          String
  provenanceJson  String                  @default("{}")
  contentHash     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  targetProject   TargetProject?          @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  imports         ProjectResourceImport[]

  @@unique([entityType, entityId])
  @@index([targetProjectId, entityType])
  @@index([scope, entityType])
}

model ProjectResourceImport {
  id                   String                   @id @default(uuid())
  sourceOwnershipId    String
  destinationProjectId String
  sharingMode          ResourceSharingMode
  sourceContentHash    String
  actor                String
  propagationPolicy    String
  createdAt            DateTime                 @default(now())
  sourceOwnership      ProjectResourceOwnership @relation(fields: [sourceOwnershipId], references: [id], onDelete: Restrict)
  destinationProject   TargetProject            @relation("ResourceImportDestination", fields: [destinationProjectId], references: [id], onDelete: Restrict)

  @@unique([sourceOwnershipId, destinationProjectId, sharingMode])
  @@index([destinationProjectId, createdAt])
}

enum ResourceScope {
  system
  global_library
  project
  publication
  runtime
  quarantined
}

enum ResourceSharingMode {
  immutable_reference
  copy
}

enum RepositoryExportPolicy {
  disabled
  optional
  required
}

enum RepositoryExportJobState {
  queued
  running
  conflict
  succeeded
  failed
}

model RepositoryExportJob {
  id                 String                        @id @default(uuid())
  targetProjectId    String
  publishOperationId String
  validationHash     String
  destinationPath    String
  policy             RepositoryExportPolicy        @default(disabled)
  state              RepositoryExportJobState      @default(queued)
  attemptCount       Int                           @default(0)
  idempotencyKey     String                        @unique
  manifestHash       String?
  manifestJson       String?
  conflictJson       String?
  failureCode        String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  completedAt        DateTime?
  targetProject      TargetProject                 @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  publishOperation   ValidationAstPublishOperation @relation(fields: [publishOperationId], references: [id], onDelete: Restrict)
  receipt            RepositoryExportReceipt?

  @@unique([targetProjectId, validationHash, destinationPath])
  @@index([state, updatedAt])
  @@index([targetProjectId, validationHash])
}

model RepositoryExportReceipt {
  id              String              @id @default(uuid())
  jobId           String              @unique
  targetProjectId String
  validationHash  String
  manifestHash    String
  destinationPath String
  receiptJson     String
  completedAt     DateTime            @default(now())
  job             RepositoryExportJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  targetProject   TargetProject       @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, validationHash, destinationPath])
  @@index([targetProjectId, validationHash])
}

model RuntimeCapsule {
  id               String                          @id @default(uuid())
  targetProjectId  String
  testRunId        String                          @unique
  validationHash   String
  capsuleHash      String
  manifestHash     String
  manifestJson     String
  storagePath      String
  integrityState   RuntimeCapsuleIntegrityState    @default(staging)
  version          Int                             @default(1)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  targetProject    TargetProject                   @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  testRun          TestRun                         @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  blobReferences   RuntimeCapsuleBlobReference[]
  executionAttempt RuntimeCapsuleExecutionAttempt?

  @@unique([targetProjectId, validationHash, testRunId])
  @@unique([targetProjectId, storagePath])
  @@index([targetProjectId, validationHash])
  @@index([integrityState])
}

model RuntimeCapsuleExecutionAttempt {
  id                  String                              @id @default(uuid())
  testRunId           String                              @unique
  capsuleId           String                              @unique
  receiptHash         String
  preflightResultJson String
  preflightResultHash String
  preflightCheckedAt  DateTime
  state               RuntimeCapsuleExecutionAttemptState @default(PREPARED)
  ownerToken          String
  version             Int                                 @default(1)
  startedAt           DateTime?
  completedAt         DateTime?
  failure             String?
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  testRun             TestRun                             @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  capsule             RuntimeCapsule                      @relation(fields: [capsuleId], references: [id], onDelete: Restrict)

  @@index([state, updatedAt])
}

enum RuntimeCapsuleExecutionAttemptState {
  PREPARED
  STARTING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

model RuntimeCapsuleBlob {
  id              String                        @id @default(uuid())
  targetProjectId String
  contentHash     String
  size            Int
  storagePath     String
  integrityState  RuntimeCapsuleIntegrityState  @default(staging)
  version         Int                           @default(1)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  references      RuntimeCapsuleBlobReference[]
  targetProject   TargetProject                 @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, contentHash])
  @@unique([targetProjectId, storagePath])
  @@index([targetProjectId])
  @@index([integrityState])
}

model RuntimeCapsuleBlobReference {
  id        String             @id @default(uuid())
  capsuleId String
  blobId    String
  filePath  String
  capsule   RuntimeCapsule     @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  blob      RuntimeCapsuleBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@unique([capsuleId, filePath])
  @@unique([capsuleId, blobId, filePath])
  @@index([blobId])
}

enum RuntimeCapsuleIntegrityState {
  staging
  ready
  missing
  corrupt
}

model RuntimeCapsuleLease {
  id              String        @id @default(uuid())
  targetProjectId String
  validationHash  String
  runId           String
  ownerToken      String
  leaseExpiresAt  DateTime
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  targetProject   TargetProject @relation(fields: [targetProjectId], references: [id], onDelete: Cascade)

  @@unique([targetProjectId, validationHash, runId])
  @@index([leaseExpiresAt])
}

model ProviderAdapterRegistration {
  id               String                @id @default(uuid())
  key              String                @unique
  displayName      String
  providerKind     String
  adapterVersion   String
  capabilitiesJson String
  enabled          Boolean               @default(true)
  executablePath   String?
  detectedVersion  String?
  probeStatus      String                @default("not_probed")
  probeMessage     String?
  lastProbedAt     DateTime?
  defaultProfile   String?
  defaultModel     String?
  launchEnabled    Boolean               @default(false)
  settingsJson     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  runs             ProviderWorkflowRun[]

  @@index([providerKind, enabled])
  @@index([enabled, launchEnabled, probeStatus])
}

model ProviderWorkflowRun {
  id                      String                       @id @default(uuid())
  planProjectionId        String?
  targetProjectId         String
  providerAdapterId       String?
  providerKind            String
  providerProfile         String?
  adapterVersion          String
  status                  String
  lifecyclePhase          String
  capabilitySnapshotJson  String
  launchPrompt            String
  approvedScopeJson       String?
  appraiseInstructions    String
  providerSessionId       String?
  providerThreadId        String?
  providerProcessId       String?
  preRunRepoSnapshotJson  String?
  postRunRepoSnapshotJson String?
  changedFilesJson        String?
  artifactHashesJson      String?
  failureReason           String?
  cancelledAt             DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  plan                    PlanProjection?              @relation(fields: [planProjectionId], references: [id], onDelete: SetNull)
  targetProject           TargetProject                @relation(fields: [targetProjectId], references: [id], onDelete: Cascade)
  providerAdapter         ProviderAdapterRegistration? @relation(fields: [providerAdapterId], references: [id], onDelete: SetNull)
  events                  ProviderRunEvent[]
  permissionDecisions     ProviderPermissionDecision[]
  artifactSnapshots       ProviderArtifactSnapshot[]

  @@index([planProjectionId])
  @@index([targetProjectId])
  @@index([providerKind, status])
  @@index([createdAt])
}

model ProviderRunEvent {
  id          String              @id @default(uuid())
  runId       String
  sequence    Int
  type        String
  payloadJson String?
  stream      String?
  createdAt   DateTime            @default(now())
  run         ProviderWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
}

model ProviderPermissionDecision {
  id             String              @id @default(uuid())
  runId          String
  requestId      String
  decision       String
  riskTier       String
  requestedScope String
  payloadJson    String
  reason         String?
  decidedBy      String
  decidedAt      DateTime            @default(now())
  run            ProviderWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, requestId])
  @@index([runId, decidedAt])
}

model ProviderArtifactSnapshot {
  id           String              @id @default(uuid())
  runId        String
  path         String
  kind         String
  hash         String?
  metadataJson String?
  capturedAt   DateTime            @default(now())
  run          ProviderWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, path, kind])
  @@index([runId, capturedAt])
}

model PlanTaskProjection {
  id               String         @id @default(uuid())
  planProjectionId String
  taskId           String
  title            String
  description      String
  acceptanceJson   String
  validationIntent String
  position         Int
  plan             PlanProjection @relation(fields: [planProjectionId], references: [id], onDelete: Cascade)

  @@unique([planProjectionId, taskId])
  @@index([planProjectionId, position])
}

model PlanSyncIssue {
  id               String         @id @default(uuid())
  planProjectionId String
  code             String
  artifactPath     String?
  message          String
  blocking         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  resolvedAt       DateTime?
  plan             PlanProjection @relation(fields: [planProjectionId], references: [id], onDelete: Cascade)

  @@index([planProjectionId, resolvedAt])
}

model PlanRevision {
  id               String         @id @default(uuid())
  planProjectionId String
  sourceHash       String
  gitCommit        String?
  dirtyHashesJson  String?
  snapshotJson     String?
  reducedAssurance Boolean        @default(false)
  createdAt        DateTime       @default(now())
  plan             PlanProjection @relation(fields: [planProjectionId], references: [id], onDelete: Cascade)

  @@unique([planProjectionId, sourceHash])
}

model PlanEvent {
  id                 String                         @id @default(uuid())
  planProjectionId   String
  publishOperationId String?
  validationId       String?
  sequence           Int
  type               String
  payloadJson        String?
  previousStateHash  String?
  stateHash          String?
  planContentHash    String?
  revision           Int?
  actor              String?
  acknowledgedAt     DateTime?
  acknowledgedBy     String?
  supersededAt       DateTime?
  createdAt          DateTime                       @default(now())
  plan               PlanProjection                 @relation(fields: [planProjectionId], references: [id], onDelete: Cascade)
  publishOperation   ValidationAstPublishOperation? @relation(fields: [publishOperationId], references: [id], onDelete: Restrict)

  @@unique([planProjectionId, sequence])
  @@unique([publishOperationId, type])
  @@unique([publishOperationId, validationId])
  @@index([planProjectionId, acknowledgedAt, sequence])
}

model AppraiseProjectIdentity {
  id                 String    @id @default(uuid())
  projectFingerprint String    @unique
  tokenHash          String
  createdAt          DateTime  @default(now())
  rotatedAt          DateTime?
}

model DelegatedAuthorizationNonce {
  nonce      String   @id
  issuer     String
  expiresAt  DateTime
  consumedAt DateTime @default(now())

  @@index([expiresAt])
}

model DelegatedValidationAstSubmission {
  id                String   @id @default(uuid())
  nonce             String   @unique
  targetFingerprint String
  planHash          String
  issuer            String
  astId             String
  astJson           String
  receiptJson       String
  receivedAt        DateTime @default(now())

  @@index([targetFingerprint, planHash, receivedAt])
}

model ValidationAstPublishOperation {
  id                       String                      @id @default(uuid())
  planId                   String
  planProjectionId         String
  targetProjectId          String
  targetFingerprint        String
  idempotencyKey           String
  operationHash            String                      @unique
  phase                    String                      @default("prepared")
  expectedPlanHash         String
  expectedPlanArtifactHash String
  expectedValidationHash   String?
  expectedReviewHash       String
  planHash                 String
  validationHash           String
  reviewHash               String
  planContent              String
  validationContent        String
  reviewContent            String
  astId                    String
  astHash                  String
  contextHash              String
  previewHash              String
  receiptHash              String
  projectionHash           String
  projectionJson           String
  validationProjectionJson String
  runtimeInputHash         String?
  runtimeInputJson         String?
  failure                  String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  extensionReviews         ValidationExtensionReview[]
  events                   PlanEvent[]
  plan                     PlanProjection              @relation(fields: [planProjectionId], references: [id], onDelete: Restrict)
  targetProject            TargetProject               @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  repositoryExportJobs     RepositoryExportJob[]

  @@unique([planId, idempotencyKey])
  @@index([phase, updatedAt])
  @@index([planProjectionId, phase])
  @@index([targetProjectId, phase])
}

model ValidationExtensionReview {
  id           String                        @id @default(uuid())
  operationId  String
  extensionId  String
  version      String
  sourceHash   String
  compiledHash String
  artifactHash String
  artifactJson String
  createdAt    DateTime                      @default(now())
  operation    ValidationAstPublishOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, extensionId, version])
  @@index([artifactHash])
}

model PlanCoordinatorLease {
  id               String         @id @default(uuid())
  planProjectionId String         @unique
  coordinatorId    String
  connectionId     String         @unique
  leaseExpiresAt   DateTime
  takeoverApproved Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  plan             PlanProjection @relation(fields: [planProjectionId], references: [id], onDelete: Cascade)

  @@index([leaseExpiresAt])
}

model PlanPersonalLayout {
  id               String         @id @default(uuid())
  planProjectionId String
  owner            String
  positionsJson    String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  plan             PlanProjection @relation(fields: [planProjectionId], references: [id], onDelete: Cascade)

  @@unique([planProjectionId, owner])
}

model TestRunLog {
  id        String   @id @default(uuid())
  testRunId String   @unique
  logs      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  testRun   TestRun  @relation(fields: [testRunId], references: [runId], onDelete: Cascade)
}

model Environment {
  id         String    @id @default(uuid())
  name       String    @unique
  baseUrl    String
  apiBaseUrl String?
  username   String?
  password   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  testRuns   TestRun[]
}

model Tag {
  id            String      @id @default(uuid())
  name          String
  tagExpression String
  type          TagType     @default(FILTER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  testRuns      TestRun[]
  testSuites    TestSuite[]
  testCases     TestCase[]
}

model ConflictResolution {
  id                  String       @id @default(uuid())
  entityType          EntityType
  entityId            String
  conflictType        ConflictType
  conflictingEntityId String?
  resolved            Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  locator             Locator?     @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

model ReportTestCase {
  id                String          @id @default(uuid())
  reportId          String
  testCaseId        String
  testRunTestCaseId String
  reportScenarioId  String?
  testRunTestCase   TestRunTestCase @relation(fields: [testRunTestCaseId], references: [id], onDelete: Cascade)
  report            Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportScenario    ReportScenario? @relation(fields: [reportScenarioId], references: [id], onDelete: SetNull)
  duration          String
}

model Report {
  id          String           @id @default(uuid())
  name        String
  description String?
  reportPath  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  testRunId   String
  testRun     TestRun          @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCases   ReportTestCase[]
  features    ReportFeature[]
}

model ReportFeature {
  id          String             @id @default(uuid())
  reportId    String
  name        String
  description String?
  uri         String
  line        Int
  keyword     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  report      Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tags        ReportFeatureTag[]
  scenarios   ReportScenario[]
}

model ReportFeatureTag {
  id              String        @id @default(uuid())
  reportFeatureId String
  tagName         String
  line            Int
  createdAt       DateTime      @default(now())
  reportFeature   ReportFeature @relation(fields: [reportFeatureId], references: [id], onDelete: Cascade)
}

model ReportScenario {
  id              String              @id @default(uuid())
  reportFeatureId String
  name            String
  description     String?
  line            Int
  keyword         String
  type            String
  cucumberId      String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reportFeature   ReportFeature       @relation(fields: [reportFeatureId], references: [id], onDelete: Cascade)
  tags            ReportScenarioTag[]
  steps           ReportStep[]
  hooks           ReportHook[]
  reportTestCases ReportTestCase[]
}

model ReportScenarioTag {
  id               String         @id @default(uuid())
  reportScenarioId String
  tagName          String
  line             Int
  createdAt        DateTime       @default(now())
  reportScenario   ReportScenario @relation(fields: [reportScenarioId], references: [id], onDelete: Cascade)
}

model ReportStep {
  id               String         @id @default(uuid())
  reportScenarioId String
  keyword          StepKeyword
  line             Int?
  name             String
  matchLocation    String?
  status           StepStatus
  duration         String
  errorMessage     String?
  errorTrace       String?
  screenshotPath   String?
  hidden           Boolean        @default(false)
  order            Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reportScenario   ReportScenario @relation(fields: [reportScenarioId], references: [id], onDelete: Cascade)
}

model ReportHook {
  id               String         @id @default(uuid())
  reportScenarioId String
  keyword          StepKeyword
  status           StepStatus
  duration         String
  errorMessage     String?
  errorTrace       String?
  hidden           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reportScenario   ReportScenario @relation(fields: [reportScenarioId], references: [id], onDelete: Cascade)
}

model TestCaseMetrics {
  id                  String    @id @default(uuid())
  testCaseId          String    @unique
  isRepeatedlyFailing Boolean   @default(false)
  isFlaky             Boolean   @default(false)
  consecutiveFailures Int       @default(0)
  failureRate         Float     @default(0)
  totalRecentRuns     Int       @default(0)
  failedRecentRuns    Int       @default(0)
  lastExecutedAt      DateTime?
  lastFailedAt        DateTime?
  lastPassedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  testCase            TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([isRepeatedlyFailing])
  @@index([isFlaky])
}

model TestSuiteMetrics {
  id             String    @id @default(uuid())
  testSuiteId    String    @unique
  lastExecutedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  testSuite      TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)

  @@index([lastExecutedAt])
}

model DashboardMetrics {
  id                             String   @id @default(uuid())
  failedRecentRunsCount          Int      @default(0)
  repeatedlyFailingTestsCount    Int      @default(0)
  flakyTestsCount                Int      @default(0)
  suitesNotExecutedRecentlyCount Int      @default(0)
  lastUpdatedAt                  DateTime @default(now())
  createdAt                      DateTime @default(now())
}

