generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TestSuite {
  id              String            @id @default(uuid())
  name            String
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  moduleId        String
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  testCases       TestCase[]        @relation("TestSuiteTestCases")
  tags            Tag[]
  metrics         TestSuiteMetrics?
  testRuns        TestRunTestCase[]
  targetProjectId String
  targetProject   TargetProject     @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model Review {
  id         String       @id @default(uuid())
  testCaseId String
  reviewerId String
  status     ReviewStatus
  comments   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  testCase   TestCase     @relation(fields: [testCaseId], references: [id])
}

model LinkedJiraTicket {
  id            String   @id @default(uuid())
  testCaseId    String
  jiraTicketId  String
  jiraTicketUrl String
  jiraStatus    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  testCase      TestCase @relation(fields: [testCaseId], references: [id])
}

model StepDefinition {
  id                  String
  version             String
  status              StepDefinitionStatus
  title               String
  description         String
  definitionJson      String
  definitionHash      String
  humanProjectionHash String?
  agentContractHash   String?
  executionHash       String?
  provenanceJson      String
  createdAt           DateTime                   @default(now())
  publishedAt         DateTime?
  deprecatedAt        DateTime?
  humanProjection     StepHumanProjection?
  executionBinding    StepExecutionBinding?
  publicationReceipt  StepPublicationReceipt?
  deprecation         StepDefinitionDeprecation?

  @@id([id, version])
  @@index([status, title])
}

model StepDefinitionDraft {
  id                   String                       @id @default(uuid())
  proposedStepId       String
  proposedVersion      String
  revision             Int                          @default(1)
  draftJson            String
  draftHash            String
  reuseJustification   String?
  reuseEvidenceJson    String?
  validationReportJson String?
  reviewedDraftHash    String?
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewReceiptJson    String?
  reviewReceiptHash    String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  artifact             StepDefinitionDraftArtifact?

  @@index([proposedStepId, proposedVersion])
}

model StepDefinitionSearchReceipt {
  id                      String   @id @default(uuid())
  indexHash               String
  candidateReferencesJson String
  journeyId               String?
  correlationId           String
  searchedAt              DateTime @default(now())
  expiresAt               DateTime

  @@index([expiresAt])
  @@index([journeyId, correlationId])
}

model StepDefinitionDraftArtifact {
  draftId              String              @id
  contractSource       String
  handlerSource        String
  examplesJson         String
  manifestJson         String
  sourceHash           String
  compiledSource       String?
  compiledHash         String?
  diagnosticsJson      String?
  conformanceJson      String?
  conformanceHash      String?
  reviewedArtifactHash String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  draft                StepDefinitionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model StepReviewedExtension {
  id               String
  version          String
  exportName       String
  runtime          String
  capabilitiesJson String
  contractSource   String
  source           String
  compiledSource   String
  sourceHash       String
  compiledHash     String
  conformanceJson  String
  conformanceHash  String
  artifactHash     String    @unique
  reviewedBy       String
  reviewedAt       DateTime  @default(now())
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?

  @@id([id, version])
  @@index([sourceHash, compiledHash])
  @@index([revokedAt])
}

model StepHumanProjection {
  stepId         String
  stepVersion    String
  signature      String         @unique
  groupId        String
  projectionJson String
  projectionHash String
  definition     StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@index([groupId])
}

model StepExecutionBinding {
  stepId      String
  stepVersion String
  kind        StepExecutionKind
  bindingJson String
  bindingHash String
  definition  StepDefinition    @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@index([kind])
}

model StepPublicationReceipt {
  stepId               String
  stepVersion          String
  receiptJson          String
  receiptHash          String
  registryManifestHash String
  conformanceRunId     String
  reviewAuthority      String
  publishedAt          DateTime       @default(now())
  definition           StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
  @@unique([receiptHash])
}

model StepDefinitionDeprecation {
  stepId             String
  stepVersion        String
  reason             String
  actor              String
  replacementStepId  String?
  replacementVersion String?
  deprecatedAt       DateTime       @default(now())
  definition         StepDefinition @relation(fields: [stepId, stepVersion], references: [id, version], onDelete: Restrict)

  @@id([stepId, stepVersion])
}

/// Bounded, observational lifecycle telemetry. Payloads contain only the
/// closed-vocabulary outcome details validated by the application service.
model StepDefinitionTelemetryEvent {
  id            String   @id @default(cuid())
  surface       String
  outcome       String
  stepId        String?
  stepVersion   String?
  correlationId String?
  journeyId     String?
  payloadJson   String
  createdAt     DateTime @default(now())

  @@index([surface, outcome, createdAt])
  @@index([stepId, stepVersion, createdAt])
}

enum StepDefinitionStatus {
  ready
  deprecated
}

enum StepExecutionKind {
  operation
  composition
  reviewed_extension
}

model TestCase {
  id                String              @id @default(uuid())
  title             String
  description       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  linkedJiraTickets LinkedJiraTicket[]
  reviews           Review[]
  steps             TestCaseStep[]
  TestSuite         TestSuite[]         @relation("TestSuiteTestCases")
  TestRunTestCase   TestRunTestCase[]
  tags              Tag[]
  metrics           TestCaseMetrics?
  flowBlocks        TestCaseFlowBlock[]
  targetProjectId   String
  targetProject     TargetProject       @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model TestCaseStep {
  id             String                  @id @default(uuid())
  flowNodeId     String?
  testCaseId     String
  order          Int
  gherkinStep    String
  icon           StepIcon
  label          String
  invocationJson String
  testCase       TestCase                @relation(fields: [testCaseId], references: [id])
  parameters     TestCaseStepParameter[]
}

model TestCaseFlowBlock {
  id         String                  @id @default(uuid())
  name       String
  testCaseId String
  order      Int
  testCase   TestCase                @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  nodes      TestCaseFlowBlockNode[]
}

model TestCaseFlowBlockNode {
  id          String            @id @default(uuid())
  flowNodeId  String
  flowBlockId String
  flowBlock   TestCaseFlowBlock @relation(fields: [flowBlockId], references: [id], onDelete: Cascade)
}

model TemplateTestCase {
  id              String                      @id @default(uuid())
  name            String
  description     String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  steps           TemplateTestCaseStep[]
  flowBlocks      TemplateTestCaseFlowBlock[]
  targetProjectId String
  targetProject   TargetProject               @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, name])
}

model TemplateTestCaseStep {
  id                 String                          @id @default(uuid())
  flowNodeId         String?
  order              Int
  gherkinStep        String
  icon               StepIcon
  label              String
  templateTestCaseId String
  invocationJson     String
  templateTestCase   TemplateTestCase                @relation(fields: [templateTestCaseId], references: [id])
  parameters         TemplateTestCaseStepParameter[]
}

model TemplateTestCaseFlowBlock {
  id                 String                          @id @default(uuid())
  name               String
  templateTestCaseId String
  order              Int
  templateTestCase   TemplateTestCase                @relation(fields: [templateTestCaseId], references: [id], onDelete: Cascade)
  nodes              TemplateTestCaseFlowBlockNode[]
}

model TemplateTestCaseFlowBlockNode {
  id          String                    @id @default(uuid())
  flowNodeId  String
  flowBlockId String
  flowBlock   TemplateTestCaseFlowBlock @relation(fields: [flowBlockId], references: [id], onDelete: Cascade)
}

model TemplateTestCaseStepParameter {
  id                   String               @id @default(uuid())
  name                 String
  defaultValue         String
  order                Int
  testCaseStepId       String
  locatorId            String?
  type                 StepParameterType
  defaultLocatorId     String?
  defaultLocator       Locator?             @relation(fields: [defaultLocatorId], references: [id])
  templateTestCaseStep TemplateTestCaseStep @relation(fields: [testCaseStepId], references: [id], onDelete: Cascade)
}

model TestCaseStepParameter {
  id             String            @id @default(uuid())
  name           String
  value          String
  order          Int
  testCaseStepId String
  locatorId      String?
  type           StepParameterType
  Locator        Locator?          @relation(fields: [locatorId], references: [id])
  testCaseStep   TestCaseStep      @relation(fields: [testCaseStepId], references: [id], onDelete: Cascade)
}

model Locator {
  id                            String                          @id @default(uuid())
  name                          String
  value                         String
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  locatorGroupId                String?
  locatorGroup                  LocatorGroup?                   @relation(fields: [locatorGroupId], references: [id], onDelete: Cascade)
  TemplateTestCaseStepParameter TemplateTestCaseStepParameter[]
  stepParameters                TestCaseStepParameter[]
  conflicts                     ConflictResolution[]
  targetProjectId               String
  targetProject                 TargetProject                   @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model LocatorGroup {
  id              String        @id @default(uuid())
  name            String
  route           String        @default("/")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  moduleId        String
  locators        Locator[]
  module          Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  targetProjectId String
  targetProject   TargetProject @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@unique([targetProjectId, name])
}

model Module {
  id              String         @id @default(uuid())
  name            String
  parentId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  locatorGroups   LocatorGroup[]
  parent          Module?        @relation("ModuleHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Module[]       @relation("ModuleHierarchy")
  testSuites      TestSuite[]
  targetProjectId String
  targetProject   TargetProject  @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([targetProjectId])
}

model TestRunTestCase {
  id              String                @id @default(uuid())
  testRunId       String
  testCaseId      String
  testSuiteId     String?
  status          TestRunTestCaseStatus @default(PENDING)
  result          TestRunTestCaseResult @default(UNTESTED)
  tracePath       String?
  testRun         TestRun               @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase        TestCase              @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testSuite       TestSuite?            @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)
  reportTestCases ReportTestCase[]
}

model TestRun {
  id                              String                                  @id @default(uuid())
  name                            String
  preparationKey                  String?
  runId                           String                                  @unique @default(uuid())
  startedAt                       DateTime                                @default(now())
  completedAt                     DateTime?
  status                          TestRunStatus                           @default(QUEUED)
  result                          TestRunResult                           @default(PENDING)
  intent                          TestRunIntent                           @default(INDEPENDENT)
  evidenceHealth                  TestRunEvidenceHealth                   @default(invalid_missing_report)
  testCases                       TestRunTestCase[]
  updatedAt                       DateTime                                @updatedAt
  environment                     Environment                             @relation(fields: [environmentId], references: [id])
  environmentId                   String
  tags                            Tag[]
  testWorkersCount                Int?                                    @default(1)
  browserEngine                   BrowserEngine                           @default(CHROMIUM)
  logs                            TestRunLog?
  logPath                         String?
  reportPath                      String?
  environmentSnapshotHash         String?
  environmentSnapshotJson         String?
  /// The explicit Environment scope token captured with a remote snapshot.
  /// Timestamps are not a safe optimistic-concurrency token on every SQLite
  /// platform, so remote lifecycle boundaries compare this integer as well.
  environmentSnapshotVersion      Int?
  reports                         Report[]
  targetProjectId                 String
  targetProject                   TargetProject                           @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  runtimeCapsule                  RuntimeCapsule?
  runtimeCapsuleExecutionAttempt  RuntimeCapsuleExecutionAttempt?
  qualityJourneyExecutionBinding  QualityJourneyExecutionTestRun?
  qualityJourneyExecutionEvidence QualityJourneyExecutionEvidenceReceipt?

  @@unique([targetProjectId, preparationKey])
  @@index([completedAt])
  @@index([result])
  @@index([evidenceHealth])
  @@index([targetProjectId])
  @@index([targetProjectId, startedAt, id])
}

model TargetProject {
  id                                     String                                  @id @default(uuid())
  kind                                   TargetProjectKind
  canonicalIdentity                      String                                  @unique
  canonicalPath                          String?
  normalizedRemoteOrigin                 String?
  displayName                            String
  description                            String?
  packageName                            String?
  packageManager                         String?
  packageJson                            String?
  fingerprint                            String                                  @unique
  createdAt                              DateTime                                @default(now())
  updatedAt                              DateTime                                @updatedAt
  lastDetectedAt                         DateTime                                @default(now())
  testRuns                               TestRun[]
  runtimeCapsules                        RuntimeCapsule[]
  runtimeCapsuleBlobs                    RuntimeCapsuleBlob[]
  runtimeCapsuleLeases                   RuntimeCapsuleLease[]
  resourceOwnerships                     ProjectResourceOwnership[]
  resourceImports                        ProjectResourceImport[]                 @relation("ResourceImportDestination")
  testSuites                             TestSuite[]
  testCases                              TestCase[]
  templateTestCases                      TemplateTestCase[]
  locators                               Locator[]
  locatorGroups                          LocatorGroup[]
  modules                                Module[]
  environments                           Environment[]
  tags                                   Tag[]
  reports                                Report[]
  testCaseMetrics                        TestCaseMetrics[]
  testSuiteMetrics                       TestSuiteMetrics[]
  dashboardMetrics                       DashboardMetrics?
  agentPreflightReceipts                 AgentPreflightReceipt[]
  qualityJourneys                        QualityJourney[]
  qualityJourneyAutomationTargetBindings QualityJourneyAutomationTargetBinding[]
  qualityJourneyExecutionCycles          QualityJourneyExecutionCycle[]
  qualityJourneyCoordinatorHandoffs      QualityJourneyCoordinatorHandoff[]

  @@index([displayName])
  @@index([canonicalPath])
  @@index([normalizedRemoteOrigin])
  @@index([fingerprint])
}

model QualityJourney {
  closure                           QualityJourneyClosure?
  activeTriageReportId              String?                                      @unique
  activeTriageReport                QualityJourneyTriageReport?                  @relation("ActiveTriageReport", fields: [activeTriageReportId], references: [id], onDelete: Restrict)
  triageAssignments                 QualityJourneyTriageAssignment[]
  triageReports                     QualityJourneyTriageReport[]
  reportReviews                     QualityJourneyReportReview[]
  id                                String                                       @id
  targetProjectId                   String
  rootIdempotencyKey                String
  rootRequestHash                   String
  stage                             QualityJourneyStage                          @default(INTAKE)
  status                            String                                       @default("ACTIVE")
  activeCycleId                     String
  activeRevisionIdsJson             String                                       @default("{}")
  analysisReviewHash                String?
  unresolvedQuestionIdsJson         String                                       @default("[]")
  blockerIdsJson                    String                                       @default("[]")
  activeWorkItemIdsJson             String                                       @default("[]")
  stateHash                         String
  version                           Int                                          @default(0)
  createdAt                         DateTime                                     @default(now())
  updatedAt                         DateTime                                     @updatedAt
  targetProject                     TargetProject                                @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  revisions                         QualityJourneyRevision[]
  cycles                            QualityJourneyCycle[]
  commands                          QualityJourneyCommand[]
  events                            QualityJourneyEvent[]
  workItems                         QualityJourneyWorkItem[]
  blockers                          QualityJourneyBlocker[]
  artifactLinks                     QualityJourneyArtifactLink[]
  artifacts                         QualityJourneyArtifact[]
  analysisRevisions                 QualityJourneyAnalysisRevision[]
  analysisQuestions                 QualityJourneyAnalysisQuestion[]
  analysisAnswers                   QualityJourneyAnalysisAnswer[]
  analysisPublications              QualityJourneyAnalysisPublication[]
  analysisDecisions                 QualityJourneyAnalysisDecision[]
  workAuthorizations                QualityJourneyWorkAuthorization[]
  discoveryRevisions                QualityJourneyDiscoveryRevision[]            @relation("JourneyDiscoveryRevisions")
  activeDiscoveryRevisionId         String?                                      @unique
  activeDiscoveryRevision           QualityJourneyDiscoveryRevision?             @relation("ActiveQualityJourneyDiscoveryRevision", fields: [activeDiscoveryRevisionId], references: [id], onDelete: Restrict)
  scenarioPortfolioRevisions        QualityJourneyScenarioPortfolioRevision[]    @relation("JourneyScenarioPortfolioRevisions")
  scenarioDecisionReceipts          QualityJourneyScenarioDecisionReceipt[]
  activeScenarioPortfolioRevisionId String?                                      @unique
  activeScenarioPortfolioRevision   QualityJourneyScenarioPortfolioRevision?     @relation("ActiveQualityJourneyScenarioPortfolioRevision", fields: [activeScenarioPortfolioRevisionId], references: [id], onDelete: Restrict)
  automationMaterializations        QualityJourneyAutomationMaterialization[]
  automationRequestReceipts         QualityJourneyAutomationRequestReceipt[]
  preparedRuntimeCapsules           QualityJourneyPreparedRuntimeCapsule[]
  automationTargetBindings          QualityJourneyAutomationTargetBinding[]
  executionCycles                   QualityJourneyExecutionCycle[]
  executionConsents                 QualityJourneyExecutionConsent[]
  executionCancellationReceipts     QualityJourneyExecutionCancellationReceipt[]
  executionRerunProposals           QualityJourneyExecutionRerunProposal[]
  coordinatorHandoffs               QualityJourneyCoordinatorHandoff[]

  @@unique([targetProjectId, rootIdempotencyKey])
  @@index([targetProjectId, status])
  @@index([targetProjectId, stage])
}

model QualityJourneyCoordinatorHandoff {
  id              String         @id
  journeyId       String
  targetProjectId String
  providerId      String
  status          String         @default("PREPARED")
  ticketHash      String         @unique
  promptHash      String
  expiresAt       DateTime
  launchedAt      DateTime?
  connectedAt     DateTime?
  failedAt        DateTime?
  failureCode     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  journey         QualityJourney @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  targetProject   TargetProject  @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)

  @@index([journeyId, createdAt])
  @@index([targetProjectId, status])
  @@index([expiresAt])
}

model QualityJourneyArtifact {
  id                         String                                    @id
  identityKey                String
  journeyId                  String
  targetProjectId            String
  cycleId                    String
  kind                       String
  artifactId                 String
  revisionId                 String?
  contentHash                String
  artifactJson               String
  createdAt                  DateTime                                  @default(now())
  journey                    QualityJourney                            @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  analysisRevision           QualityJourneyAnalysisRevision?
  analysisQuestion           QualityJourneyAnalysisQuestion?
  analysisAnswer             QualityJourneyAnalysisAnswer?
  analysisDecision           QualityJourneyAnalysisDecision?
  scenarioPortfolioRevision  QualityJourneyScenarioPortfolioRevision?
  automationMaterializations QualityJourneyAutomationMaterialization[]

  @@unique([journeyId, identityKey])
  @@index([targetProjectId, kind])
  @@index([journeyId, artifactId])
}

/// Phase 3 control records point at immutable QualityJourneyArtifact payloads.
/// Publication and approval are separate immutable facts, so reviewed charter
/// content is never updated in place.
model QualityJourneyAnalysisRevision {
  id                       String                             @id
  journeyId                String
  targetProjectId          String
  cycleId                  String
  artifactRecordId         String                             @unique
  artifactId               String
  artifactRevisionId       String
  revision                 Int
  contentHash              String
  predecessorRevisionId    String?                            @unique
  submissionIdempotencyKey String
  submissionHash           String
  submittedWorkItemId      String
  submittedAttemptId       String
  inputHash                String
  createdAt                DateTime                           @default(now())
  journey                  QualityJourney                     @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  artifact                 QualityJourneyArtifact             @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  submittedWorkItem        QualityJourneyWorkItem             @relation("QualityJourneyAnalysisSubmittedWorkItem", fields: [submittedWorkItemId], references: [id], onDelete: Restrict)
  submittedAttempt         QualityJourneyWorkAttempt          @relation("QualityJourneyAnalysisSubmittedAttempt", fields: [submittedAttemptId], references: [id], onDelete: Restrict)
  predecessor              QualityJourneyAnalysisRevision?    @relation("QualityJourneyAnalysisPredecessor", fields: [predecessorRevisionId], references: [id], onDelete: Restrict)
  successors               QualityJourneyAnalysisRevision[]   @relation("QualityJourneyAnalysisPredecessor")
  questions                QualityJourneyAnalysisQuestion[]
  publication              QualityJourneyAnalysisPublication?
  decision                 QualityJourneyAnalysisDecision?
  discoveryRevisions       QualityJourneyDiscoveryRevision[]

  @@unique([journeyId, artifactRevisionId])
  @@unique([journeyId, revision])
  @@unique([journeyId, submissionIdempotencyKey])
  @@index([journeyId, createdAt])
  @@index([targetProjectId, cycleId])
}

model QualityJourneyAnalysisQuestion {
  id                 String                         @id
  journeyId          String
  analysisRevisionId String
  artifactRecordId   String                         @unique
  questionId         String
  contentHash        String
  required           Boolean
  createdAt          DateTime                       @default(now())
  journey            QualityJourney                 @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  analysisRevision   QualityJourneyAnalysisRevision @relation(fields: [analysisRevisionId], references: [id], onDelete: Restrict)
  artifact           QualityJourneyArtifact         @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  answers            QualityJourneyAnalysisAnswer[]

  @@unique([analysisRevisionId, questionId])
  @@index([journeyId, required])
}

model QualityJourneyAnalysisAnswer {
  id                   String                         @id
  journeyId            String
  questionRecordId     String
  artifactRecordId     String                         @unique
  answerId             String
  contentHash          String
  actor                String
  correctionOfAnswerId String?
  idempotencyKey       String
  requestHash          String
  createdAt            DateTime                       @default(now())
  journey              QualityJourney                 @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  question             QualityJourneyAnalysisQuestion @relation(fields: [questionRecordId], references: [id], onDelete: Restrict)
  artifact             QualityJourneyArtifact         @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  correctionOf         QualityJourneyAnalysisAnswer?  @relation("QualityJourneyAnalysisAnswerCorrection", fields: [correctionOfAnswerId], references: [id], onDelete: Restrict)
  correction           QualityJourneyAnalysisAnswer?  @relation("QualityJourneyAnalysisAnswerCorrection")

  @@unique([journeyId, answerId])
  @@unique([journeyId, idempotencyKey])
  @@unique([correctionOfAnswerId])
  @@index([questionRecordId, createdAt])
}

model QualityJourneyAnalysisPublication {
  id                 String                         @id
  journeyId          String
  analysisRevisionId String                         @unique
  commandId          String                         @unique
  artifactHash       String
  reviewHash         String
  publishedAt        DateTime                       @default(now())
  journey            QualityJourney                 @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  analysisRevision   QualityJourneyAnalysisRevision @relation(fields: [analysisRevisionId], references: [id], onDelete: Restrict)

  @@index([journeyId, publishedAt])
}

model QualityJourneyAnalysisDecision {
  id                 String                            @id
  journeyId          String
  analysisRevisionId String                            @unique
  artifactRecordId   String                            @unique
  commandId          String                            @unique
  contentHash        String
  reviewHash         String
  decision           String
  actor              String
  createdAt          DateTime                          @default(now())
  journey            QualityJourney                    @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  analysisRevision   QualityJourneyAnalysisRevision    @relation(fields: [analysisRevisionId], references: [id], onDelete: Restrict)
  artifact           QualityJourneyArtifact            @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  discoveryRevisions QualityJourneyDiscoveryRevision[] @relation("QualityJourneyAnalysisDecisionDiscoveryRevisions")

  @@index([journeyId, createdAt])
}

/// Phase 4 freezes the exact discovery authority derived from one approved
/// Analysis revision.  Payloads remain immutable JSON so workers can be
/// replayed without consulting a later catalog; relational fields are the
/// authority for lineage, work-item ownership, and active-revision selection.
model QualityJourneyDiscoveryRevision {
  id                               String                                    @id
  journeyId                        String
  targetProjectId                  String
  cycleId                          String
  analysisRevisionId               String
  analysisDecisionId               String
  analysisArtifactId               String
  analysisRevisionArtifactId       String
  analysisRevisionContentHash      String
  analysisApprovalArtifactId       String
  analysisApprovalContentHash      String
  approvedRequirementSetHash       String
  environmentRegistryHash          String
  locatorRegistryHash              String
  resourceRegistryHash             String
  stepDefinitionRegistryHash       String
  operationRegistryHash            String
  scoutScopeJson                   String
  scoutInputHash                   String
  resourceScopeJson                String
  resourceInputHash                String
  scopeHash                        String
  scoutWorkItemId                  String                                    @unique
  resourceWorkItemId               String                                    @unique
  targetObservationJson            String?
  targetObservationHash            String?
  targetObservationIdempotencyKey  String?
  targetObservationSubmittedAt     DateTime?
  resourceResolutionJson           String?
  resourceResolutionHash           String?
  resourceResolutionIdempotencyKey String?
  resourceResolutionSubmittedAt    DateTime?
  status                           String                                    @default("COLLECTING")
  predecessorRevisionId            String?                                   @unique
  retryIdempotencyKey              String?
  retryRequestHash                 String?
  rowVersion                       Int                                       @default(0)
  completionHash                   String?
  createdAt                        DateTime                                  @default(now())
  completedAt                      DateTime?
  invalidatedAt                    DateTime?
  supersededAt                     DateTime?
  journey                          QualityJourney                            @relation("JourneyDiscoveryRevisions", fields: [journeyId], references: [id], onDelete: Restrict)
  activeForJourney                 QualityJourney?                           @relation("ActiveQualityJourneyDiscoveryRevision")
  analysisRevision                 QualityJourneyAnalysisRevision            @relation(fields: [analysisRevisionId], references: [id], onDelete: Restrict)
  analysisDecision                 QualityJourneyAnalysisDecision            @relation("QualityJourneyAnalysisDecisionDiscoveryRevisions", fields: [analysisDecisionId], references: [id], onDelete: Restrict)
  scoutWorkItem                    QualityJourneyWorkItem                    @relation("DiscoveryScoutWorkItem", fields: [scoutWorkItemId], references: [id], onDelete: Restrict)
  resourceWorkItem                 QualityJourneyWorkItem                    @relation("DiscoveryResourceWorkItem", fields: [resourceWorkItemId], references: [id], onDelete: Restrict)
  predecessor                      QualityJourneyDiscoveryRevision?          @relation("DiscoveryRevisionPredecessor", fields: [predecessorRevisionId], references: [id], onDelete: Restrict)
  successor                        QualityJourneyDiscoveryRevision?          @relation("DiscoveryRevisionPredecessor")
  scenarioPortfolioRevisions       QualityJourneyScenarioPortfolioRevision[] @relation("ScenarioPortfolioDiscoveryRevision")

  @@unique([journeyId, targetObservationIdempotencyKey])
  @@unique([journeyId, resourceResolutionIdempotencyKey])
  @@unique([journeyId, retryIdempotencyKey])
  @@index([journeyId, status])
  @@index([targetProjectId, createdAt])
  @@index([analysisRevisionId])
}

/// Phase 5 stores reviewed behavioral intent independently from implementation
/// enrichment and graph layout.  A layout or feasibility refresh therefore
/// cannot alter approved scenario semantics.
model QualityJourneyScenarioPortfolioRevision {
  id                                     String                                    @id
  journeyId                              String
  targetProjectId                        String
  cycleId                                String
  discoveryRevisionId                    String
  discoveryCompletionHash                String
  predecessorPortfolioRevisionId         String?                                   @unique
  artifactRecordId                       String                                    @unique
  artifactId                             String
  artifactRevisionId                     String
  revision                               Int
  contentHash                            String
  behavioralIntentHash                   String
  enrichmentHash                         String
  layoutHash                             String
  coverageRationale                      String
  graphJson                              String
  submissionIdempotencyKey               String
  submissionHash                         String
  submittedWorkItemId                    String
  submittedAttemptId                     String
  status                                 String                                    @default("PUBLISHED")
  reviewHash                             String?
  approvedIntentHash                     String?
  approvedCoverageHash                   String?
  decisionSetHash                        String?
  createdAt                              DateTime                                  @default(now())
  reviewedAt                             DateTime?
  supersededAt                           DateTime?
  journey                                QualityJourney                            @relation("JourneyScenarioPortfolioRevisions", fields: [journeyId], references: [id], onDelete: Restrict)
  discoveryRevision                      QualityJourneyDiscoveryRevision           @relation("ScenarioPortfolioDiscoveryRevision", fields: [discoveryRevisionId], references: [id], onDelete: Restrict)
  artifact                               QualityJourneyArtifact                    @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  submittedWorkItem                      QualityJourneyWorkItem                    @relation("QualityJourneyScenarioSubmittedWorkItem", fields: [submittedWorkItemId], references: [id], onDelete: Restrict)
  submittedAttempt                       QualityJourneyWorkAttempt                 @relation("QualityJourneyScenarioSubmittedAttempt", fields: [submittedAttemptId], references: [id], onDelete: Restrict)
  activeForJourney                       QualityJourney?                           @relation("ActiveQualityJourneyScenarioPortfolioRevision")
  predecessorPortfolioRevision           QualityJourneyScenarioPortfolioRevision?  @relation("ScenarioPortfolioSuccessor", fields: [predecessorPortfolioRevisionId], references: [id], onDelete: Restrict)
  successorPortfolioRevision             QualityJourneyScenarioPortfolioRevision?  @relation("ScenarioPortfolioSuccessor")
  scenarios                              QualityJourneyScenarioRevision[]
  decisions                              QualityJourneyScenarioDecision[]
  comments                               QualityJourneyScenarioReviewComment[]
  qualityJourneyScenarioDecisionReceipts QualityJourneyScenarioDecisionReceipt[]
  automationMaterializations             QualityJourneyAutomationMaterialization[]

  @@unique([journeyId, artifactRevisionId])
  @@unique([journeyId, revision])
  @@unique([journeyId, submissionIdempotencyKey])
  @@index([journeyId, status])
  @@index([targetProjectId, createdAt])
  @@index([discoveryRevisionId])
}

model QualityJourneyScenarioRevision {
  id                         String                                    @id
  portfolioRevisionId        String
  stableScenarioId           String
  scenarioRevisionId         String
  behavioralIntentJson       String
  behavioralIntentHash       String
  enrichmentJson             String
  enrichmentHash             String
  layoutJson                 String
  layoutHash                 String
  contentHash                String
  createdAt                  DateTime                                  @default(now())
  portfolioRevision          QualityJourneyScenarioPortfolioRevision   @relation(fields: [portfolioRevisionId], references: [id], onDelete: Restrict)
  decisions                  QualityJourneyScenarioDecision[]
  comments                   QualityJourneyScenarioReviewComment[]
  automationMaterializations QualityJourneyAutomationMaterialization[]

  @@unique([portfolioRevisionId, scenarioRevisionId])
  @@unique([portfolioRevisionId, stableScenarioId])
  @@unique([scenarioRevisionId])
  @@index([stableScenarioId])
}

/// Phase 6 is deliberately preparation-only.  This immutable record is not a
/// RuntimeCapsule: RuntimeCapsule remains test-run bound and is owned by the
/// managed execution phase.
model QualityJourneyPreparedRuntimeCapsule {
  id                String                                  @id
  journeyId         String
  targetProjectId   String
  cycleId           String
  materializationId String                                  @unique
  inputHash         String
  capsuleHash       String
  manifestJson      String
  manifestHash      String
  status            String                                  @default("PREPARED")
  createdAt         DateTime                                @default(now())
  journey           QualityJourney                          @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  materialization   QualityJourneyAutomationMaterialization @relation(fields: [materializationId], references: [id], onDelete: Restrict)

  @@unique([journeyId, materializationId])
  @@index([targetProjectId, cycleId])
}

/// Durable, input-bound Automator receipt.  It records the exact approved
/// scenario decision and the target-owned artifacts it materialized.  No
/// TestRun or RuntimeCapsule foreign key is present by design.
model QualityJourneyAutomationMaterialization {
  id                        String                                           @id
  journeyId                 String
  targetProjectId           String
  cycleId                   String
  scenarioRevisionId        String
  scenarioContentHash       String
  portfolioRevisionId       String
  portfolioContentHash      String
  decisionId                String
  decisionHash              String
  workItemId                String
  attemptId                 String
  leaseId                   String
  ownerTokenHash            String
  inputHash                 String
  idempotencyKey            String
  requestHash               String
  materializationHash       String
  status                    String                                           @default("MATERIALIZED")
  failureKind               String?
  failureJson               String?
  suiteId                   String?
  testCaseId                String?
  artifactRecordId          String                                           @unique
  portfolioRecordId         String
  artifactJson              String
  createdAt                 DateTime                                         @default(now())
  journey                   QualityJourney                                   @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  scenarioRevision          QualityJourneyScenarioRevision                   @relation(fields: [scenarioRevisionId], references: [scenarioRevisionId], onDelete: Restrict)
  artifact                  QualityJourneyArtifact                           @relation(fields: [artifactRecordId], references: [id], onDelete: Restrict)
  portfolioRevision         QualityJourneyScenarioPortfolioRevision          @relation(fields: [portfolioRecordId], references: [id], onDelete: Restrict)
  decision                  QualityJourneyScenarioDecision                   @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  workItem                  QualityJourneyWorkItem                           @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  attempt                   QualityJourneyWorkAttempt                        @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  preparedCapsule           QualityJourneyPreparedRuntimeCapsule?
  targetBindingAssociations QualityJourneyAutomationMaterializationBinding[]

  @@unique([journeyId, idempotencyKey])
  // A classified failure is durable per input-bound request. A fresh Factory
  // idempotency key may record a distinct diagnosis or repair the input.
  @@unique([journeyId, scenarioRevisionId, inputHash, status, failureKind, idempotencyKey])
  @@index([workItemId, attemptId])
  @@index([targetProjectId, cycleId])
}

/// A target-owned semantic reservation for an Automator materialization. The
/// hashes cover the complete suite, case, and ordered step packet so an
/// independently authored matching case may be reused without a name-only
/// match. The row is insert-only evidence, not a mutable cache.
model QualityJourneyAutomationTargetBinding {
  id                          String                                           @id
  journeyId                   String
  targetProjectId             String
  semanticHash                String
  suiteId                     String
  testCaseId                  String
  suiteHash                   String
  testCaseHash                String
  stepHash                    String
  bindingJson                 String
  resourceHashJson            String
  createdAt                   DateTime                                         @default(now())
  journey                     QualityJourney                                   @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  targetProject               TargetProject                                    @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  materializationAssociations QualityJourneyAutomationMaterializationBinding[]

  @@unique([targetProjectId, semanticHash])
  @@index([journeyId, targetProjectId])
}

/// Immutable association: one canonical target binding may prove semantic
/// reuse for many Automator receipts without weakening either receipt.
model QualityJourneyAutomationMaterializationBinding {
  materializationId String                                  @id
  bindingId         String
  createdAt         DateTime                                @default(now())
  materialization   QualityJourneyAutomationMaterialization @relation(fields: [materializationId], references: [id], onDelete: Restrict)
  targetBinding     QualityJourneyAutomationTargetBinding   @relation(fields: [bindingId], references: [id], onDelete: Restrict)

  @@index([bindingId])
}

/// Terminal, request-level Automator diagnosis. It prevents a mixed batch
/// rollback from inventing a per-scenario materialization failure.
model QualityJourneyAutomationRequestReceipt {
  id             String                    @id
  journeyId      String
  workItemId     String
  attemptId      String
  ownerTokenHash String
  idempotencyKey String
  requestHash    String
  status         String
  resultJson     String
  createdAt      DateTime                  @default(now())
  journey        QualityJourney            @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  workItem       QualityJourneyWorkItem    @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  attempt        QualityJourneyWorkAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([journeyId, idempotencyKey])
  @@index([attemptId])
}

model QualityJourneyScenarioDecision {
  id                         String                                    @id
  portfolioRevisionId        String
  scenarioRevisionId         String
  decision                   String
  feedback                   String?
  actor                      String
  idempotencyKey             String
  requestHash                String
  contentHash                String
  carriedFromDecisionId      String?
  createdAt                  DateTime                                  @default(now())
  portfolioRevision          QualityJourneyScenarioPortfolioRevision   @relation(fields: [portfolioRevisionId], references: [id], onDelete: Restrict)
  scenarioRevision           QualityJourneyScenarioRevision            @relation(fields: [scenarioRevisionId], references: [scenarioRevisionId], onDelete: Restrict)
  carriedFromDecision        QualityJourneyScenarioDecision?           @relation("ScenarioDecisionCarryForward", fields: [carriedFromDecisionId], references: [id], onDelete: Restrict)
  carriedDecisions           QualityJourneyScenarioDecision[]          @relation("ScenarioDecisionCarryForward")
  automationMaterializations QualityJourneyAutomationMaterialization[]

  @@unique([portfolioRevisionId, scenarioRevisionId])
  @@unique([portfolioRevisionId, idempotencyKey])
  @@index([portfolioRevisionId, decision])
}

model QualityJourneyScenarioReviewComment {
  id                        String                                  @id
  portfolioRevisionId       String
  scenarioRevisionId        String?
  comment                   String
  blocking                  Boolean                                 @default(false)
  disposition               String                                  @default("OPEN")
  disposedAt                DateTime?
  disposedBy                String?
  dispositionIdempotencyKey String?
  dispositionRequestHash    String?
  createResponseJson        String?
  dispositionResponseJson   String?
  actor                     String
  idempotencyKey            String
  requestHash               String
  createdAt                 DateTime                                @default(now())
  portfolioRevision         QualityJourneyScenarioPortfolioRevision @relation(fields: [portfolioRevisionId], references: [id], onDelete: Restrict)
  scenarioRevision          QualityJourneyScenarioRevision?         @relation(fields: [scenarioRevisionId], references: [scenarioRevisionId], onDelete: Restrict)

  @@unique([portfolioRevisionId, idempotencyKey])
  @@unique([portfolioRevisionId, dispositionIdempotencyKey])
  @@index([portfolioRevisionId, scenarioRevisionId])
}

model QualityJourneyScenarioDecisionReceipt {
  id                  String                                  @id
  journeyId           String
  portfolioRevisionId String
  idempotencyKey      String
  requestHash         String
  resultJson          String
  createdAt           DateTime                                @default(now())
  journey             QualityJourney                          @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  portfolioRevision   QualityJourneyScenarioPortfolioRevision @relation(fields: [portfolioRevisionId], references: [id], onDelete: Restrict)

  @@unique([journeyId, idempotencyKey])
  @@index([portfolioRevisionId, createdAt])
}

model QualityJourneyRevision {
  id          String         @id
  journeyId   String
  revision    Int
  contentJson String
  contentHash String
  createdAt   DateTime       @default(now())
  journey     QualityJourney @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@unique([journeyId, revision])
  @@index([journeyId, createdAt])
}

model QualityJourneyCycle {
  remediationReview  QualityJourneyReportReview?
  id                 String                      @id
  journeyId          String
  sequence           Int
  predecessorCycleId String?
  scopeJson          String                      @default("{}")
  createdAt          DateTime                    @default(now())
  journey            QualityJourney              @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@unique([journeyId, sequence])
}

/// Phase 7's durable execution reservation. Frozen Phase 6 capsule and
/// target-binding hashes are captured before any TestRun or process side
/// effect. Status is operational state; the frozen binding fields never
/// change after insertion.
model QualityJourneyExecutionCycle {
  triageAssignments           QualityJourneyTriageAssignment[]
  id                          String                                       @id
  journeyId                   String
  targetProjectId             String
  cycleId                     String
  predecessorExecutionCycleId String?
  preparedCapsulesJson        String
  preparedCapsulesHash        String
  environmentId               String
  environmentSnapshotJson     String
  environmentSnapshotHash     String
  environmentSnapshotVersion  Int
  targetFingerprint           String
  browserEngine               BrowserEngine                                @default(CHROMIUM)
  stateHash                   String
  idempotencyKey              String
  requestHash                 String
  status                      String                                       @default("RESERVED")
  cancellationReason          String?
  startedAt                   DateTime                                     @default(now())
  completedAt                 DateTime?
  journey                     QualityJourney                               @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  targetProject               TargetProject                                @relation(fields: [targetProjectId], references: [id], onDelete: Restrict)
  testRuns                    QualityJourneyExecutionTestRun[]
  evidenceReceipts            QualityJourneyExecutionEvidenceReceipt[]
  consents                    QualityJourneyExecutionConsent[]
  cancellationReceipts        QualityJourneyExecutionCancellationReceipt[]
  rerunProposals              QualityJourneyExecutionRerunProposal[]       @relation("QualityJourneyRerunSource")
  successorRerunProposals     QualityJourneyExecutionRerunProposal[]       @relation("QualityJourneyRerunSuccessor")

  @@unique([journeyId, idempotencyKey])
  @@index([journeyId, cycleId, status])
  @@index([targetProjectId, status])
}

model QualityJourneyExecutionTestRun {
  id                String                       @id
  executionCycleId  String
  preparedCapsuleId String
  testRunId         String                       @unique
  runId             String
  status            String                       @default("RESERVED")
  createdAt         DateTime                     @default(now())
  executionCycle    QualityJourneyExecutionCycle @relation(fields: [executionCycleId], references: [id], onDelete: Restrict)
  testRun           TestRun                      @relation(fields: [testRunId], references: [id], onDelete: Restrict)

  @@unique([executionCycleId, preparedCapsuleId])
  @@index([preparedCapsuleId])
}

/// A UI-only grant for one exact Phase 7 checkpoint/resource/action scope.
/// Its grantSource is persisted so an MCP caller cannot manufacture consent
/// by claiming to be a user in an actor string.
model QualityJourneyExecutionConsent {
  id               String                        @id
  journeyId        String
  targetProjectId  String
  executionCycleId String?
  scopeJson        String
  scopeHash        String
  grantSource      String
  status           String                        @default("REQUESTED")
  reason           String?
  grantedAt        DateTime?
  expiresAt        DateTime?
  usedAt           DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                      @default(now())
  journey          QualityJourney                @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  executionCycle   QualityJourneyExecutionCycle? @relation(fields: [executionCycleId], references: [id], onDelete: Restrict)

  @@index([journeyId, scopeHash, status])
  @@index([targetProjectId, status])
}

/// Request-level cancellation identity prevents a replay key from selecting
/// additional TestRuns after the original cancellation has reached runtime.
model QualityJourneyExecutionCancellationReceipt {
  id               String                       @id
  journeyId        String
  executionCycleId String
  idempotencyKey   String
  requestHash      String
  createdAt        DateTime                     @default(now())
  journey          QualityJourney               @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  executionCycle   QualityJourneyExecutionCycle @relation(fields: [executionCycleId], references: [id], onDelete: Restrict)

  @@unique([journeyId, idempotencyKey])
  @@index([executionCycleId, createdAt])
}

/// Terminal runtime evidence. The sealed bytes hash and complete frozen
/// execution-cycle identity make this receipt append-only evidence rather
/// than a generic report or triage artifact.
model QualityJourneyExecutionEvidenceReceipt {
  id               String                       @id
  executionCycleId String
  testRunId        String                       @unique
  runtimeBytesHash String
  receiptHash      String                       @unique
  evidenceJson     String
  createdAt        DateTime                     @default(now())
  executionCycle   QualityJourneyExecutionCycle @relation(fields: [executionCycleId], references: [id], onDelete: Restrict)
  testRun          TestRun                      @relation(fields: [testRunId], references: [id], onDelete: Restrict)

  @@index([executionCycleId, createdAt])
}

/// Immutable, user-approved rerun scope. It names only exact predecessor
/// evidence and scenario revisions; a fresh execution cycle is created only
/// after persisted UI approval.
model QualityJourneyExecutionRerunProposal {
  reportRevisionId          String?
  reportHash                String?
  id                        String                        @id
  journeyId                 String
  targetProjectId           String
  sourceExecutionCycleId    String
  successorExecutionCycleId String?                       @unique
  sourceEvidenceJson        String
  selectedScenariosJson     String
  reason                    String
  proposalHash              String                        @unique
  idempotencyKey            String
  requestHash               String
  status                    String                        @default("PROPOSED")
  approvedAt                DateTime?
  createdAt                 DateTime                      @default(now())
  journey                   QualityJourney                @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  sourceExecutionCycle      QualityJourneyExecutionCycle  @relation("QualityJourneyRerunSource", fields: [sourceExecutionCycleId], references: [id], onDelete: Restrict)
  successorExecutionCycle   QualityJourneyExecutionCycle? @relation("QualityJourneyRerunSuccessor", fields: [successorExecutionCycleId], references: [id], onDelete: Restrict)

  @@unique([journeyId, idempotencyKey])
  @@index([targetProjectId, status])
}

model QualityJourneyCommand {
  id              String         @id
  journeyId       String
  targetProjectId String
  idempotencyKey  String
  requestHash     String
  requestJson     String
  resultJson      String
  eventId         String?
  createdAt       DateTime       @default(now())
  journey         QualityJourney @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@unique([journeyId, idempotencyKey])
  @@unique([journeyId, id])
  @@index([targetProjectId, createdAt])
}

model QualityJourneyEvent {
  id                   String         @id
  journeyId            String
  targetProjectId      String
  sequence             Int
  eventType            String
  commandId            String?
  predecessorStateHash String
  successorStateHash   String
  payloadJson          String
  createdAt            DateTime       @default(now())
  journey              QualityJourney @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@unique([journeyId, sequence])
  @@index([targetProjectId, createdAt])
}

model QualityJourneyWorkItem {
  triageAssignment           QualityJourneyTriageAssignment?
  id                         String                                    @id
  journeyId                  String
  targetProjectId            String
  cycleId                    String
  role                       QualityJourneyRole
  status                     QualityJourneyWorkItemStatus              @default(ELIGIBLE)
  inputHash                  String
  roleContractDigest         String
  inputArtifactRefsJson      String                                    @default("[]")
  allowedOutputsJson         String                                    @default("[]")
  completionCriteriaJson     String                                    @default("[]")
  authorizationScopeJson     String                                    @default("{}")
  currentAttempt             Int                                       @default(0)
  version                    Int                                       @default(0)
  createdAt                  DateTime                                  @default(now())
  updatedAt                  DateTime                                  @updatedAt
  journey                    QualityJourney                            @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  authorizations             QualityJourneyWorkAuthorization[]
  attempts                   QualityJourneyWorkAttempt[]
  analysisSubmissions        QualityJourneyAnalysisRevision[]          @relation("QualityJourneyAnalysisSubmittedWorkItem")
  scenarioSubmissions        QualityJourneyScenarioPortfolioRevision[] @relation("QualityJourneyScenarioSubmittedWorkItem")
  automationMaterializations QualityJourneyAutomationMaterialization[]
  scoutDiscoveryRevision     QualityJourneyDiscoveryRevision?          @relation("DiscoveryScoutWorkItem")
  resourceDiscoveryRevision  QualityJourneyDiscoveryRevision?          @relation("DiscoveryResourceWorkItem")
  automationRequestReceipts  QualityJourneyAutomationRequestReceipt[]

  @@index([journeyId, status])
  @@index([journeyId, role, cycleId])
  @@index([targetProjectId, status])
}

model QualityJourneyWorkAuthorization {
  id                        String                           @id
  journeyId                 String
  targetProjectId           String
  workItemId                String
  supersedesAuthorizationId String?                          @unique
  role                      QualityJourneyRole
  roleContractDigest        String
  capabilityProfileId       String
  capabilityProfileHash     String
  authorizationJson         String
  authorizationHash         String
  /// Factory claims consume this hard ceiling atomically. It is deliberately
  /// not a provider/token/cost budget.
  maxAttempts               Int                              @default(3)
  cancelledAt               DateTime?
  cancelledBy               String?
  cancellationReason        String?
  revokedAt                 DateTime?
  revokedBy                 String?
  revocationReason          String?
  createdAt                 DateTime                         @default(now())
  journey                   QualityJourney                   @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  workItem                  QualityJourneyWorkItem           @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  supersedesAuthorization   QualityJourneyWorkAuthorization? @relation("QualityJourneyWorkAuthorizationSupersession", fields: [supersedesAuthorizationId], references: [id], onDelete: Restrict)
  successorAuthorization    QualityJourneyWorkAuthorization? @relation("QualityJourneyWorkAuthorizationSupersession")
  attempts                  QualityJourneyWorkAttempt[]

  @@index([targetProjectId, role])
  @@index([journeyId, workItemId])
  @@index([workItemId, createdAt])
  @@index([revokedAt])
}

model QualityJourneyWorkAttempt {
  id                         String                                    @id
  workItemId                 String
  attempt                    Int
  status                     String                                    @default("CLAIMED")
  leaseId                    String                                    @unique
  ownerTokenHash             String
  leaseExpiresAt             DateTime
  heartbeatSeconds           Int
  authorizationId            String?
  assignmentId               String?
  assignmentJson             String?
  assignmentHash             String?
  spawnRequestId             String?
  spawnRequestJson           String?
  spawnRequestHash           String?
  dispatchKey                String?                                   @unique
  dispatchAdapterId          String?
  dispatchReservedAt         DateTime?
  dispatchStartedAt          DateTime?
  spawnReceiptId             String?
  spawnReceiptJson           String?
  spawnReceiptHash           String?
  replacesAttemptId          String?
  replacementProjectionHash  String?
  predecessorDiagnosticsJson String?
  resultJson                 String?
  resultHash                 String?
  failureJson                String?
  cancelledAt                DateTime?
  cancelledBy                String?
  cancellationReason         String?
  startedAt                  DateTime                                  @default(now())
  completedAt                DateTime?
  workItem                   QualityJourneyWorkItem                    @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  authorization              QualityJourneyWorkAuthorization?          @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  replacesAttempt            QualityJourneyWorkAttempt?                @relation("QualityJourneyWorkAttemptReplacement", fields: [replacesAttemptId], references: [id], onDelete: Restrict)
  replacementAttempts        QualityJourneyWorkAttempt[]               @relation("QualityJourneyWorkAttemptReplacement")
  analysisSubmissions        QualityJourneyAnalysisRevision[]          @relation("QualityJourneyAnalysisSubmittedAttempt")
  scenarioSubmissions        QualityJourneyScenarioPortfolioRevision[] @relation("QualityJourneyScenarioSubmittedAttempt")
  automationMaterializations QualityJourneyAutomationMaterialization[]
  automationRequestReceipts  QualityJourneyAutomationRequestReceipt[]

  @@unique([workItemId, attempt])
  @@unique([assignmentId])
  @@unique([spawnRequestId])
  @@unique([spawnReceiptId])
  @@index([leaseExpiresAt, status])
  @@index([authorizationId, attempt])
  @@index([replacesAttemptId])
  @@index([dispatchReservedAt])
}

model QualityJourneyBlocker {
  id                  String         @id
  journeyId           String
  targetProjectId     String
  reasonCode          String
  summary             String
  evidenceJson        String         @default("[]")
  responsibleActor    String
  affectedNodeIdsJson String         @default("[]")
  requiredResolution  String
  safeResumeCommand   String
  status              String         @default("ACTIVE")
  resolutionJson      String?
  createdAt           DateTime       @default(now())
  resolvedAt          DateTime?
