{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/app/(base)/**/*.{ts,tsx}",
    "scripts/**/*.{ts,tsx,js,mjs,cjs}",
    "src/lib/action-contracts.ts",
    "src/lib/action-catalog/index.ts",
    "src/lib/catalog-contracts/index.ts",
    "src/lib/locator-graph/index.ts",
    "src/lib/validation-ast/index.ts"
  ],
  "ignorePatterns": [
    ".next/**",
    ".fallow/**",
    "automation/**",
    "docs/**",
    "packages/**",
    "public/**",
    "registry/**",
    "templates/**"
  ],
  "ignoreDependencies": [
    "@codemirror/lang-jinja",
    "@faker-js/faker",
    "@locator-picker-companion/launcher",
    "@locator-picker-companion/session-file",
    "@locator-picker-companion/types",
    "chai",
    "chai-as-promised",
    "dotenv"
  ],
  "duplicates": {
    "ignore": ["automation/**", "packages/**", "registry/**", "templates/**"]
  },
  "overrides": [
    {
      "files": [
        "src/actions/**",
        "src/app/(dashboard-components)/**",
        "src/app/api/**",
        "src/app/globals.css",
        "src/app/layout.tsx",
        "src/app/page.tsx",
        "src/assets/**",
        "src/components/**",
        "src/config/**",
        "src/constants/**",
        "src/hooks/**",
        "src/lib/**",
        "src/services/**",
        "src/types/**"
      ],
      "rules": {
        "unused-files": "warn",
        "unused-exports": "warn",
        "unused-types": "warn",
        "unused-dependencies": "warn"
      }
    }
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "unresolved-imports": "error"
  },
  "framework": [
    {
      "name": "appraise-m06-node-test",
      "detection": {
        "type": "fileExists",
        "pattern": "scripts/test-harness/m06/**/*.test.mjs"
      },
      "entryPoints": [
        "scripts/test-harness/m06/fixture-audit-records.test.mjs",
        "scripts/test-harness/m06/fixture-diagnostic-failures.test.mjs",
        "scripts/test-harness/m06/fixture-evidence-read.test.mjs",
        "scripts/test-harness/m06/fixture-terminal-codecs.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-activation-proof.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-complement-canonical.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-complement-observation.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-fixture-admission.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-fixture-ipc-fault.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-fixture-transport.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-ipc-fault-controller.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-legacy-proof.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-service-callbacks.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-service-retained-proof.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-service-syntax.test.mjs",
        "scripts/test-harness/m06/service-custody/custody-supervisor.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-case-protocols.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-client-binding.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-fault-proofs.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-guard.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-ipc-fault.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-launch.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-ledger-fixture.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-owner-evidence.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-passive-forwarding.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-projection.test.mjs",
        "scripts/test-harness/m06/source-custody/source-custody-terminal.test.mjs",
        "scripts/test-harness/m06/unique-json.test.mjs"
      ],
      "entryPointRole": "test"
    }
  ]
}
