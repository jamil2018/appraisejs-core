# AppraiseJS repository Git defaults (LF). Applied via:
#   npm run setup:git
# which runs: git config --local include.path ../.gitconfig.appraise
#
# Keeps index and working-tree diffs aligned with .gitattributes (eol=lf) on Windows.

[core]
	autocrlf = false
	eol = lf
	safecrlf = warn

[diff]
	# Ignore CRLF-only noise when comparing index to working tree (safety net).
	ignoreCrAtEol = true
