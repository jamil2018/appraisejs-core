{
  "name": "appraisejs",
  "version": "0.4.0",
  "description": "AppraiseJS coordinator client and MCP server",
  "license": "Apache-2.0",
  "author": "Hasnat Jamil",
  "homepage": "https://github.com/jamil2018/appraisejs-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamil2018/appraisejs-core.git",
    "directory": "packages/appraisejs"
  },
  "bugs": {
    "url": "https://github.com/jamil2018/appraisejs-core/issues"
  },
  "keywords": [
    "appraisejs",
    "testing",
    "qa",
    "cli",
    "steps"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "appraisejs": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./managed-validation-contracts": {
      "types": "./dist/managed-validation-contracts.d.ts",
      "import": "./dist/managed-validation-contracts.js"
    }
  },
  "files": [
    "dist",
    "agent-skills"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "build:mcp-contract": "tsx scripts/build-mcp-contract.ts",
    "benchmark:mcp-registry": "tsx scripts/benchmark-mcp-registry.ts",
    "test": "vitest run",
    "publish:alpha": "npm publish --tag alpha",
    "publish:beta": "npm publish --tag beta",
    "bump:alpha": "npm version prerelease --preid alpha",
    "bump:beta": "npm version prerelease --preid beta",
    "bump:release": "npm version patch",
    "bump:major": "npm version major",
    "bump:minor": "npm version minor",
    "bump:patch": "npm version patch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
