{
  "name": "appraisejs",
  "version": "0.4.0",
  "description": "Install AppraiseJS template steps into an existing project",
  "license": "Apache-2.0",
  "author": "Hasnat Jamil",
  "homepage": "https://github.com/jamil2018/appraisejs-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamil2018/appraisejs-core.git",
    "directory": "packages/appraisejs"
  },
  "bugs": {
    "url": "https://github.com/jamil2018/appraisejs-core/issues"
  },
  "keywords": [
    "appraisejs",
    "testing",
    "qa",
    "cli",
    "steps"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "appraisejs": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "vitest run",
    "test:mcp:e2e": "tsx src/mcp.e2e.ts",
    "publish:alpha": "npm publish --tag alpha",
    "publish:beta": "npm publish --tag beta",
    "bump:alpha": "npm version prerelease --preid alpha",
    "bump:beta": "npm version prerelease --preid beta",
    "bump:release": "npm version patch",
    "bump:major": "npm version major",
    "bump:minor": "npm version minor",
    "bump:patch": "npm version patch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
