{
  "name": "create-appraisejs",
  "version": "0.4.0",
  "description": "Scaffold a new AppraiseJS app in your directory",
  "license": "Apache-2.0",
  "author": "Hasnat Jamil",
  "homepage": "https://github.com/jamil2018/appraisejs-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamil2018/appraisejs-core.git",
    "directory": "packages/create-appraisejs"
  },
  "bugs": {
    "url": "https://github.com/jamil2018/appraisejs-core/issues"
  },
  "keywords": [
    "appraisejs",
    "appraisejs-core",
    "testing",
    "qa",
    "cucumber",
    "playwright",
    "nextjs",
    "scaffold"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "create-appraisejs": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "templates/base/automation/config/environments/environments.json",
    "templates/flavors/starter/prisma/dev.db",
    "templates/flavors/blank/prisma/dev.db"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run clean && npm run prepare-template && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare-template": "tsx scripts/prepare-template.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "publish:alpha": "npm publish --tag alpha",
    "publish:beta": "npm publish --tag beta",
    "bump:alpha": "npm version prerelease --preid alpha",
    "bump:beta": "npm version prerelease --preid beta",
    "bump:release": "npm version patch",
    "bump:major": "npm version major",
    "bump:minor": "npm version minor",
    "bump:patch": "npm version patch"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "cli-progress": "^3.12.0",
    "cross-spawn": "^7.0.6",
    "fs-extra": "^11.3.5"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.2",
    "tsx": "^4.20.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
