  "customStepJustifications": [
    {
      "path": "automation/steps/inventory-sales-income.steps.ts",
      "missingCapability": "Inventory business-rule validation for stock decrement, sale total calculation, insufficient-stock rejection, sales ledger assertions, and persistence verification.",
      "whyLocatorsAndExistingStepsAreInsufficient": "Existing registry/template steps cover generic navigation, fill, click, reload, visibility, and text assertions, but this plan needs readable domain assertions that combine multiple UI controls with calculated stock and income outcomes. Custom steps keep the validation review tied to inventory and sales behavior instead of scattering arithmetic across low-level locator checks."
    }
