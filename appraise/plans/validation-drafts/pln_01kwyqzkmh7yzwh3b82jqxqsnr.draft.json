            "id": "inventory-sales-income-e2e",
            "title": "Manage inventory, record sales, and track income",
            "description": "Validate that the app opens, creates an inventory item, records a valid sale that decrements stock, updates sales history and income totals, rejects an oversell attempt, and restores persisted stock/sales after reload.",
            "steps": [
              {
                "id": "inventory-sales-income-step-1",
                "order": 1,
                "label": "Open app",
                "gherkinStep": "Given the user opens the inventory app",
                "templateStepId": "fb77d502-3587-4e1e-92ec-1497f98311bc",
                "templateStepName": "navigate to environment base url",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-2",
                "order": 2,
                "label": "Dashboard visible",
                "gherkinStep": "Then the inventory dashboard is visible",
                "templateStepId": "61617d12-4463-4084-929f-1c3c01a41a66",
                "templateStepName": "assert element visible",
                "parameters": [
                  {
                    "name": "element",
                    "value": "Dashboard summary",
                    "type": "locator",
                    "locatorId": "dashboard-summary",
                    "locatorName": "Dashboard summary"
                  },
                  {
                    "name": "visible",
                    "value": "true",
                    "type": "boolean"
                  }
                ]
              },
              {
                "id": "inventory-sales-income-step-3",
                "order": 3,
                "label": "Add item",
                "gherkinStep": "When the user adds an item named \"Rice Bag\" with stock 10 and price 25",
                "templateStepName": "custom inventory item creation",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-4",
                "order": 4,
                "label": "Item visible",
                "gherkinStep": "Then the inventory table shows \"Rice Bag\" with stock 10",
                "templateStepName": "custom inventory assertion",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-5",
                "order": 5,
                "label": "Record sale",
                "gherkinStep": "When the user records a sale of 3 units of \"Rice Bag\"",
                "templateStepName": "custom sale recording",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-6",
                "order": 6,
                "label": "Sale updates stock and income",
                "gherkinStep": "Then the inventory table shows \"Rice Bag\" with stock 7 and income total \"$75.00\"",
                "templateStepName": "custom stock and income assertion",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-7",
                "order": 7,
                "label": "Sales history visible",
                "gherkinStep": "And the sales history shows a sale for \"Rice Bag\" quantity 3 and total \"$75.00\"",
                "templateStepName": "custom sales history assertion",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-8",
                "order": 8,
                "label": "Reject oversell",
                "gherkinStep": "When the user attempts to sell 9 units of \"Rice Bag\"",
                "templateStepName": "custom invalid sale attempt",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-9",
                "order": 9,
                "label": "Error shown and totals unchanged",
                "gherkinStep": "Then the app shows an insufficient stock error and keeps \"Rice Bag\" stock at 7",
                "templateStepName": "custom invalid sale assertion",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-10",
                "order": 10,
                "label": "Reload",
                "gherkinStep": "When the user reloads the page",
                "templateStepId": "cec29b93-dd58-40d6-9fdd-94bd0705ecbe",
                "templateStepName": "reload",
                "parameters": []
              },
              {
                "id": "inventory-sales-income-step-11",
                "order": 11,
                "label": "Persistence restored",
                "gherkinStep": "Then after reload \"Rice Bag\" stock 7, sales history, and income total \"$75.00\" are still visible",
                "templateStepName": "custom persistence assertion",
                "parameters": []
              }
            ]
          }
