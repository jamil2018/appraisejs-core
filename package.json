{
  "name": "appraise",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepublishOnly": "node scripts/refuse-root-publish.mjs",
    "dev": "node scripts/dev-with-mcp.mjs",
    "dev:web": "node scripts/start-local.mjs dev",
    "dev:mcp": "node scripts/dev-with-mcp.mjs --mcp-only",
    "setup:mcp": "node scripts/print-mcp-config.mjs",
    "setup:agent": "node scripts/print-agent-config.mjs",
    "check:harness": "node scripts/check-agent-harness.mjs && node scripts/check-swarm-harness.mjs && node --test scripts/tests/swarm-routing.test.mjs scripts/tests/swarm-evolution.test.mjs",
    "check:swarm-harness": "node scripts/check-swarm-harness.mjs",
    "swarm:record": "node scripts/record-swarm-run.mjs",
    "swarm:route": "node scripts/record-swarm-route.mjs",
    "swarm:evolve": "node scripts/update-swarm-evolution.mjs",
    "swarm:ledger": "node scripts/swarm-ledger.mjs",
    "test:swarm-harness": "node --test scripts/tests/swarm-routing.test.mjs scripts/tests/swarm-evolution.test.mjs",
    "docs:check-links": "node scripts/check-documentation-links.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:check:generic-planning": "node scripts/check-generic-planning-boundary.mjs",
    "release:check:local-boundary": "npm run validate:unit -- scripts/lib/local-startup.test.ts src/lib/local-request-boundary.test.ts",
    "release:check:secrets": "npx tsx scripts/check-environment-secrets.ts && npm run validate:unit -- scripts/lib/environment-secret-check.integration.test.ts src/lib/environment-secret.test.ts src/lib/environment-file-utils.test.ts src/services/environment/environment-service.test.ts src/lib/sync/sync-pending-counts.test.ts",
    "release:check:mcp-http": "npm --prefix packages/appraisejs run test -- src/mcp-http-security.test.ts && npm --prefix packages/appraisejs run test:mcp:http:e2e && npm --prefix packages/appraisejs run test:mcp:e2e",
    "release:check:mcp-contract": "npm --prefix packages/appraisejs run test -- src/mcp-contract.test.ts && npm --prefix packages/appraisejs run build",
    "release:check:architecture": "npm run quality:fallow:release && npm run quality:react-doctor:ci",
    "release:check:bounded-reads": "npm run validate:unit -- src/lib/pagination.test.ts src/lib/test-run/log-tail-reader.test.ts src/app/api/test-runs/[runId]/logs/route.test.ts && npm run benchmark:repository-queries",
    "release:check:artifacts": "node scripts/check-generated-artifacts.mjs",
    "operation:ledger": "node --import tsx scripts/build-operation-capability-ledger.ts",
    "operation:certify": "node --import tsx scripts/certify-operation-architecture.ts",
    "operation:backfill": "node --import tsx scripts/backfill-operation-invocations.ts",
    "operation:projections": "node --import tsx scripts/generate-operation-projections.ts && npm run lint:step-definitions",
    "release:check:operation-drift": "node --import tsx scripts/build-operation-capability-ledger.ts --check",
    "release:check:operation-projections": "node --import tsx scripts/check-operation-projection-drift.ts",
    "release:check:operation-certification": "node --import tsx scripts/certify-operation-architecture.ts --check",
    "generate:coordinator-reference": "node --import tsx scripts/generate-coordinator-reference.ts",
    "release:check:coordinator-reference": "node --import tsx scripts/generate-coordinator-reference.ts --check",
    "release:check:packages": "node scripts/check-package-contents.mjs",
    "release:check:ci": "node scripts/check-release-ci.mjs",
    "benchmark:repository-queries": "node scripts/benchmark-repository-queries.mjs",
    "graphify:install": "node scripts/run-graphify.mjs install --project --platform agents",
    "graphify:build": "node scripts/run-graphify.mjs build-scope src",
    "graphify:build:all": "node scripts/update-graphify-graphs.mjs --all",
    "graphify:build:packages": "node scripts/run-graphify.mjs build-scope packages",
    "graphify:build:prisma": "node scripts/build-prisma-graph.mjs",
    "graphify:build:scripts": "node scripts/run-graphify.mjs build-scope scripts",
    "graphify:auto": "node scripts/update-graphify-graphs.mjs",
    "graphify:update": "node scripts/run-graphify.mjs src --update",
    "graphify:query": "node scripts/run-graphify.mjs query",
    "graphify:path": "node scripts/run-graphify.mjs path",
    "graphify:explain": "node scripts/run-graphify.mjs explain",
    "graphify:serve": "node scripts/run-graphify.mjs mcp",
    "init": "DISABLE_DEVTOOLS=1 NEXT_PUBLIC_DISABLE_DEVTOOLS=1 next dev",
    "prepare": "simple-git-hooks && node scripts/configure-git-line-endings.mjs --quiet",
    "build:cucumber-runtime": "tsc -p packages/cucumber-runtime/tsconfig.json",
    "build:locator-picker-companion": "tsc -p packages/locator-picker-companion/tsconfig.json",
    "build:appraisejs": "npm run build-step-registry && tsc -p packages/appraisejs/tsconfig.json",
    "build": "npm run build:cucumber-runtime && npm run build:locator-picker-companion && npm run build:appraisejs && next build",
    "start": "node scripts/start-local.mjs start",
    "lint": "eslint .",
    "lint:step-definitions": "eslint automation/steps --max-warnings 0",
    "install-playwright": "tsx scripts/install-playwright.ts",
    "install-dependencies": "npm install --legacy-peer-deps",
    "setup-env": "npx tsx scripts/setup-env.ts",
    "setup:git": "node scripts/configure-git-line-endings.mjs",
    "setup:graphify": "node scripts/setup-graphify.mjs",
    "migrate-db": "npx prisma migrate deploy",
    "validate:migrations": "node scripts/validate-prisma-migrations.mjs",
    "generate-db-client": "npx prisma generate",
    "setup": "npm run install-dependencies && npm run setup:git && npm run setup:graphify && npm run setup-env && npm run generate-db-client && npm run migrate-db && npm run install-playwright && npm run sync-all",
    "sync-features": "npx tsx scripts/regenerate-features.ts",
    "sync-features:dry-run": "npx tsx scripts/regenerate-features.ts --dry-run",
    "sync-locator-groups": "npx tsx scripts/sync-locator-groups.ts",
    "sync-environments": "npx tsx scripts/sync-environments.ts",
    "sync-locators": "npx tsx scripts/sync-locators.ts",
    "sync-modules": "npx tsx scripts/sync-modules.ts",
    "sync-tags": "npx tsx scripts/sync-tags.ts",
    "sync-test-suites": "npx tsx scripts/sync-test-suites.ts",
    "sync-test-cases": "npx tsx scripts/sync-test-cases.ts",
    "sync-plans": "npx tsx scripts/sync-plans.ts",
    "smoke:coordinator": "npx tsx scripts/smoke-coordinator.ts",
    "sync-template-step-groups": "npx tsx scripts/sync-template-step-groups.ts",
    "sync-template-steps": "npm run operation:projections && npx tsx scripts/sync-template-steps.ts",
    "sync-step-definitions": "npx tsx scripts/sync-step-definitions.ts",
    "sync-all": "npx tsx scripts/sync-all.ts",
    "build-step-registry": "npx tsx scripts/build-step-registry.ts",
    "appraisejs:install-step": "npx tsx scripts/install-template-step.ts",
    "test": "cucumber-js",
    "certify:plan-builder": "node scripts/certify-plan-builder-lifecycle.mjs",
    "validate:unit": "node --import tsx scripts/run-vitest.ts",
    "validate:e2e": "playwright test",
    "validate:e2e:smoke": "playwright test --grep @smoke",
    "validate": "npm run validate:unit && npm run validate:e2e",
    "quality:fallow": "fallow --format json --quiet --explain",
    "quality:fallow:ci": "fallow --format json --quiet --explain --fail-on-issues",
    "quality:fallow:release": "fallow -r . --format json --quiet --fail-on-regression --regression-baseline config/fallow-baseline-root.json && fallow -r packages/appraisejs --format json --quiet --fail-on-regression --regression-baseline config/fallow-baseline-appraisejs.json && fallow -r packages/create-appraisejs --format json --quiet --fail-on-regression --regression-baseline config/fallow-baseline-create-appraisejs.json",
    "quality:ratchet": "node scripts/check-quality-ratchet.mjs",
    "quality:fallow:commit": "node ./scripts/run-fallow-commit.mjs",
    "quality:react-doctor": "react-doctor . --project appraise --offline --full",
    "quality:react-doctor:ci": "react-doctor . --project appraise --offline --full --fail-on error",
    "quality:react-doctor:commit": "react-doctor . --project appraise --offline --staged --fail-on error",
    "quality:pre-commit": "npm run quality:fallow:commit && npm run quality:react-doctor:commit"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/types": "^7.27.0",
    "@codemirror/lang-jinja": "^6.0.0",
    "@cucumber/tag-expressions": "9.1.0",
    "@faker-js/faker": "^10.5.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-progress": "^1.1.13",
    "@radix-ui/react-radio-group": "^1.4.4",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-toast": "^1.2.20",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/archiver": "^7.0.0",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.2",
    "archiver": "^7.0.1",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.473.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/traverse": "^7.29.0",
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "execa": "^9.6.1",
    "fallow": "^2.104.0",
    "glob": "^11.0.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.20",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "prisma": "^6.19.3",
    "react-doctor": "^0.1.6",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run quality:pre-commit"
  },
  "overrides": {
    "react-is": "^19.2.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "minimatch": ">=10.2.1",
    "next": {
      "postcss": "8.5.19"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "sharp@0.34.5": true,
    "simple-git-hooks@2.13.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
