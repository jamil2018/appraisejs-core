+#[tokio::test(start_paused = true)]
+async fn sampling11_post_loop_diff_await_cannot_resume_ordinary_emission() {
+    let fixture = sampling_fixture(Default::default()).await;
+    let tracker_lock = fixture.tracker.lock().await;
+    let (mut stream, tx, mut interrupted) = sampling_stream();
+    let retained = stream.consumer_dropped.clone();
+    let cancel = CancellationToken::new();
+    let mut accounting = SamplingAccounting::default();
+    tx.send(terminal_usage(false)).await.unwrap();
+    let mut consumer = Box::pin(consume_fixture(
+        &fixture,
+        &mut stream,
+        &mut accounting,
+        cancel.clone(),
+    ));
+    // The real completed branch and post-loop TokenCount run before the held
+    // diff lock. Poll to pending with the terminal consumed; clear prior output.
+    assert!(futures::poll!(consumer.as_mut()).is_pending());
+    assert_eq!(tx.capacity(), 32);
+    let before = take_sampling_events(&fixture);
+    assert!(
+        before
+            .iter()
+            .any(|event| matches!(event, EventMsg::RawResponseCompleted(_))),
+        "must reach the real completed branch before post-loop cancellation"
+    );
+    let observed = tokio::time::Instant::now();
+    cancel.cancel();
+    assert!(futures::poll!(consumer.as_mut()).is_pending());
+    assert_original_cancel(interrupted.try_recv().unwrap(), observed);
+    assert!(!retained.is_cancelled());
+    drop(tracker_lock);
+    drop(tx);
+    assert_sampling_aborted(consumer.await);
+    assert_eq!(accounting.state, SamplingAccountingState::Completed);
+    assert_eq!(fixture.session.get_total_token_usage().await, 7);
+    assert!(take_sampling_events(&fixture).is_empty());
