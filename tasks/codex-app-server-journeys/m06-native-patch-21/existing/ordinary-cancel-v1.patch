+    pub(crate) fn bootstrapped_original() -> (SourceOwner, Control, UnixStream) {
+        let (control_child, control_parent) = UnixStream::pair().unwrap();
+        let (output_child, mut output_parent) = UnixStream::pair().unwrap();
+        // Transfer ownership of these actual local descriptors exactly once.
+        let control_file = unsafe { std::fs::File::from_raw_fd(control_child.into_raw_fd()) };
+        let output_file = unsafe { std::fs::File::from_raw_fd(output_child.into_raw_fd()) };
+        let bootstrap =
+            std::thread::spawn(move || SourceOwner::bootstrap(control_file, output_file));
+        let mut control = Control::new(control_parent);
+        control.send("BOOTSTRAP", json!({"binding":control.binding.clone()}));
+        assert_eq!(read_frame(&mut output_parent).unwrap()["kind"], "HELLO");
+        control.send("BOOTSTRAP_ACK", json!({"helperClosed":true}));
+        let owner = bootstrap.join().unwrap().unwrap();
+        assert!(owner.check_live().is_ok());
+        (owner, control, output_parent)
+    }
+}
