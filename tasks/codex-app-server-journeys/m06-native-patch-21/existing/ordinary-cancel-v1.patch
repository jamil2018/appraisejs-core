+            std::fs::File::from(OwnedFd::from(native_control)),
+            std::fs::File::from(OwnedFd::from(native_source)),
+        )
+        .unwrap();
+        let body = concat!(
+            "data: {\"type\":\"response.created\",\"response\":{\"id\":\"r1\"}}\n\n",
+            "data: {\"type\":\"response.output_text.delta\",\"delta\":5}\n\n",
+            "data: {\"type\":\"response.output_item.done\",\"item\":42}\n\n",
+            "data: {\"type\":\"future.event\"}\n\n",
+            "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"r1\"}}\n\n",
+            "data: {\"type\":\"response.output_text.delta\",\"delta\":\"after-completion\"}\n\n"
+        );
+        let response = StreamResponse {
+            status: StatusCode::OK,
+            headers: HeaderMap::new(),
+            bytes: Box::pin(stream::iter(vec![Ok(Bytes::from_static(body.as_bytes()))])),
+        };
+        let consumer = spawn_response_stream_owned(
+            response,
+            Duration::from_secs(5),
+            None,
+            None,
+            Some(owner.clone()),
+        );
+        drop(consumer);
+        closed_rx.await.unwrap();
+        let observed = frames.lock().unwrap();
+        let raws: Vec<_> = observed
+            .iter()
+            .filter(|f| f["kind"] == "RAW_INPUT" && f["payload"]["parseDisposition"] == "PENDING")
+            .collect();
+        let finals: Vec<_> = observed
+            .iter()
+            .filter(|f| f["kind"] == "PARSE_DISPOSITION")
+            .collect();
+        assert_eq!(raws.len(), 6);
+        assert_eq!(finals.len(), 6);
+        for (raw, finalized) in raws.iter().zip(&finals) {
+            assert_eq!(finalized["payload"]["rawSequence"], raw["sequence"]);
+            assert_eq!(
+                finalized["payload"]["rawDigest"],
+                raw["payload"]["rawDigest"]
+            );
+        }
+        assert_eq!(finals[1]["payload"]["parseDisposition"], "MALFORMED");
+        assert_eq!(finals[2]["payload"]["parseDisposition"], "MALFORMED");
+        assert_eq!(finals[3]["payload"]["parseDisposition"], "UNKNOWN");
+        assert_eq!(
+            observed
+                .iter()
+                .filter(|f| f["kind"] == "LOCAL_CLOSE")
+                .count(),
+            1
+        );
+        assert!(observed.last().is_some_and(|f| f["kind"] == "LOCAL_CLOSE"));
+        assert!(owner.check_admission().is_err());
+        assert!(owner.check_live().is_ok());
+        assert!(owner.seal_candidate().is_err());
+        drop(observed);
+        release_tx.send(()).unwrap();
+        parent.join().unwrap();
+    }
 }
