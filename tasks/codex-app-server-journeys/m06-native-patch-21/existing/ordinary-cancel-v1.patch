+// Candidate source tests: execution requires the unavailable Rust toolchain.
+fn cancellation_stream() -> (
+    ResponseStream,
+    mpsc::Sender<Result<ResponseEvent>>,
+    oneshot::Receiver<codex_api::ResponseInterrupt>,
+) {
+    let (tx, rx_event) = mpsc::channel(8);
+    let (interrupt, interrupted) = oneshot::channel();
+    (
+        ResponseStream {
+            rx_event,
+            interrupt: Some(interrupt),
+            consumer_dropped: CancellationToken::new(),
+        },
+        tx,
+        interrupted,
+    )
+}
+
+#[tokio::test]
+async fn ordinary_cancel_sends_once_and_retains_original_consumer_through_cleanup() {
+    let (mut stream, tx, interrupted) = cancellation_stream();
+    let dropped = stream.consumer_dropped.clone();
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_millis(100);
+    let cleanup = stream.cancel_and_drain(deadline, None);
+    let producer = async {
+        assert!(
+            matches!(interrupted.await, Ok(codex_api::ResponseInterrupt::Cancel {
+            deadline: actual,
+        }) if actual == deadline)
+        );
+        assert!(!dropped.is_cancelled());
+        tx.send(Ok(ResponseEvent::OutputTextDelta("suppressed".into())))
+            .await
+            .unwrap();
+        assert!(!dropped.is_cancelled());
+        tx.send(Err(codex_protocol::error::CodexErr::Stream(
+            "cleanup stopped".into(),
+        )))
+        .await
+        .unwrap();
+    };
+    let (event, ()) = tokio::join!(cleanup, producer);
+    assert!(matches!(event, Some(Err(_))));
+    assert!(!dropped.is_cancelled());
+    assert!(stream.interrupt.is_none());
+    assert!(stream.cancel_and_drain(deadline, None).await.is_none());
+    drop(stream);
+    assert!(dropped.is_cancelled());
+}
+
+#[tokio::test]
+async fn ordinary_cancel_missing_or_failed_interrupt_does_not_poll_or_retry() {
+    let (mut stream, tx, interrupted) = cancellation_stream();
+    drop(interrupted);
+    tx.send(Ok(ResponseEvent::OutputTextDelta("queued".into())))
+        .await
+        .unwrap();
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_millis(100);
+    assert!(stream.cancel_and_drain(deadline, None).await.is_none());
+    assert!(stream.interrupt.is_none());
+    assert_eq!(stream.rx_event.len(), 1);
+    assert!(stream.cancel_and_drain(deadline, None).await.is_none());
+    assert_eq!(stream.rx_event.len(), 1);
