+    NotStarted,
+    Running,
+    Completed,
+    Interrupted,
+}
+
+#[derive(Default)]
+struct SamplingAccounting {
+    state: SamplingAccountingState,
+    job: Option<Pin<Box<dyn Future<Output = CodexResult<()>> + Send>>>,
+    result: Option<CodexResult<()>>,
+    conflicting_terminal: bool,
+}
+
+impl SamplingAccounting {
+    fn observe(
+        &mut self,
+        event: Option<&CodexResult<ResponseEvent>>,
+        sess: &Arc<Session>,
+        step_context: &Arc<StepContext>,
+    ) {
+        let job: Pin<Box<dyn Future<Output = CodexResult<()>> + Send>> = match event {
+            Some(Ok(ResponseEvent::Completed {
+                response_id,
+                token_usage,
+                ..
+            })) => {
+                if self.state != SamplingAccountingState::Empty {
+                    self.conflicting_terminal = true;
+                    return;
+                }
+                let response_id = response_id.clone();
+                let token_usage = token_usage.clone();
+                let sess = Arc::clone(sess);
+                let step_context = Arc::clone(step_context);
+                Box::pin(async move {
+                    sess.record_response_token_usage(
+                        &step_context.turn,
+                        &response_id,
+                        token_usage.as_ref(),
+                    )
+                    .await;
+                    sess.record_token_usage_info(
+                        &step_context.turn,
+                        &step_context.settings,
+                        token_usage.as_ref(),
+                        super::TokenUsageContext::Sampling,
+                    )
+                    .await
+                })
+            }
+            Some(Err(err)) => {
+                let CodexErrorDetails::ResponseIncomplete(incomplete) = err.details() else {
+                    return;
+                };
+                if self.state != SamplingAccountingState::Empty {
+                    self.conflicting_terminal = true;
+                    return;
+                }
