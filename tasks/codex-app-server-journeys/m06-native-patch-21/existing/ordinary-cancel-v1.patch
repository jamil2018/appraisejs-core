+impl ResponseStream {
+    // This synchronous boundary must precede every cancellation-cleanup await.
+    pub(crate) fn request_cancel(&mut self, deadline: tokio::time::Instant) -> bool {
+        self.interrupt.take().is_some_and(|interrupt| {
+            interrupt
+                .send(codex_api::ResponseInterrupt::Cancel { deadline })
+                .is_ok()
+        })
+    }
+
+    #[cfg(test)]
+    async fn cancel_and_drain(
+        &mut self,
+        deadline: tokio::time::Instant,
+        received: Option<Result<ResponseEvent>>,
+    ) -> Option<Result<ResponseEvent>> {
+        let sent = self.request_cancel(deadline);
+        if matches!(
+            received.as_ref(),
+            Some(Ok(ResponseEvent::Completed { .. })) | Some(Err(_))
+        ) {
+            return received;
+        }
+        if !sent {
+            return None;
+        }
+        self.drain_cancelled(deadline).await
+    }
+
+    // Original consumer only; no ordinary events or provider-finality claim.
+    pub(crate) async fn drain_cancelled(
+        &mut self,
+        deadline: tokio::time::Instant,
+    ) -> Option<Result<ResponseEvent>> {
+        use futures::StreamExt;
+        loop {
+            let event = tokio::select! {
+                biased;
+                _ = tokio::time::sleep_until(deadline) => return None,
+                event = self.next() => event,
+            };
+            match event {
+                Some(Ok(ResponseEvent::Completed { .. })) | Some(Err(_)) | None => return event,
+                Some(Ok(_)) => {}
+            }
+        }
+    }
+}
