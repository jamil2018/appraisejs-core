+#[test_case::test_case(true; "incomplete_late_drain")]
+#[tokio::test(start_paused = true)]
+async fn sampling11_late_drain_usage_uses_only_remaining_original_deadline(incomplete: bool) {
+    let gate = Arc::new(SamplingGate::default());
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::new();
+    builder.token_usage_contributor(gate.clone());
+    let fixture = sampling_fixture(builder).await;
+    let (mut stream, tx, mut interrupted) = sampling_stream();
+    let mut accounting = SamplingAccounting::default();
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    let observed = tokio::time::Instant::now();
+    let mut consumer = Box::pin(consume_fixture(
+        &fixture,
+        &mut stream,
+        &mut accounting,
+        cancel,
+    ));
+    assert!(futures::poll!(consumer.as_mut()).is_pending());
+    let deadline = assert_original_cancel(interrupted.try_recv().unwrap(), observed);
+    tokio::time::advance(std::time::Duration::from_millis(50)).await;
+    tx.send(terminal_usage(incomplete)).await.unwrap();
+    tokio::select! {
+        biased;
+        _ = gate.entered.notified() => {}
+        _ = &mut consumer => panic!("late accounting must await real contributor"),
+    }
+    assert_eq!(fixture.session.get_total_token_usage().await, 7);
+    tokio::time::advance(deadline - tokio::time::Instant::now()).await;
+    assert_sampling_aborted(consumer.await);
+    assert_eq!(accounting.state, SamplingAccountingState::Interrupted);
+    assert!(accounting.job.is_none());
+    gate.release.notify_one();
+    tokio::task::yield_now().await;
+    assert_eq!(gate.calls.load(Ordering::SeqCst), 1);
+    assert_eq!(fixture.session.get_total_token_usage().await, 7);
+    assert!(take_sampling_events(&fixture).is_empty());
