+#[cfg(test)]
+mod m06_auth_entry_tests {
+    //! AUTHORED_UNEXECUTED. Irreversible process latch requires isolated invocation.
+    use super::*;
+    use crate::{AuthProvider, Provider, RetryConfig};
+    use codex_http_client::{HttpClientFactory, OutboundProxyPolicy};
+    use codex_websocket_client::WebSocketTlsMode;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::Duration;
+
+    struct CountAuth(Arc<AtomicUsize>);
+    impl AuthProvider for CountAuth {
+        fn add_auth_headers(&self, _headers: &mut HeaderMap) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+    #[tokio::test]
+    #[ignore = "AUTHORED_UNEXECUTED; missing original owner fixture installs process latch"]
+    async fn original_public_connector_entry_rejects_before_url_or_auth_callback() {
+        let calls = Arc::new(AtomicUsize::new(0));
+        let provider = Provider {
+            name: "fixture".into(),
+            base_url: "invalid URL, must never be parsed".into(),
+            query_params: None,
+            headers: HeaderMap::new(),
+            retry: RetryConfig {
+                max_attempts: 1,
+                base_delay: Duration::ZERO,
+                retry_429: false,
+                retry_5xx: false,
+                retry_transport: false,
+            },
+            stream_idle_timeout: Duration::from_secs(1),
+        };
+        let client =
+            ResponsesWebsocketClient::new(provider, Arc::new(CountAuth(Arc::clone(&calls))));
+        let factory = HttpClientFactory::new(OutboundProxyPolicy::RespectSystemProxy);
+        // This original constructor's default TLS mode avoids CA/file/network work in this fixture.
+        let connector =
+            WebSocketConnector::new_with_tls_mode(&factory, WebSocketTlsMode::TungsteniteDefault)
+                .unwrap();
+        codex_http_client::m06_outcome::request_restrictive_profile();
+        assert!(
+            client
+                .connect_with_connector(&connector, HeaderMap::new(), HeaderMap::new(), None, None)
+                .await
+                .is_err()
+        );
+        assert_eq!(calls.load(Ordering::SeqCst), 0);
+    }
+}
