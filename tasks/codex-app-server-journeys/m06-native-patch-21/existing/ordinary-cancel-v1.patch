+/// Bounded original-byte read; retains LF/CRLF and partial EOF, never allocates past cap.
+fn read_original_record(reader: &mut impl BufRead) -> IoResult<Option<Vec<u8>>> {
+    const LIMIT: usize = 256 * 1024 + 2;
+    let mut record = Vec::new();
+    loop {
+        let available = reader.fill_buf()?;
+        if available.is_empty() {
+            return Ok(if record.is_empty() {
+                None
+            } else {
+                Some(record)
+            });
+        }
+        let count = available
+            .iter()
+            .position(|byte| *byte == b'\n')
+            .map_or(available.len(), |index| index + 1);
+        if record
+            .len()
+            .checked_add(count)
+            .is_none_or(|length| length > LIMIT)
+        {
+            return Err(std::io::Error::new(
+                ErrorKind::InvalidData,
+                "M06 RPC record limit",
+            ));
+        }
+        record.extend_from_slice(&available[..count]);
+        reader.consume(count);
+        if record.ends_with(b"\n") {
+            return Ok(Some(record));
+        }
+    }
+}
+
+fn forward_original_stdin(
+    reader: &mut impl BufRead,
+    owner: &m06_outcome::SourceOwner,
+    mut forward: impl FnMut(String) -> IoResult<()>,
+) -> IoResult<()> {
+    while let Some(record) = read_original_record(reader)? {
+        owner.observe_rpc_input(&record, !record.ends_with(b"\n"))?;
+        let mut line = String::from_utf8(record).map_err(|_| m06_outcome::deny())?;
+        line.pop(); // The observed original record included LF.
+        if line.ends_with('\r') {
+            line.pop();
+        }
+        forward(line)?;
+    }
+    owner.observe_rpc_eof()
+}
+
+fn write_original_stdout(
+    writer: &mut impl Write,
+    owner: &m06_outcome::SourceOwner,
+    bytes: &[u8],
+) -> IoResult<()> {
+    owner.write_rpc_stdout(writer, bytes)
+}
