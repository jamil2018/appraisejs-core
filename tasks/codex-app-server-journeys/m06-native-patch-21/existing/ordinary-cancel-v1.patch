+/// The same original lease moves into QueuedInitializedRequest; no reconstructed work observer.
+struct M06QueuedWork {
+    work: Option<codex_http_client::m06_outcome::RpcWork>,
+    gate: Arc<ConnectionRpcGate>,
+}
+impl M06QueuedWork {
+    fn begin(&mut self) -> Result<Option<codex_http_client::m06_outcome::RpcWork>, ()> {
+        let Some(mut work) = self.work.take() else {
+            return Ok(None);
+        };
+        if work.dispatch().is_err() {
+            let _ = work.not_dispatched();
+            return Err(());
+        }
+        Ok(Some(work))
+    }
+}
+impl Drop for M06QueuedWork {
+    fn drop(&mut self) {
+        if let Some(work) = self.work.take() {
+            if self.gate.is_closed() {
+                // The original irreversible gate discarded this never-polled queued future.
+                let _ = work.not_dispatched();
+            }
+            // Otherwise RpcWork::drop records an unexplained lost future as UNKNOWN.
+        }
+    }
+}
