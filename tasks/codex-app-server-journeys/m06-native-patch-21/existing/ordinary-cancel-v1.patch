+#[cfg(test)]
+mod m06_rpc_tests {
+    // AUTHORED_UNEXECUTED: exercises the exact bounded reader used above.
+    use super::*;
+    use std::io::{BufReader, Cursor};
+    #[test]
+    fn original_records_keep_split_utf8_crlf_and_partial_eof() {
+        let bytes = "{\"text\":\"雪\"}\r\nsecond\npartial".as_bytes();
+        let mut reader = BufReader::with_capacity(1, Cursor::new(bytes));
+        assert_eq!(
+            read_original_record(&mut reader).unwrap().unwrap(),
+            "{\"text\":\"雪\"}\r\n".as_bytes()
+        );
+        assert_eq!(
+            read_original_record(&mut reader).unwrap().unwrap(),
+            b"second\n"
+        );
+        assert_eq!(
+            read_original_record(&mut reader).unwrap().unwrap(),
+            b"partial"
+        );
+        assert!(read_original_record(&mut reader).unwrap().is_none());
+    }
+    #[test]
+    fn oversized_original_record_refuses_before_unbounded_allocation() {
+        let bytes = vec![b'x'; 256 * 1024 + 3];
+        let mut reader = BufReader::with_capacity(7, Cursor::new(bytes));
+        assert!(read_original_record(&mut reader).is_err());
+    }
+}
