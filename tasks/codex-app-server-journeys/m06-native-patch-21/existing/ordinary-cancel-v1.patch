+// Concrete original task; its guard is acquired by the caller before spawning.
+async fn run_original_outbound_task(
+    mut outgoing_rx: mpsc::Receiver<OutgoingEnvelope>,
+    mut outbound_control_rx: mpsc::Receiver<OutboundControlEvent>,
+    outbound_source: Option<codex_http_client::m06_outcome::SourceOwner>,
+    outbound_retirement: Option<codex_http_client::m06_outcome::RetirementGuard>,
+) {
+    let mut controls_closed = false;
+    let mut outbound_connections = HashMap::<ConnectionId, OutboundConnectionState>::new();
+    loop {
+        tokio::select! {
+                biased;
+                event = outbound_control_rx.recv(), if !controls_closed => {
+                    let Some(event) = event else {
+                        if outbound_source.is_none() { break; }
+                        controls_closed = true;
+                        continue;
+                    };
+                    match event {
+                        OutboundControlEvent::Opened {
+                            connection_id,
+                            writer,
+                            disconnect_sender,
+                            initialized,
+                            experimental_api_enabled,
+                            opted_out_notification_methods,
+                        } => {
+                            outbound_connections.insert(
+                                connection_id,
+                                OutboundConnectionState::new(
+                                    writer,
+                                    initialized,
+                                    experimental_api_enabled,
+                                    opted_out_notification_methods,
+                                    disconnect_sender,
+                                ),
+                            );
+                        }
+                        OutboundControlEvent::Closed { connection_id } => {
+                            // The original M06 stdio writer must survive RPC cleanup replies.
+                            // It retires only after the original outgoing queue is drained.
+                            if outbound_source.is_none() {
+                                outbound_connections.remove(&connection_id);
+                            }
+                        }
+                        OutboundControlEvent::DisconnectAll => {
+                            if let Some(owner) = &outbound_source { owner.fence("OUTBOUND_FORCED_DISCONNECT"); }
+                            info!(
+                                "disconnecting {} outbound websocket connection(s) for graceful restart",
+                                outbound_connections.len()
+                            );
+                            for connection_state in outbound_connections.values() {
+                                connection_state.request_disconnect();
+                            }
+                            outbound_connections.clear();
+                        }
+                    }
+                }
+                envelope = outgoing_rx.recv() => {
+                let Some(envelope) = envelope else {
+                    break;
+                };
+                if let Some(owner) = &outbound_source {
+                    if route_original_source_output(&mut outbound_connections, envelope).await.is_err() {
+                        owner.fence("OUTBOUND_DELIVERY_LOST");
+                        break;
+                    }
+                } else {
+                    route_outgoing_envelope(&mut outbound_connections, envelope).await;
+                }
+            }
+        }
+    }
+    drop(outbound_connections); // Release original writer queues before transport joins.
+    if let Some(retirement) = outbound_retirement {
+        let _ = retirement.observed_completion();
+    }
+    info!("outbound router task exited (channel closed)");
+}
+
+async fn route_original_source_output(
+    connections: &mut HashMap<ConnectionId, OutboundConnectionState>,
+    envelope: OutgoingEnvelope,
+) -> IoResult<()> {
+    let messages = match envelope {
+        OutgoingEnvelope::ToConnection {
+            connection_id,
+            message,
+            write_complete_tx,
+        } => vec![(connection_id, message, write_complete_tx)],
+        OutgoingEnvelope::Broadcast { message } => {
+            let targets = connections
+                .iter()
+                .filter(|(_, state)| state.initialized.load(std::sync::atomic::Ordering::Acquire))
+                .map(|(id, _)| (*id, message.clone(), None))
+                .collect::<Vec<_>>();
+            if targets.is_empty() {
+                return Err(codex_http_client::m06_outcome::deny());
+            }
+            targets
+        }
+    };
+    for (connection_id, message, original_completion) in messages {
+        let (written, receipt) = tokio::sync::oneshot::channel();
+        route_outgoing_envelope(
+            connections,
+            OutgoingEnvelope::ToConnection {
+                connection_id,
+                message,
+                write_complete_tx: Some(written),
+            },
+        )
+        .await;
+        // A filter, removed destination, queue discard or lost original write is UNKNOWN.
+        receipt
+            .await
+            .map_err(|_| codex_http_client::m06_outcome::deny())?;
+        if let Some(completion) = original_completion {
+            let _ = completion.send(());
+        }
+    }
+    Ok(())
 }
 
