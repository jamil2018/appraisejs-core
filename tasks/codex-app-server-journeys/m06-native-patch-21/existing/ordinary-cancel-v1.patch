+#[tokio::test(start_paused = true)]
+async fn sampling11_ready_ordinary_contributor_cancels_before_next_owned_dispatch() {
+    let gate = Arc::new(SamplingGate::default());
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::new();
+    builder.turn_item_contributor(gate.clone());
+    let fixture = sampling_fixture(builder).await;
+    let (mut stream, tx, mut interrupted) = sampling_stream();
+    let retained = stream.consumer_dropped.clone();
+    let mut accounting = SamplingAccounting::default();
+    let cancel = CancellationToken::new();
+    tx.send(Ok(ResponseEvent::OutputItemDone(assistant_output_text(
+        "same-poll helper item",
+    ))))
+    .await
+    .unwrap();
+    let mut consumer = Box::pin(consume_fixture(
+        &fixture,
+        &mut stream,
+        &mut accounting,
+        cancel.clone(),
+    ));
+    tokio::select! {
+        biased;
+        _ = gate.entered.notified() => {}
+        _ = &mut consumer => panic!("must enter the real ordinary contributor"),
+    }
+    assert!(!cancel.is_cancelled());
+    assert_eq!(gate.ready_returns.load(Ordering::SeqCst), 0);
+    *gate.cancel_on_release.lock().unwrap() = Some(cancel.clone());
+    tx.send(Ok(ResponseEvent::ServerReasoningIncluded(true)))
+        .await
+        .unwrap();
+    tx.send(Ok(ResponseEvent::OutputItemDone(
+        ResponseItem::FunctionCall {
+            status: None,
+            encrypted_content: None,
+            id: None,
+            name: "m06_never_registered".into(),
+            namespace: None,
+            arguments: "{}".into(),
+            call_id: "post-ready-never-dispatch".into(),
+            encrypted_function_args: None,
+            internal_chat_message_metadata_passthrough: None,
+        },
+    )))
+    .await
+    .unwrap();
+    tx.send(terminal_usage(false)).await.unwrap();
+    let observed = tokio::time::Instant::now();
+    assert!(
+        !cancel.is_cancelled(),
+        "token must remain live until the contributor itself returns Ready"
+    );
+    gate.release.notify_one();
+    assert_sampling_aborted(consumer.await);
+    assert!(cancel.is_cancelled());
+    assert_eq!(
+        gate.ready_returns.load(Ordering::SeqCst),
+        1,
+        "exclude a pre-poll cancellation pass"
+    );
+    assert_eq!(gate.calls.load(Ordering::SeqCst), 1);
+    assert_original_cancel(interrupted.try_recv().unwrap(), observed);
+    assert!(
+        interrupted.try_recv().is_err(),
+        "original interrupt is once-only"
+    );
+    assert!(!retained.is_cancelled());
+    // Helper-internal same-poll item events/history can already have happened;
+    // invariant6 does not reverse them. Assert the next consumer-owned branches.
+    assert!(
+        !fixture
+            .session
+            .state
+            .lock()
+            .await
+            .server_reasoning_included(),
+        "queued ordinary metadata dispatch must only be drained"
+    );
+    let history = fixture.session.clone_history().await;
+    assert!(
+        history
+            .raw_items()
+            .any(|item| matches!(item, ResponseItem::Message { role, .. } if role == "assistant")),
+        "the real helper completed its same-poll item continuation"
+    );
+    assert!(
+        !history.raw_items().any(
+            |item| matches!(item, ResponseItem::FunctionCall { call_id, .. }
+        if call_id == "post-ready-never-dispatch")
+        ),
+        "next owned tool item must not be scheduled/recorded"
+    );
+    assert!(
+        !take_sampling_events(&fixture)
+            .iter()
+            .any(|event| matches!(event, EventMsg::RawResponseCompleted(_)))
+    );
+    assert_eq!(accounting.state, SamplingAccountingState::Completed);
+    assert_eq!(fixture.session.get_total_token_usage().await, 7);
+}
