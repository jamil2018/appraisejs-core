+/// Projection of the already normalized result, never a second parse of raw input.
+pub(crate) fn normalized_source_identity(
+    result: &std::result::Result<Option<ResponseEvent>, ResponsesEventError>,
+) -> (Option<String>, Option<String>, Option<String>) {
+    match result {
+        Ok(Some(ResponseEvent::Created { response_id })) => (response_id.clone(), None, None),
+        Ok(Some(ResponseEvent::Completed { response_id, .. })) => {
+            (Some(response_id.clone()), None, None)
+        }
+        Ok(Some(ResponseEvent::OutputItemDone(item))) => {
+            let call = match item {
+                ResponseItem::FunctionCall { call_id, .. } => Some(call_id.clone()),
+                _ => None,
+            };
+            (None, item.id().map(ToString::to_string), call)
+        }
+        _ => (None, None, None),
+    }
 }
 
