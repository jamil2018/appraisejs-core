+fn cancellation_cleanup_deadline() -> tokio::time::Instant {
+    tokio::time::Instant::now()
+        + std::time::Duration::from_millis(crate::tasks::GRACEFULL_INTERRUPTION_TIMEOUT_MS)
+}
+
+// The owning consumer guards every directly awaited ordinary operation. It does
+// not claim to reverse effects or fence detached/transitive work inside helpers.
+trait SamplingOrdinaryFutureExt: Future + Sized {
+    fn ordinary<'a>(self, cancellation: &'a CancellationToken)
+        -> impl Future<Output = Result<Self::Output, tokio::time::Instant>> + Send + 'a
+    where Self: Send + 'a, Self::Output: Send {
+        async move {
+            let value = tokio::select! {
+                biased;
+                _ = cancellation.cancelled() => return Err(cancellation_cleanup_deadline()),
+                value = self => value,
+            };
+            if cancellation.is_cancelled() {
+                return Err(cancellation_cleanup_deadline());
+            }
+            Ok(value)
+        }
+    }
+}
+impl<F: Future> SamplingOrdinaryFutureExt for F {}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+enum SamplingAccountingState {
+    #[default]
+    Empty,
+    NotStarted,
+    Running,
+    Completed,
+    Interrupted,
+}
+
+#[derive(Default)]
+struct SamplingAccounting {
+    state: SamplingAccountingState,
+    job: Option<Pin<Box<dyn Future<Output = CodexResult<()>> + Send>>>,
+    result: Option<CodexResult<()>>,
+    conflicting_terminal: bool,
+}
+
+impl SamplingAccounting {
+    fn observe(
+        &mut self,
+        event: Option<&CodexResult<ResponseEvent>>,
+        sess: &Arc<Session>,
+        step_context: &Arc<StepContext>,
+    ) {
+        let job: Pin<Box<dyn Future<Output = CodexResult<()>> + Send>> = match event {
+            Some(Ok(ResponseEvent::Completed { response_id, token_usage, .. })) => {
+                if self.state != SamplingAccountingState::Empty {
+                    self.conflicting_terminal = true;
+                    return;
+                }
+                let response_id = response_id.clone();
+                let token_usage = token_usage.clone();
+                let sess = Arc::clone(sess);
+                let step_context = Arc::clone(step_context);
+                Box::pin(async move {
+                    sess.record_response_token_usage(
+                        &step_context.turn, &response_id, token_usage.as_ref(),
+                    ).await;
+                    sess.record_token_usage_info(
+                        &step_context.turn, &step_context.settings, token_usage.as_ref(),
+                        super::TokenUsageContext::Sampling,
+                    ).await
+                })
+            }
+            Some(Err(err)) => {
+                let CodexErrorDetails::ResponseIncomplete(incomplete) = err.details() else {
+                    return;
+                };
+                if self.state != SamplingAccountingState::Empty {
+                    self.conflicting_terminal = true;
+                    return;
+                }
+                // Own only bounded accounting fields; preserve the original error
+                // separately in the consumer. This is the one construction site.
+                let incomplete = codex_protocol::error::ResponseIncompleteError {
+                    reason: incomplete.reason.clone(),
+                    response_id: incomplete.response_id.clone(),
+                    token_usage: incomplete.token_usage.clone(),
+                };
+                let sess = Arc::clone(sess);
+                let step_context = Arc::clone(step_context);
+                Box::pin(async move {
+                    sess.record_incomplete_response_usage(
+                        &step_context.turn, &step_context.settings, &incomplete,
+                    ).await;
+                    Ok(())
+                })
+            }
+            _ => return,
+        };
+        self.job = Some(job);
+        self.state = SamplingAccountingState::NotStarted;
+    }
+
+    fn complete(&mut self, result: CodexResult<()>) {
+        // Record completion before any post-ready cancellation check.
+        self.result = Some(result);
+        self.state = SamplingAccountingState::Completed;
+        self.job = None;
+    }
+
+    async fn poll_normal(&mut self, cancellation: &CancellationToken)
+        -> Result<(), tokio::time::Instant> {
+        let Some(job) = self.job.as_mut() else { return Ok(()) };
+        self.state = SamplingAccountingState::Running;
+        let result = tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => return Err(cancellation_cleanup_deadline()),
+            result = job.as_mut() => result,
+        };
+        self.complete(result);
+        if cancellation.is_cancelled() {
+            return Err(cancellation_cleanup_deadline());
+        }
+        Ok(())
+    }
+
+    fn take_result(&mut self) -> Option<CodexResult<()>> {
+        self.result.take()
+    }
+
+    fn interrupt(&mut self) {
+        if matches!(self.state, SamplingAccountingState::NotStarted | SamplingAccountingState::Running) {
+            self.state = SamplingAccountingState::Interrupted;
+            self.job = None;
+            warn!("sampling accounting interrupted; partial ledger/spending retained, remaining work UNKNOWN; no replay");
+        }
+    }
+}
+
+impl Drop for SamplingAccounting {
+    fn drop(&mut self) {
+        // Synchronous process-local observation only, including outer task abort.
+        self.interrupt();
+    }
+}
+
+async fn cancel_sampling_response(
+    stream: &mut ResponseStream,
+    accounting: &mut SamplingAccounting,
+    sess: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    deadline: tokio::time::Instant,
+    received: Option<CodexResult<ResponseEvent>>,
+) -> CodexResult<SamplingRequestResult> {
+    // Once-only original Cancel happens synchronously, before accounting or any
+    // cleanup await. No helper reconstructs a partially polled accounting call.
+    let sent = stream.request_cancel(deadline);
+    accounting.observe(received.as_ref(), sess, step_context);
+    let drain = stream.drain_cancelled(deadline);
+    tokio::pin!(drain);
+    let mut drain_done = !sent;
+    loop {
+        if drain_done && accounting.job.is_none() { break; }
+        if accounting.job.is_some() { accounting.state = SamplingAccountingState::Running; }
+        enum Progress {
+            Deadline,
+            Accounting(CodexResult<()>),
+            Drain(Option<CodexResult<ResponseEvent>>),
+        }
+        let progress = {
+            let usage = async {
+                match accounting.job.as_mut() {
+                    Some(job) => job.as_mut().await,
+                    None => std::future::pending().await,
+                }
+            };
+            tokio::select! {
+                biased;
+                _ = tokio::time::sleep_until(deadline) => Progress::Deadline,
+                result = usage => Progress::Accounting(result),
+                event = &mut drain, if !drain_done => Progress::Drain(event),
+            }
+        };
+        match progress {
+            Progress::Deadline => { accounting.interrupt(); break; }
+            Progress::Accounting(result) => accounting.complete(result),
+            Progress::Drain(event) => {
+                drain_done = true;
+                accounting.observe(event.as_ref(), sess, step_context);
+            }
+        }
+    }
+    // Both owners stayed here until settled/deadline. EOF, usage completion and
+    // interrupt send are not provider witnesses. Outer abort may truncate sooner.
+    Err(CodexErr::TurnAborted)
+}
