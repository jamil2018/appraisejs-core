+#[tokio::test(start_paused = true)]
+async fn sampling11_ttft_pending_delta_cancels_before_ordinary_dispatch() {
+    let fixture = sampling_fixture(Default::default()).await;
+    let (mut stream, tx, mut interrupted) = sampling_stream();
+    let retained = stream.consumer_dropped.clone();
+    let cancel = CancellationToken::new();
+    let mut accounting = SamplingAccounting::default();
+    tx.send(Ok(ResponseEvent::OutputItemAdded(assistant_output_text("")))).await.unwrap();
+    let mut consumer = Box::pin(consume_fixture(&fixture, &mut stream, &mut accounting, cancel.clone()));
+    // Drive the real added-item branch to its emitted start, then its next read.
+    tokio::select! {
+        biased;
+        event = fixture.events.recv() => { assert!(matches!(event.unwrap().msg, EventMsg::ItemStarted(_))); }
+        _ = &mut consumer => panic!("consumer must wait for streamed delta"),
+    }
+    assert!(futures::poll!(consumer.as_mut()).is_pending());
+    take_sampling_events(&fixture); // Already emitted before cancellation is observed.
+    let timing_lock = fixture.step.turn.turn_timing_state.lock_for_sampling_test().await;
+    tx.send(Ok(ResponseEvent::OutputTextDelta("must not emit".into()))).await.unwrap();
+    assert!(futures::poll!(consumer.as_mut()).is_pending());
+    assert_eq!(tx.capacity(), 32, "delta consumed and pending at the actual TTFT lock");
+    let observed = tokio::time::Instant::now();
+    cancel.cancel();
+    assert!(futures::poll!(consumer.as_mut()).is_pending());
+    assert_original_cancel(interrupted.try_recv().unwrap(), observed);
+    assert!(!retained.is_cancelled());
+    drop(timing_lock);
+    // Even a queued actual tool-call item is only drained after cancellation.
+    tx.send(Ok(ResponseEvent::OutputItemDone(ResponseItem::FunctionCall {
+        status: None, encrypted_content: None, id: None, name: "m06_never_registered".into(),
+        namespace: None, arguments: "{}".into(), call_id: "never-dispatch".into(),
+        encrypted_function_args: None, internal_chat_message_metadata_passthrough: None,
+    }))).await.unwrap();
+    drop(tx);
+    assert_sampling_aborted(consumer.await);
+    assert!(take_sampling_events(&fixture).is_empty(), "no text/item/tool dispatch after cancellation");
+    assert!(!retained.is_cancelled());
+    assert!(stream.interrupt.is_none());
+}
