+// These fixtures call the production post-acquisition consumer, not a substitute
+// dispatcher. All Rust tests are authored only: compilation/execution UNEXECUTED.
+#[derive(Default)]
+struct SamplingGate {
+    entered: tokio::sync::Notify,
+    release: tokio::sync::Notify,
+    calls: std::sync::atomic::AtomicUsize,
+    cancel_on_release: std::sync::Mutex<Option<CancellationToken>>,
+    ready_returns: std::sync::atomic::AtomicUsize,
+}
+
+impl codex_extension_api::TokenUsageContributor for SamplingGate {
+    fn on_token_usage<'a>(
+        &'a self,
+        _session: &'a ExtensionData,
+        _thread: &'a ExtensionData,
+        _turn: &'a ExtensionData,
+        _usage: &'a codex_protocol::protocol::TokenUsageInfo,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            self.entered.notify_one();
+            self.release.notified().await;
+            if let Some(cancel) = self.cancel_on_release.lock().unwrap().as_ref() {
+                cancel.cancel();
+            }
+        })
+    }
+}
+
+impl TurnItemContributor for SamplingGate {
+    fn contribute<'a>(
+        &'a self,
+        _thread: &'a ExtensionData,
+        _turn: &'a ExtensionData,
+        _item: &'a mut TurnItem,
+    ) -> codex_extension_api::ExtensionFuture<'a, Result<(), String>> {
+        Box::pin(async move {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            self.entered.notify_one();
+            self.release.notified().await;
+            if let Some(cancel) = self.cancel_on_release.lock().unwrap().as_ref() {
+                cancel.cancel();
+            }
+            self.ready_returns.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        })
+    }
+}
+
+struct SamplingFixture {
+    session: Arc<Session>,
+    step: Arc<StepContext>,
+    events: async_channel::Receiver<codex_protocol::protocol::Event>,
+    tracker: SharedTurnDiffTracker,
+}
+
+async fn sampling_fixture(
+    builder: codex_extension_api::ExtensionRegistryBuilder<crate::config::Config>,
+) -> SamplingFixture {
+    let (mut session, context) = crate::session::tests::make_session_and_context().await;
+    let (tx, events) = async_channel::unbounded();
+    session.tx_event = tx;
+    session.services.extensions = Arc::new(builder.build());
+    SamplingFixture {
+        session: Arc::new(session),
+        step: StepContext::for_test(Arc::new(context)),
+        events,
+        tracker: Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+    }
+}
+
+fn sampling_stream() -> (
+    ResponseStream,
+    tokio::sync::mpsc::Sender<CodexResult<ResponseEvent>>,
+    tokio::sync::oneshot::Receiver<codex_api::ResponseInterrupt>,
+) {
+    let (tx, rx_event) = tokio::sync::mpsc::channel(32);
+    let (interrupt, interrupted) = tokio::sync::oneshot::channel();
+    (ResponseStream {
+        rx_event,
+        interrupt: Some(interrupt),
+        consumer_dropped: CancellationToken::new(),
+    }, tx, interrupted)
+}
+
+async fn consume_fixture(
+    fixture: &SamplingFixture,
+    stream: &mut ResponseStream,
+    accounting: &mut SamplingAccounting,
+    cancel: CancellationToken,
+) -> CodexResult<SamplingRequestResult> {
+    let runtime = ToolCallRuntime::new(
+        Arc::clone(&fixture.session), Arc::clone(&fixture.step), Arc::clone(&fixture.tracker),
+    );
+    consume_sampling_response(
+        stream, accounting, runtime, Arc::clone(&fixture.session), Arc::clone(&fixture.step),
+        Arc::new(ExtensionData::new(fixture.step.turn.sub_id.clone())),
+        Arc::clone(&fixture.tracker), cancel, tracing::Span::none(),
+        fixture.step.turn.turn_timing_state.begin_sampling(),
+    ).await
+}
+
+fn terminal_usage(incomplete: bool) -> CodexResult<ResponseEvent> {
+    let usage = Some(codex_protocol::protocol::TokenUsage {
+        total_tokens: 7,
+        ..Default::default()
+    });
+    if incomplete {
+        Err(CodexErrorDetails::ResponseIncomplete(Box::new(
+            codex_protocol::error::ResponseIncompleteError {
+                reason: "fixture-incomplete".into(),
+                response_id: Some("fixture-response".into()),
+                token_usage: usage,
+            },
+        )).into())
+    } else {
+        Ok(ResponseEvent::Completed {
+            response_id: "fixture-response".into(), token_usage: usage,
+            usage_metadata: None, end_turn: Some(true),
+        })
+    }
+}
+
+fn take_sampling_events(fixture: &SamplingFixture) -> Vec<EventMsg> {
+    let mut events = Vec::new();
+    while let Ok(event) = fixture.events.try_recv() { events.push(event.msg); }
+    events
+}
+
+fn assert_sampling_aborted(result: CodexResult<SamplingRequestResult>) {
+    assert!(matches!(result, Err(err) if matches!(err.details(), CodexErrorDetails::TurnAborted)));
+}
+
+fn assert_original_cancel(
+    interrupt: codex_api::ResponseInterrupt,
+    observed: tokio::time::Instant,
+) -> tokio::time::Instant {
+    let codex_api::ResponseInterrupt::Cancel { deadline } = interrupt else {
+        panic!("ordinary cancellation must not send Drain");
+    };
+    assert_eq!(deadline, observed + std::time::Duration::from_millis(
+        crate::tasks::GRACEFULL_INTERRUPTION_TIMEOUT_MS,
+    ));
+    deadline
+}
