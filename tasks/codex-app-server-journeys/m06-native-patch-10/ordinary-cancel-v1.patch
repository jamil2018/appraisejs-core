+}
+
+#[tokio::test]
+async fn sampling_consumer_steering_remains_distinct_from_ordinary_cancel() {
+    let (mut stream, _tx, _interrupted) = sampling_cancellation_stream();
+    let cancel = CancellationToken::new();
+    let preempt = CancellationToken::new();
