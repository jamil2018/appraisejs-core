+#[tokio::test]
+async fn ordinary_cancel_preserves_already_received_usage_completion_only() {
+    let (mut stream, _tx, interrupted) = cancellation_stream();
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_millis(100);
+    let completion = ResponseEvent::Completed {
+        response_id: "usage-only".into(),
+        token_usage: Some(codex_protocol::protocol::TokenUsage {
+            total_tokens: 7,
