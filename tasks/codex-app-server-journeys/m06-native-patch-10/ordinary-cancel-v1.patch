+// This is the actual sampling consumer boundary, shared by pre-cancel,
+// blocked-read cancellation, and cancellation racing a received event/steering.
+enum SamplingResponseEvent {
+    Event(Option<CodexResult<ResponseEvent>>),
+    Preempted,
+    Cancelled {
+        received: Option<CodexResult<ResponseEvent>>,
+        deadline: tokio::time::Instant,
+    },
+}
+
+fn cancellation_cleanup_deadline() -> tokio::time::Instant {
+    tokio::time::Instant::now()
+        + std::time::Duration::from_millis(crate::tasks::GRACEFULL_INTERRUPTION_TIMEOUT_MS)
+}
+
+async fn next_sampling_response_event(
+    stream: &mut ResponseStream,
+    preempt: &CancellationToken,
+    cancellation_token: &CancellationToken,
+) -> SamplingResponseEvent {
+    if cancellation_token.is_cancelled() {
+        return SamplingResponseEvent::Cancelled {
+            received: None,
+            deadline: cancellation_cleanup_deadline(),
+        };
+    }
+    let event = stream.next().or_cancel(preempt).or_cancel(cancellation_token).await;
+    match event {
+        Ok(Ok(event)) if cancellation_token.is_cancelled() => {
+            SamplingResponseEvent::Cancelled {
+                received: event,
+                deadline: cancellation_cleanup_deadline(),
+            }
+        }
+        Ok(Ok(event)) => SamplingResponseEvent::Event(event),
+        _ if cancellation_token.is_cancelled() => SamplingResponseEvent::Cancelled {
+            received: None,
+            deadline: cancellation_cleanup_deadline(),
+        },
+        Ok(Err(_)) => SamplingResponseEvent::Preempted,
+        Err(_) => SamplingResponseEvent::Cancelled {
+            received: None,
+            deadline: cancellation_cleanup_deadline(),
+        },
+    }
+}
+
+async fn cancel_sampling_response(
+    stream: &mut ResponseStream,
+    sess: &Session,
+    step_context: &StepContext,
+    received: Option<CodexResult<ResponseEvent>>,
+    deadline: tokio::time::Instant,
+) -> CodexResult<SamplingRequestResult> {
+    let event = stream.cancel_and_drain(deadline, received).await;
+    // Only existing usage accounting is allowed after cancellation, under the
+    // same deadline. No ordinary event, tool, follow-up, retry or fallback work.
+    let _ = tokio::time::timeout_at(deadline, async {
+        match event {
+            Some(Ok(ResponseEvent::Completed { token_usage, .. })) => {
+                let _ = sess.record_token_usage_info(
+                    &step_context.turn,
+                    &step_context.settings,
+                    token_usage.as_ref(),
+                    super::TokenUsageContext::Sampling,
+                ).await;
+            }
+            Some(Err(err)) => {
+                if let CodexErrorDetails::ResponseIncomplete(incomplete) = err.details() {
+                    sess.record_incomplete_response_usage(
+                        &step_context.turn,
+                        &step_context.settings,
+                        incomplete,
+                    ).await;
+                }
+            }
+            _ => {}
+        }
+    }).await;
+    // The outer task may abort this cleanup earlier. Neither outcome proves
+    // provider finality, HTTP cancellation coverage, or a reusable connection.
+    Err(CodexErr::TurnAborted)
+}
