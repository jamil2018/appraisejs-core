+fn sampling_cancellation_stream() -> (
+    ResponseStream,
+    tokio::sync::mpsc::Sender<CodexResult<ResponseEvent>>,
+    tokio::sync::oneshot::Receiver<codex_api::ResponseInterrupt>,
+) {
+    let (tx, rx_event) = tokio::sync::mpsc::channel(8);
+    let (interrupt, interrupted) = tokio::sync::oneshot::channel();
+    (ResponseStream {
+        rx_event,
+        interrupt: Some(interrupt),
+        consumer_dropped: CancellationToken::new(),
+    }, tx, interrupted)
+}
+
+#[tokio::test]
+async fn sampling_consumer_pre_cancel_and_steering_race_use_cancel_not_follow_up() {
+    let (session, context) = crate::session::tests::make_session_and_context().await;
+    let step_context = StepContext::for_test(Arc::new(context));
+    for queued_event in [false, true] {
+        let (mut stream, tx, interrupted) = sampling_cancellation_stream();
+        if queued_event {
+            tx.send(Ok(ResponseEvent::OutputTextDelta("must not emit".into()))).await.unwrap();
+        }
+        let cancel = CancellationToken::new();
+        let preempt = CancellationToken::new();
+        cancel.cancel();
+        preempt.cancel();
+        let (received, deadline) = match next_sampling_response_event(&mut stream, &preempt, &cancel).await {
+            SamplingResponseEvent::Cancelled { received, deadline } => (received, deadline),
+            _ => panic!("ordinary cancellation must win steering and queued events"),
+        };
+        let before = tokio::time::Instant::now();
+        let cleanup = cancel_sampling_response(&mut stream, &session, &step_context, received, deadline);
+        let producer = async {
+            match interrupted.await.unwrap() {
+                codex_api::ResponseInterrupt::Cancel { deadline } => {
+                    assert!(deadline <= tokio::time::Instant::now()
+                        + std::time::Duration::from_millis(crate::tasks::GRACEFULL_INTERRUPTION_TIMEOUT_MS));
+                    assert!(deadline <= before + std::time::Duration::from_millis(crate::tasks::GRACEFULL_INTERRUPTION_TIMEOUT_MS));
+                }
+                _ => panic!("ordinary cancellation must not send Drain"),
+            }
+            drop(tx);
+        };
+        let (result, ()) = tokio::join!(cleanup, producer);
+        assert!(matches!(result, Err(err) if matches!(err.details(), CodexErrorDetails::TurnAborted)));
+    }
+}
+
+#[tokio::test]
+async fn sampling_consumer_blocked_read_cancels_and_preserves_original_stream() {
+    let (mut stream, tx, interrupted) = sampling_cancellation_stream();
+    let dropped = stream.consumer_dropped.clone();
+    let cancel = CancellationToken::new();
+    let preempt = CancellationToken::new();
+    let waiter = next_sampling_response_event(&mut stream, &preempt, &cancel);
+    let cancellation = async {
+        tokio::task::yield_now().await;
+        cancel.cancel();
+    };
+    let (event, ()) = tokio::join!(waiter, cancellation);
+    assert!(matches!(event, SamplingResponseEvent::Cancelled { received: None, .. }));
+    assert!(!dropped.is_cancelled());
+    // The actual cancellation branch retains this stream and sends Cancel.
+    let (session, context) = crate::session::tests::make_session_and_context().await;
+    let step_context = StepContext::for_test(Arc::new(context));
+    let cleanup = cancel_sampling_response(&mut stream, &session, &step_context, None, cancellation_cleanup_deadline());
+    let producer = async {
+        assert!(matches!(interrupted.await, Ok(codex_api::ResponseInterrupt::Cancel { .. })));
+        assert!(!dropped.is_cancelled());
+        drop(tx);
+    };
+    let (result, ()) = tokio::join!(cleanup, producer);
+    assert!(matches!(result, Err(err) if matches!(err.details(), CodexErrorDetails::TurnAborted)));
+}
