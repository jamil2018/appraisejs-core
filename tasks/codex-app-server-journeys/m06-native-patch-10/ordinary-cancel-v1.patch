+impl ResponseStream {
+    /// Retains this original consumer only for bounded cancellation cleanup.
+    /// This is not a provider-finality witness, including on Completed or EOF.
+    pub(crate) async fn cancel_and_drain(
+        &mut self,
+        deadline: tokio::time::Instant,
+        received: Option<Result<ResponseEvent>>,
+    ) -> Option<Result<ResponseEvent>> {
+        use futures::StreamExt;
+
+        let sent = self.interrupt.take().is_some_and(|interrupt| {
+            interrupt
+                .send(codex_api::ResponseInterrupt::Cancel { deadline })
+                .is_ok()
+        });
+        // Preserve only usage-bearing completion/error already received in a race.
+        if matches!(received.as_ref(), Some(Ok(ResponseEvent::Completed { .. })) | Some(Err(_))) {
+            return received;
+        }
+        if !sent {
+            return None;
+        }
+        loop {
+            // Do not select the already-cancelled turn token again. The timer wins
+            // even if an always-ready stream continuously supplies ordinary items.
+            let event = tokio::select! {
+                biased;
+                _ = tokio::time::sleep_until(deadline) => return None,
+                event = self.next() => event,
+            };
+            match event {
+                Some(Ok(ResponseEvent::Completed { .. })) | Some(Err(_)) | None => return event,
+                Some(Ok(_)) => {}
+            }
+        }
+    }
+}
+
 impl Stream for ResponseStream {
     type Item = Result<ResponseEvent>;
 
