# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
packages/appraisejs/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# database files
*.db
*.sqlite
*.sqlite3

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

automation/reports/*
automation/logs/*
automation/traces/*
automation/screenshots/*
packages/appraisejs/dist/
packages/cucumber-runtime/dist/*
packages/locator-picker-companion/dist/*

# temporary files
.tmp
.fallow
.appraisejs/
.appraise/

# Graphify local-only cache and machine state
graphify-out/cache/
graphify-out/memory/
graphify-out/.graphify_*
graphify-out/cost.json
graphify-out/manifest.json
**/graphify-out/cache/
**/graphify-out/memory/
**/graphify-out/.graphify_*
**/graphify-out/cost.json
**/graphify-out/manifest.json
**/graphify-out/.graphify_labels.json
**/graphify-out/.graphify_analysis.json
# Graphify pre-rebuild safety snapshots (canonical outputs are versioned above)
**/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
